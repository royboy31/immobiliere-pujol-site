---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';

// Brevo's double opt-in redirect target (newsletter-dev-spec.md §6.3). The
// confirmation link in the DOI email lands here AFTER Brevo has added the
// contact to the Newsletter list, so this page only reports the outcome — it
// performs no work and takes no parameters.
//
// Its absolute URL is what NEWSLETTER_CONFIRM_REDIRECT_URL must be set to on the
// email worker. That var is currently unset, which is one of the conditions
// keeping the DOI path dormant (see handleNewsletter in workers/email/index.ts).
//
// noindex: a per-visitor confirmation endpoint has no business in search results,
// matching the existing thank-you convention in [...slug].astro (isThankYou).
const seoTitle = 'Inscription confirmée — Newsletter Immobilière Pujol';
const seoDescription = 'Votre inscription à la newsletter de l’Immobilière Pujol est confirmée.';
---

<BaseLayout title={seoTitle} description={seoDescription} noindex={true}>
  <section class="nl-confirm">
    <div class="nl-confirm__card">
      <div class="nl-confirm__mark" aria-hidden="true">
        <svg width="34" height="34" viewBox="0 0 24 24" fill="none">
          <path d="M4 12.5 L9.5 18 L20 6.5" stroke="currentColor" stroke-width="2.2"
                stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </div>
      <h1>Merci, votre inscription est confirmée.</h1>
      <p>
        Vous êtes désormais inscrit à la newsletter de l’Immobilière Pujol. Vous recevrez
        nos actualités immobilières et nos derniers biens directement dans votre boîte mail.
      </p>
      <p class="nl-confirm__note">
        Vous pouvez vous désinscrire à tout moment via le lien présent en bas de chacun de nos e-mails.
      </p>
      <a class="nl-confirm__cta" href="/">Retour à l’accueil</a>
    </div>
  </section>
</BaseLayout>

<style>
  .nl-confirm {
    display: flex;
    justify-content: center;
    padding: 72px 20px 96px;
  }
  .nl-confirm__card {
    max-width: 620px;
    width: 100%;
    text-align: center;
  }
  .nl-confirm__mark {
    width: 68px;
    height: 68px;
    margin: 0 auto 24px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(178, 197, 79, 0.16);
    color: #7f9420;
  }
  .nl-confirm__card h1 {
    font-size: clamp(26px, 4vw, 34px);
    line-height: 1.25;
    color: #1f2a30;
    margin: 0 0 18px;
  }
  .nl-confirm__card p {
    font-size: 17px;
    line-height: 1.6;
    color: #4a5560;
    margin: 0 0 14px;
  }
  .nl-confirm__note {
    font-size: 15px !important;
    color: #77828d !important;
  }
  .nl-confirm__cta {
    display: inline-block;
    margin-top: 26px;
    padding: 13px 30px;
    border-radius: 999px;
    background: #1f2a30;
    color: #fff;
    font-weight: 700;
    text-decoration: none;
    transition: transform 0.15s ease, opacity 0.15s ease;
  }
  .nl-confirm__cta:hover {
    transform: translateY(-1px);
    opacity: 0.92;
  }
</style>
