---
// Observatoire des prix à Marseille (quote PWS-PUJ-20261123-01, staging preview 28/11).
// Figures come only from src/data/observatoire.ts (imported editions, checked against the source PDF).
// Until the first edition is imported, every figure shows "donnée non disponible": nothing is invented.
// Wording to be validated by Caroline. Label: "Analyse Immobilière Pujol", never the source's name.
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
import PanelScript from '../../components/observatoire/PanelScript.astro';
import { ARRONDISSEMENT_SHAPES, MAP_VIEWBOX } from '../../data/marseille-arrondissements-map';
import { QUARTIER_SHAPES } from '../../data/marseille-quartiers-map';
import { QUARTIERS, QUARTIER_ROOMS, QUARTIERS_COVERAGE, QUARTIERS_PERIOD } from '../../data/observatoire-quartiers';
import { NA, ROOM_LABELS, eur, findRow, latestEdition, periodLabel, type RoomCategory } from '../../data/observatoire';

const edition = latestEdition();
const period = edition ? periodLabel(edition) : undefined;
const city = findRow(edition, '13000', 'appartement_ancien');

const ord = (n: number) => (n === 1 ? '1er' : `${n}e`);
// Filter by number of rooms (quote: "filtres par nombre de pièces"). Pure HTML/CSS: every option's figures
// are in the page, the checked radio decides which ones show (readable without JavaScript and by bots).
const OPTIONS: { key: string; rooms?: RoomCategory; label: string }[] = [
  { key: 'all', label: 'Toutes tailles' },
  ...(Object.keys(ROOM_LABELS) as RoomCategory[]).map((k) => ({ key: k, rooms: k, label: ROOM_LABELS[k] })),
];
const arrondissements = ARRONDISSEMENT_SHAPES.map((a) => ({
  ...a,
  label: `Marseille ${ord(a.num)}`,
  flat: findRow(edition, a.code, 'appartement_ancien'),
  byOpt: Object.fromEntries(OPTIONS.map((o) => [o.key, findRow(edition, a.code, 'appartement_ancien', o.rooms)])),
}));

// Map colour scale (5 steps) on the median price per m², computed per filter option, grey when no data.
const SCALE = ['rgb(236, 242, 210)', 'rgb(214, 226, 160)', 'rgb(190, 207, 108)', 'rgb(150, 168, 60)', 'rgb(104, 120, 36)'];
const NA_FILL = 'rgb(226, 226, 222)';
const fills = Object.fromEntries(OPTIONS.map((o) => {
  const vals = arrondissements.map((a) => a.byOpt[o.key]?.medianM2).filter((v): v is number => typeof v === 'number');
  const min = Math.min(...vals), max = Math.max(...vals);
  return [o.key, (v?: number) => (v === undefined ? NA_FILL : SCALE[Math.min(4, Math.floor(((v - min) / Math.max(1, max - min)) * 5))])];
}));
const values = arrondissements.map((a) => a.flat?.medianM2).filter((v): v is number => typeof v === 'number');
const areaStyle = (a: (typeof arrondissements)[number]) => OPTIONS.map((o) => `--f-${o.key}: ${fills[o.key](a.byOpt[o.key]?.medianM2)}`).join('; ');

// Quartier level (main entry, Roy 28/11): 111 official quartiers; unpublished ones stay grey and say so.
const qByCode = new Map(QUARTIERS.map((q) => [q.code, q]));
const qOpt = (code: string, key: string) => {
  const q = qByCode.get(code);
  if (key === 'all') return q?.published ? q : undefined;
  return QUARTIER_ROOMS.find((r) => r.code === code && r.rooms === key);
};
const qFills = Object.fromEntries(OPTIONS.map((o) => {
  const vals = QUARTIERS.map((q) => qOpt(q.code, o.key)?.medianM2).filter((v): v is number => typeof v === 'number');
  const min = Math.min(...vals), max = Math.max(...vals);
  return [o.key, (v?: number) => (v === undefined ? NA_FILL : SCALE[Math.min(4, Math.floor(((v - min) / Math.max(1, max - min)) * 5))])];
}));
const quartiers = QUARTIER_SHAPES.map((s) => ({ ...s, q: qByCode.get(s.code) }));
const qStyle = (code: string) => OPTIONS.map((o) => `--f-${o.key}: ${qFills[o.key](qOpt(code, o.key)?.medianM2)}`).join('; ');
const byArr = arrondissements.map((a) => ({ ...a, quartiers: quartiers.filter((x) => x.arr === a.code).sort((x, y) => x.name.localeCompare(y.name, 'fr')) }));

// Side panel (Roy 28/11: hover the map → details). Same figures as the tables, nothing recomputed.
const ROOM_KEYS = Object.keys(ROOM_LABELS) as RoomCategory[];
const pick = (r?: { medianM2?: number; medianPrice?: number; medianSurface?: number; share?: number; sales?: number }) =>
  r ? { m2: r.medianM2, price: r.medianPrice, surf: r.medianSurface, share: r.share, sales: r.sales } : undefined;
const qPeriod = `${new Date(QUARTIERS_PERIOD.start + 'T00:00:00Z').toLocaleDateString('fr-FR', { month: 'long', year: 'numeric', timeZone: 'UTC' })} – ${new Date(QUARTIERS_PERIOD.end + 'T00:00:00Z').toLocaleDateString('fr-FR', { month: 'long', year: 'numeric', timeZone: 'UTC' })}`;
const aPeriod = edition ? `${new Date(edition.periodStart + 'T00:00:00Z').toLocaleDateString('fr-FR', { month: 'long', year: 'numeric', timeZone: 'UTC' })} – ${new Date(edition.periodEnd + 'T00:00:00Z').toLocaleDateString('fr-FR', { month: 'long', year: 'numeric', timeZone: 'UTC' })}` : '';
const panelData = {
  rooms: ROOM_KEYS.map((k) => [k, ROOM_LABELS[k]]),
  q: Object.fromEntries(quartiers.map((x) => [x.code, {
    name: x.name, sub: `Marseille ${ord(Number(x.arr.slice(3)))} (${x.arr})`, row: `q${x.code}`, period: qPeriod, page: `/prix-immobilier-marseille/${x.arr}/`, pageLabel: `Prix à Marseille ${ord(Number(x.arr.slice(3)))}`,
    all: pick(qOpt(x.code, 'all') as any), byRoom: Object.fromEntries(ROOM_KEYS.map((k) => [k, pick(qOpt(x.code, k) as any)])),
  }])),
  a: Object.fromEntries(arrondissements.map((a) => [a.code, {
    name: a.label, sub: a.code, row: `a${a.code}`, period: aPeriod, page: `/prix-immobilier-marseille/${a.code}/`, pageLabel: `Prix et quartiers du ${ord(a.num)}`,
    all: pick(a.byOpt.all), byRoom: Object.fromEntries(ROOM_KEYS.map((k) => [k, pick(a.byOpt[k])])),
  }])),
};

const fullDate = (iso: string) => new Date(iso + 'T00:00:00Z').toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }).replace(/^1 /, '1er ');
const qPeriodFull = `${fullDate(QUARTIERS_PERIOD.start)} au ${fullDate(QUARTIERS_PERIOD.end)}`;
const ESTIMATION = '/estimez-le-prix-de-vente-de-votre-bien-en-2mn/';
const CONSEILLER = '/contact-immobiliere-pujol/';
const title = 'Prix immobilier à Marseille : prix au m² par arrondissement';
const description = 'Observatoire des prix au m² à Marseille, par arrondissement : prix médian, période des ventes et nombre de ventes. Analyse Immobilière Pujol.';
---

<BaseLayout title={`${title} – Immobilière Pujol`} description={description} breadcrumbCrumbs={[{ label: 'Prix immobilier à Marseille', href: null }]}>
  <div class="mag prop obs">

    <section class="obs-hero">
      <div class="mag-wrap">
        <p class="mag-eyebrow">Observatoire des prix · Analyse Immobilière Pujol{period && <> · {period}</>}</p>
        <h1 class="mag-h1">Prix immobilier à Marseille</h1>
        <p class="obs-lead">
          {city?.medianM2 && period
            ? <>Le prix médian au m² d'un appartement ancien à Marseille est de <strong>{eur(city.medianM2)}</strong> ({period}).</>
            : <>Le prix médian au m² par arrondissement, sur la dernière période de ventes disponible. <span class="obs-na">[chiffres en cours d'import]</span></>}
        </p>
        <p class="obs-coverage">Prix publiés pour <strong>{QUARTIERS_COVERAGE.published} quartiers sur {QUARTIERS_COVERAGE.official}</strong> pour cette période ; les autres sont indiqués « {NA} ».</p>
        <ul class="obs-figures">
          <li><span class="obs-figures__label">Appartement ancien, prix médian au m²</span><span class="obs-figures__value">{city?.medianM2 ? eur(city.medianM2) : NA}</span></li>
          <li><span class="obs-figures__label">Appartement ancien, prix médian de vente</span><span class="obs-figures__value">{city?.medianPrice ? eur(city.medianPrice) : NA}</span></li>
          <li><span class="obs-figures__label">Surface médiane</span><span class="obs-figures__value">{city?.medianSurface ? `${city.medianSurface}\u00a0m²` : NA}</span></li>
          <li><span class="obs-figures__label">Ventes analysées</span><span class="obs-figures__value">{city?.sales ? city.sales.toLocaleString('fr-FR') : NA}</span></li>
        </ul>
        <div class="mag-actions">
          <a class="mag-btn" href={ESTIMATION}>Estimer mon bien</a>
          <a class="mag-btn mag-btn--line" href={CONSEILLER}>Contacter un conseiller</a>
        </div>
      </div>
    </section>

    <section class="prop-section" id="quartiers">
      <div class="mag-wrap">
        <h2 class="mag-h2 prop-center">Les prix au m² par <em>quartier</em></h2>
        <p class="prop-center obs-intro">Marseille compte 111 quartiers. Choisissez un quartier sur la carte, ou ouvrez un arrondissement dans la liste.</p>
        <fieldset class="obs-filter">
            <legend>Nombre de pièces</legend>
            {OPTIONS.map((o, i) => (
              <label><input type="radio" name="obs-rooms" id={`obs-${o.key}`} value={o.key} checked={i === 0} /> <span>{o.label}</span></label>
            ))}
          </fieldset>
        <div class="obs-qmap-wrap obs-explore">
          <div class="obs-explore__map">
          <svg class="obs-map obs-map--q" viewBox={MAP_VIEWBOX} role="img" aria-label="Carte des 111 quartiers de Marseille">
            {quartiers.map((x) => (
              <a href={`#q${x.code}`} data-panel="q" data-code={x.code} aria-controls="obs-panel-q" aria-expanded="false" aria-label={`${x.name} (${x.arr}) : voir les prix du quartier`}>
                <path class="obs-area obs-area--q" style={qStyle(x.code)} d={x.d}><title>{x.name} ({x.arr})</title></path>
              </a>
            ))}
            {ARRONDISSEMENT_SHAPES.map((a) => <path class="obs-arr-line" d={a.d} />)}
            {ARRONDISSEMENT_SHAPES.map((a) => <text class="obs-map__num" x={a.cx} y={a.cy}>{a.num}</text>)}
          </svg>
          <ul class="obs-legend" aria-hidden="true">
            {[0, 1, 2, 3, 4].map((i) => <li><span class={`obs-sw obs-sw--${i}`}></span>{i === 0 ? 'moins cher' : i === 4 ? 'plus cher' : ''}</li>)}
            <li><span class="obs-sw obs-sw--na"></span>{NA}</li>
          </ul>
          </div>
          <aside class="obs-panel" id="obs-panel-q" tabindex="-1" data-panel-box="q" aria-label="Détail du quartier" hidden></aside>
        </div>
        <div class="obs-qlist">
          {byArr.map((a) => (
            <details id={`q-arr-${a.code}`}>
              <summary>{a.label} <span class="obs-cp">· {a.quartiers.filter((x) => x.q?.published).length} quartiers publiés sur {a.quartiers.length}</span></summary>
              <div class="obs-table-wrap">
                <table class="obs-table">
                  <thead><tr><th scope="col">Quartier</th><th scope="col">Prix médian au m²</th><th scope="col">Prix médian</th><th scope="col">Surface médiane</th><th scope="col">Ventes <span class="obs-th-note">(part, par taille)</span></th></tr></thead>
                  <tbody>
                    {a.quartiers.map((x) => (
                      <tr id={`q${x.code}`}>
                        <th scope="row">{x.name}</th>
                        <td>{OPTIONS.map((o) => { const v = qOpt(x.code, o.key); return <span class={`obs-v obs-v--${o.key}`}>{v?.medianM2 ? eur(v.medianM2) : <span class="obs-na">{NA}</span>}</span>; })}</td>
                        <td>{OPTIONS.map((o) => { const v = qOpt(x.code, o.key); return <span class={`obs-v obs-v--${o.key}`}>{v?.medianPrice ? eur(v.medianPrice) : <span class="obs-na">{NA}</span>}</span>; })}</td>
                        <td>{OPTIONS.map((o) => { const v = qOpt(x.code, o.key); return <span class={`obs-v obs-v--${o.key}`}>{v?.medianSurface ? `${v.medianSurface}\u00a0m²` : <span class="obs-na">{NA}</span>}</span>; })}</td>
                        <td>{OPTIONS.map((o) => { const v = qOpt(x.code, o.key) as any; return <span class={`obs-v obs-v--${o.key}`}>{o.key === 'all' ? (v?.sales ? v.sales.toLocaleString('fr-FR') : <span class="obs-na">{NA}</span>) : (v?.share !== undefined ? `${v.share.toLocaleString('fr-FR')}\u00a0% des ventes` : <span class="obs-na">{NA}</span>)}</span>; })}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="prop-section prop-section--paper" id="carte">
      <div class="mag-wrap obs-map-wrap">
        <div>
          <h2 class="mag-h2">Les prix au m² par <em>arrondissement</em></h2>

          <p>Choisissez un arrondissement sur la carte pour voir son prix médian au m², la période et le nombre de ventes.</p>
          <ul class="obs-legend" aria-hidden="true">
            {values.length
              ? [0, 1, 2, 3, 4].map((i) => <li><span class={`obs-sw obs-sw--${i}`}></span>{i === 0 ? 'moins cher' : i === 4 ? 'plus cher' : ''}</li>)
              : <li><span class="obs-sw obs-sw--na"></span>{NA}</li>}
          </ul>
          <aside class="obs-panel obs-panel--inline" id="obs-panel-a" tabindex="-1" data-panel-box="a" aria-label="Détail de l'arrondissement" hidden></aside>
        </div>
        <svg class="obs-map" viewBox={MAP_VIEWBOX} role="img" aria-label="Carte des 16 arrondissements de Marseille">
          {arrondissements.map((a) => (
            <a href={`#a${a.code}`} data-panel="a" data-code={a.code} aria-controls="obs-panel-a" aria-expanded="false" aria-label={`${a.label} : voir les prix de l'arrondissement`}>
              <path class="obs-area" style={areaStyle(a)} d={a.d}><title>{a.label}</title></path>
              <text class="obs-map__num" x={a.cx} y={a.cy}>{a.num}</text>
            </a>
          ))}
        </svg>
      </div>
    </section>

    <section class="prop-section" id="tableau">
      <div class="mag-wrap">
        <h2 class="mag-h2 prop-center">Tous les arrondissements de <em>Marseille</em></h2>
        <div class="obs-table-wrap">
          <table class="obs-table">
            <caption>Appartements anciens, {period ?? 'période en cours d’import'}. Analyse Immobilière Pujol.</caption>
            <thead><tr><th scope="col">Arrondissement</th><th scope="col">Prix médian au m²</th><th scope="col">Prix médian</th><th scope="col">Surface médiane</th><th scope="col">Ventes <span class="obs-th-note">(part, par taille)</span></th><th scope="col"><span class="sr-only">Biens</span></th></tr></thead>
            <tbody>
              {arrondissements.map((a) => (
                <tr id={`a${a.code}`}>
                  <th scope="row"><a href={`/prix-immobilier-marseille/${a.code}/`}>{a.label}</a> <span class="obs-cp">({a.code})</span></th>
                  <td>{OPTIONS.map((o) => <span class={`obs-v obs-v--${o.key}`}>{a.byOpt[o.key]?.medianM2 ? eur(a.byOpt[o.key]!.medianM2!) : <span class="obs-na">{NA}</span>}</span>)}</td>
                  <td>{OPTIONS.map((o) => <span class={`obs-v obs-v--${o.key}`}>{a.byOpt[o.key]?.medianPrice ? eur(a.byOpt[o.key]!.medianPrice!) : <span class="obs-na">{NA}</span>}</span>)}</td>
                  <td>{OPTIONS.map((o) => <span class={`obs-v obs-v--${o.key}`}>{a.byOpt[o.key]?.medianSurface ? `${a.byOpt[o.key]!.medianSurface}\u00a0m²` : <span class="obs-na">{NA}</span>}</span>)}</td>
                  <td>{OPTIONS.map((o) => <span class={`obs-v obs-v--${o.key}`}>{o.key === 'all' ? (a.flat?.sales ? a.flat.sales.toLocaleString('fr-FR') : <span class="obs-na">{NA}</span>) : (a.byOpt[o.key]?.share !== undefined ? `${a.byOpt[o.key]!.share!.toLocaleString('fr-FR')}\u00a0% des ventes` : <span class="obs-na">{NA}</span>)}</span>)}</td>
                  <td><a href={`/arrondissement/${a.code}/`}>Biens à vendre</a></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="prop-section prop-section--paper" id="methodologie">
      <div class="mag-wrap obs-method">
        <h2 class="mag-h2">Méthodologie</h2>
        <p>Cet observatoire est une <strong>Analyse Immobilière Pujol</strong> des ventes d'appartements anciens à Marseille. Les chiffres ne sont ni recalculés ni estimés : ils reprennent tels quels les résultats publiés pour la période étudiée.</p>

        <h3 class="mag-h3">Ce que mesurent les chiffres</h3>
        <ul>
          <li><strong>Période étudiée</strong> : ventes signées du {qPeriodFull}. C'est la fenêtre des ventes analysées, pas la date de mise à jour de cette page.</li>
          <li><strong>Prix médian au m²</strong> : la moitié des ventes s'est faite au-dessus, l'autre moitié en dessous. La médiane est moins sensible aux ventes exceptionnelles qu'une moyenne.</li>
          <li><strong>Prix médian de vente et surface médiane</strong> : ce sont deux médianes distinctes. Multiplier le prix médian au m² par la surface médiane ne donne pas le prix médian de vente, ni la valeur d'un bien.</li>
          <li><strong>Par nombre de pièces</strong> : pour chaque taille (studio à 5 pièces et plus), le prix médian au m², le prix médian, la surface médiane et la part que cette taille représente dans les ventes de la zone.</li>
          <li><strong>Ventes analysées</strong> : le nombre de ventes de l'échantillon étudié, toutes tailles confondues. Ce n'est pas l'inventaire exhaustif de toutes les ventes du marché.</li>
        </ul>

        <h3 class="mag-h3">Couverture</h3>
        <ul>
          <li><strong>Arrondissements</strong> : les 16 arrondissements de Marseille sont publiés pour cette période.</li>
          <li><strong>Quartiers</strong> : des prix sont publiés pour {QUARTIERS_COVERAGE.published} des {QUARTIERS_COVERAGE.official} quartiers. Pour les {QUARTIERS_COVERAGE.official - QUARTIERS_COVERAGE.published} autres quartiers, aucun chiffre n'est publié pour cette période : nous affichons « {NA} ».</li>
          <li><strong>Donnée non disponible</strong> : un chiffre non publié n'est jamais remplacé par zéro, ni emprunté à l'arrondissement ou à un quartier voisin. Il ne signifie pas qu'aucune vente n'a eu lieu.</li>
          <li><strong>Pas d'addition</strong> : toutes les ventes ne sont pas rattachées à un quartier publié, donc les ventes des quartiers ne s'additionnent pas pour retrouver celles de l'arrondissement, et les médianes ne se moyennent pas entre elles.</li>
        </ul>

        <h3 class="mag-h3">Lecture et limites</h3>
        <ul>
          <li><strong>Pas d'estimation</strong> : une médiane décrit les ventes d'une zone, pas la valeur d'un bien en particulier. Pour votre bien, demandez une estimation.</li>
          <li><strong>Pas d'évolution affichée</strong> : nous ne déduisons pas de hausse ou de baisse de périodes qui ne correspondent pas. Une différence de médiane peut aussi venir d'un changement dans le type de biens vendus.</li>
          <li><strong>Maisons et logements neufs</strong> : ils ne sont pas inclus dans cette page.</li>
          <li><strong>Mise à jour</strong> : à chaque nouvelle période de ventes disponible, l'ensemble de la page est mis à jour en une seule fois.</li>
          <li><strong>Carte des quartiers</strong> : les 111 quartiers suivent les contours reconstruits par Datactivist à partir des contours IRIS de l'IGN, publiés sous Licence Ouverte 2.0.</li>
        </ul>
      </div>
    </section>

  </div>
  <PanelScript panelData={panelData} NA={NA} ESTIMATION={ESTIMATION} />
</BaseLayout>
