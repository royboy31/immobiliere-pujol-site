---
export const prerender = false;
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import ArticleEditor from '../../../../components/admin/ArticleEditor.astro';
import { getDB, ensureSchema, getArticle, listCategories } from '../../../../lib/blog-db';

type Expert = { slug: string; title: string };
const expertMods = import.meta.glob<Expert>('../../../../content/experts/*.json', { eager: true, import: 'default' });
const experts = Object.values(expertMods)
  .map((e) => ({ slug: e.slug, title: (e.title || e.slug).split('|').pop()?.trim() || e.slug }))
  .sort((a, b) => a.title.localeCompare(b.title));

const db = await getDB();
await ensureSchema(db);
const article = await getArticle(db, Number(Astro.params.id));
if (!article) return Astro.redirect('../../');
const allCategories = await listCategories(db);
---
<AdminLayout title={`Éditer — ${article.title}`} section="articles">
  <ArticleEditor article={article} experts={experts} allCategories={allCategories} />
</AdminLayout>
