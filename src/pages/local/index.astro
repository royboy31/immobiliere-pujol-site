---
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const articles = await getCollection('articles');
const localArticles = articles
  .filter((a) => (a.data.slug || '').startsWith('local/'))
  .sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<BaseLayout
  title="Biens locaux et gestion locative à Marseille – Immobilière Pujol"
  description={`Guide complet de nos ${localArticles.length} pages de gestion locative et biens immobiliers par quartier de Marseille.`}
>
  <section class="seo-hero">
    <p class="seo-hero__eyebrow">Gestion locative</p>
    <h1>Biens et quartiers <b>à Marseille</b></h1>
    <p class="seo-hero__sub">
      Découvrez notre couverture détaillée des quartiers marseillais : conseils de location, gestion locative et opportunités d'investissement, secteur par secteur.
    </p>
    <span class="seo-hero__count">{localArticles.length} quartier{localArticles.length > 1 ? 's' : ''} / bien{localArticles.length > 1 ? 's' : ''}</span>
  </section>

  <section class="seo-archive seo-archive--paper">
    {localArticles.length === 0 ? (
      <p class="seo-empty">Aucune page locale disponible pour le moment.</p>
    ) : (
      <div class="seo-card-grid">
        {localArticles.map((a) => (
          <article class={`seo-card ${!a.data.featuredImage ? 'seo-card--text' : ''}`}>
            {a.data.featuredImage && (
              <a href={`/${a.data.slug}/`} class="seo-card__media">
                <img src={a.data.featuredImage} alt={a.data.title} loading="lazy" />
              </a>
            )}
            <div class="seo-card__body">
              <h2 class="seo-card__title">
                <a href={`/${a.data.slug}/`}>{a.data.title}</a>
              </h2>
              {a.data.excerpt && <p class="seo-card__excerpt">{a.data.excerpt}</p>}
            </div>
          </article>
        ))}
      </div>
    )}
  </section>
</BaseLayout>
