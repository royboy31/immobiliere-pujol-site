---
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getEntry, getCollection } from 'astro:content';

// Pull SEO + media from the markdown so editors keep one source of truth.
const entry = await getEntry('serviceImmobilier', 'agence-immobiliere-pujol');
const seoTitle = entry?.data.seoTitle || "Notre agence immobilière – Immobilière Pujol";
const seoDescription = entry?.data.seoDescription || '';
const ctaText = entry?.data.ctaText || "Contacter l'agence";

// T3 (Caroline 27/11): one agency page. The four story pages (histoire, mot de Stéphane,
// mission, pourquoi ce métier) are merged here with their texts kept verbatim, read from
// their markdown so there is one source of truth; their old URLs 301 here (public/_redirects).
// Team, recruitment and review pages stay separate (GSC traffic, see
// RESEARCH/PUJOL_AGENCY_ENGLISH_REDIRECT_REVIEW_2026_11_27.md).
const STORY_SLUGS = [
  { slug: 'lhistoire-de-la-societe',          id: 'histoire',  label: "L'histoire" },
  { slug: 'le-mot-de-stephane',               id: 'mot-de-stephane', label: 'Le mot de Stéphane' },
  { slug: 'la-mission-de-immobiliere-pujol',  id: 'mission',   label: 'Notre mission' },
  { slug: 'pourquoi-nous-faisons-ce-metier',  id: 'pourquoi-nous-faisons-ce-metier', label: 'Pourquoi ce métier' },
];
// Old story URLs now point at their anchor on this page.
const STORY_LINK_MAP: Record<string, string> = Object.fromEntries(
  STORY_SLUGS.map((s) => [`/services/${s.slug}/`, `#${s.id}`]),
);
function storyHtml(body: string): { title: string; html: string } {
  const sec = body.match(/<section class="contextual__section"[^>]*>([\s\S]*?)<\/section>/);
  let inner = sec?.[1] ?? '';
  const title = (inner.match(/<h3 class="contextual__title">([\s\S]*?)<\/h3>/)?.[1] ?? '').trim();
  inner = inner.replace(/<h3 class="contextual__title">[\s\S]*?<\/h3>/, '');
  inner = inner
    .replace(/<p>(?:\s|&nbsp;)*<\/p>/g, '')
    .replace(/\sstyle="[^"]*"/g, '')
    .replace(/href="\/blog\/"/g, 'href="/blog-immobilier-marseille/"')
    .replace(/href="(\/services\/[^"]+\/)"/g, (m, h) => (STORY_LINK_MAP[h] ? `href="${STORY_LINK_MAP[h]}"` : m))
    .replace(/<h3>/g, '<h4>').replace(/<\/h3>/g, '</h4>')
    .replace(/<h2>/g, '<h3>').replace(/<\/h2>/g, '</h3>');
  return { title, html: inner.trim() };
}
// The glob loader keys entries by their `slug` frontmatter ("services/<slug>").
const serviceEntries = await getCollection('services');
const stories = STORY_SLUGS.map((s) => {
  const e = serviceEntries.find((x) => x.data.slug === `services/${s.slug}`);
  if (!e) throw new Error(`agency page: missing story ${s.slug}`);
  const { title, html } = storyHtml(((e as any).body ?? '') as string);
  if (!html) throw new Error(`agency page: empty story ${s.slug}`);
  return { ...s, title: title || s.label, html };
});

const recruitment = [
  { href: '/services/devenir-gestionnaire-immobilier-a-marseille/', label: "Devenir un collaborateur de l'Immobilière Pujol" },
  { href: '/services/deposer-votre-cv-en-tant-que-gestionnaire-en-gestion-locative-chez-immobiliere-pujol/', label: 'Candidater au poste de gestionnaire en gestion locative' },
  { href: '/services/candidater-au-poste-de-gestionnaire-en-syndic-de-copropriete-au-sein-de-immobiliere-pujol/', label: 'Candidater au poste de gestionnaire de copropriété' },
];

// Related blog articles (Caroline 27/11: link the agency's own stories, e.g. "la maison").
const related = [
  { href: '/pourquoi-nous-avons-choisi-detre-une-maison-dans-le-service-immobilier/', label: "Pourquoi nous avons choisi d'être une maison dans le service immobilier ?" },
  { href: '/histoire-societe-immobiliere-pujol/', label: 'Construire la société de ses rêves : un peu notre histoire' },
  { href: '/immobiliere-pujol-le-choix-de-lhumain-et-de-la-qualite/', label: "Immobilière Pujol : le choix de l'humain et de la qualité" },
  { href: '/limmobiliere-pujol-fete-ses-20-ans/', label: "L'Immobilière Pujol fête ses 20 ans !" },
  { href: '/la-valeur-temps-et-la-magie-de-lengagement-des-equipes/', label: "La valeur temps et la magie de l'engagement des équipes" },
];

// Team photo replaces the hero video (Caroline 27/11). PLACEHOLDER until Caroline sends
// this year's group photo.
const teamPhoto = 'https://pub-a37eed540afe4dc9b4479da74ba265e1.r2.dev/2021/01/team-pujol-immobilier-marseille.jpg';

const toc = [
  { id: 'une-relation-personnalisee', label: 'Qui sommes-nous ?' },
  ...STORY_SLUGS.map((s) => ({ id: s.id, label: s.label })),
  { id: 'equipe', label: 'La team Pujol' },
  { id: 'presse', label: 'Dans la presse' },
  { id: 'avis', label: 'Avis de nos clients' },
  { id: 'candidature-immobilier-marseille', label: 'Nous rejoindre' },
];

const intro = [
  "Nous sommes une entreprise indépendante crée en 2002.",
  "Nous avons fait le choix de la qualité et du service pour nos clients et nos collaborateurs à qui nous donnons un confort de travail et des outils efficaces.",
  "Nous avons construit au fil des années une agence immobilière qui a développé des solutions innovantes, pour prendre soin de ses clients, les sécuriser dans leurs choix et leurs projets.",
  "Nous sommes une agence immobilière engagée, responsable, qui cultive les bonnes valeurs et dans laquelle l'humain est au coeur de nos préoccupations.",
];

// Form objet options preserved from the original Gravity Forms select.
const formObjects = [
  "Location : vous êtes intéressés par une annonce de location /à la recherche d'un bien à louer ?",
  'Vente/achat : vous souhaitez vendre /acheter un bien immobilier ?',
  'Gestion locative : vous souhaitez obtenir une proposition en gestion locative ?',
  'Client syndic : vous souhaitez joindre le gestionnaire/comptable de votre copropriété ?',
  'Syndic : vous souhaitez obtenir un devis en syndic pour votre copropriété ?',
  'Autre (bien détailler votre demande)',
  'Client : déclarer une urgence le week-end et les jours fériés',
];
---

<BaseLayout title={seoTitle} description={seoDescription}>
  {/* ============= HERO: team photo instead of the video (Caroline 27/11) ============= */}
  <section class="svc-hero agc-hero" style={`background-image: linear-gradient(rgba(15,25,42,.30), rgba(15,25,42,.50)), url('${teamPhoto}');`}>
    <div class="svc-hero__inner">
      <h1>Notre <b>agence immobilière</b></h1>
      <a class="svc-hero__cta" href="#form">{ctaText}</a>
    </div>
  </section>

  <div class="svc-page">
    <section class="svc-toc-section">
      <div class="svc-toc-section__inner">

        <aside class="svc-toc">
          <p class="svc-toc__title">Notre agence immobilière</p>
          <ul class="svc-toc__list">
            {toc.map((t) => (
              <li><a class="svc-toc__link" href={`#${t.id}`}>{t.label}</a></li>
            ))}
          </ul>
        </aside>

        <div class="svc-content agc">
          <section class="svc-section" id="une-relation-personnalisee">
            <h2 class="svc-section__title"><b>Qui sommes-nous ?</b></h2>
            {intro.map((p) => <p class="svc-section__lead">{p}</p>)}
          </section>

          {stories.map((st) => (
            <section class="svc-section agc-story" id={st.id}>
              <h2 class="svc-section__title"><b>{st.title}</b></h2>
              <div class="agc-prose" set:html={st.html} />
            </section>
          ))}

          <section class="svc-section" id="equipe">
            <h2 class="svc-section__title"><b>La team Pujol</b></h2>
            <figure class="agc-team">
              <img src={teamPhoto} alt="L'équipe de l'Immobilière Pujol" loading="lazy" decoding="async" />
            </figure>
            <a class="svc-article-link" href="/services/la-team-pujol/"><span>Découvrir toute l'équipe</span>
              <svg width="22" height="14" viewBox="0 0 22 14" fill="none" aria-hidden="true"><path d="M1 7 H20 M14 1 L20 7 L14 13" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round" /></svg></a>
          </section>

          <section class="svc-section" id="presse">
            <h2 class="svc-section__title"><b>Pujol dans la presse</b></h2>
            <p class="svc-section__lead">Stéphane Pujol et l'agence à la télévision et dans la presse.</p>
            <a class="svc-article-link" href="/service-immobilier/immobiliere-pujol-dans-la-presse/"><span>Voir nos passages presse et télé</span>
              <svg width="22" height="14" viewBox="0 0 22 14" fill="none" aria-hidden="true"><path d="M1 7 H20 M14 1 L20 7 L14 13" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round" /></svg></a>
          </section>

          <section class="svc-section" id="avis">
            <h2 class="svc-section__title"><b>Avis de nos clients</b></h2>
            <p class="svc-section__lead">Nos clients nous recommandent pour le service, notre proximité et notre réactivité.</p>
            <a class="svc-article-link" href="/services/avis-clients-immobiliere-pujol-marseille/"><span>Les avis de nos clients</span>
              <svg width="22" height="14" viewBox="0 0 22 14" fill="none" aria-hidden="true"><path d="M1 7 H20 M14 1 L20 7 L14 13" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round" /></svg></a>
          </section>

          <section class="svc-section" id="articles">
            <h2 class="svc-section__title"><b>Nos articles sur l'agence</b></h2>
            <ul class="svc-articles">
              {related.map((a) => (
                <li><a class="svc-article-link" href={a.href}><span>{a.label}</span>
                  <svg width="22" height="14" viewBox="0 0 22 14" fill="none" aria-hidden="true"><path d="M1 7 H20 M14 1 L20 7 L14 13" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round" /></svg></a></li>
              ))}
            </ul>
          </section>

          <section class="svc-section" id="candidature-immobilier-marseille">
            <h2 class="svc-section__title"><b>Nous rejoindre</b></h2>
            <p class="svc-section__lead">Si vous cherchez à travailler dans l'immobilier, nous offrons un cadre épanouissant et reconnaissant.</p>
            <p class="svc-section__lead">Rejoignez nous, candidatez.</p>
            <ul class="svc-articles">
              {recruitment.map((a) => (
                <li><a class="svc-article-link" href={a.href}><span>{a.label}</span>
                  <svg width="22" height="14" viewBox="0 0 22 14" fill="none" aria-hidden="true"><path d="M1 7 H20 M14 1 L20 7 L14 13" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round" /></svg></a></li>
              ))}
            </ul>
          </section>
        </div>

      </div>
    </section>

    {/* ============= CONTACT FORM ============= */}
    <section class="svc-form-wrap" id="form">
      <form
        class="svc-form"
        method="post"
        action="https://pujol-email.roy-68a.workers.dev/contact"
        enctype="multipart/form-data"
        novalidate
        data-ajax-form
      >
      <input type="text" name="_hp" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden" />
      <div class="cf-turnstile" data-sitekey="0x4AAAAAADow4gNbXgTPXvdL" data-appearance="interaction-only"></div>
        <h2>Prenez contact <b>avec nous</b></h2>
        <p class="svc-form__lead">Remplissez ce formulaire et nous prendrons contact avec vous dans les 24 heures</p>

        <div class="svc-form__grid">
          <label class="svc-field">
            <span>Prénom *</span>
            <input type="text" name="input_6.3" placeholder="Prénom" required />
          </label>

          <label class="svc-field">
            <span>Nom *</span>
            <input type="text" name="input_6.6" placeholder="Nom" required />
          </label>

          <label class="svc-field">
            <span>Email *</span>
            <input type="email" name="input_2" placeholder="Email" required />
          </label>

          <label class="svc-field">
            <span>Téléphone *</span>
            <input type="tel" name="input_4" placeholder="Téléphone" required />
          </label>

          <label class="svc-field svc-field--full">
            <span>Objet de votre demande *</span>
            <select name="input_10" required>
              {formObjects.map((o) => (
                <option value={o}>{o}</option>
              ))}
            </select>
          </label>

          <label class="svc-field svc-field--full">
            <span>Décrivez votre demande *</span>
            <textarea name="input_3" rows="6" placeholder="Décrivez votre demande" required></textarea>
          </label>
        </div>

        <label class="svc-form__agree">
          <input type="checkbox" name="input_9.1" value="J'accepte le traitement de mes données dans le cadre de ma demande" required />
          <span>J'accepte le traitement de mes données dans le cadre de ma demande *</span>
        </label>

        <p class="svc-form__legal">
          Dans le cadre de nos activités, nous traitons les données à caractère personnel de nos clients, prospects, salariés, dans le respect des règles posées par le Règlement général sur les données personnelles (RGPD) et par la loi n°78-17 du 6 janvier 1978 relative à l'informatique, aux fichiers et aux libertés. Vous pouvez accéder aux informations relatives aux traitements de vos données personnelles ainsi qu'à vos droits en consultant notre politique de traitements des données personnelles sur la page suivante&nbsp;: <a href="https://www.declarations-juridiques.fr/processing-policy/immobiliere-pujol_056808868" target="_blank" rel="noopener">https://www.declarations-juridiques.fr/processing-policy/immobiliere-pujol_056808868</a>. Vous pouvez vous opposer à ce que vos données soient utilisées par notre agence à des fins de prospection commerciale en contactant l'Immobilière Pujol au <a href="tel:0491373839">04&nbsp;91&nbsp;37&nbsp;38&nbsp;39</a> ou par mail&nbsp;: <a href="mailto:rgpd@immobiliere-pujol.fr">rgpd@immobiliere-pujol.fr</a>
        </p>

        {/* Honeypot — preserved from the legacy Gravity Forms markup. */}
        <div style="position:absolute;left:-10000px;top:auto;width:1px;height:1px;overflow:hidden" aria-hidden="true">
          <label>Company<input type="text" name="input_11" tabindex="-1" autocomplete="new-password" /></label>
        </div>
        <input type="hidden" name="gform_submit" value="4" />
        <input type="hidden" name="is_submit_4" value="1" />

        <button class="svc-form__submit" type="submit">
          <span>ENVOYER</span>
          <svg width="18" height="14" viewBox="0 0 22 14" fill="none">
            <path d="M1 7 H20 M14 1 L20 7 L14 13" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
      </form>
    </section>

  </div>

  {/* Smooth-scroll TOC: highlight the active section as it enters the viewport. */}
  <script>
    (function () {
      const links = document.querySelectorAll<HTMLAnchorElement>('.svc-toc__link');
      const sections = document.querySelectorAll<HTMLElement>('.svc-section');
      if (!links.length || !sections.length) return;

      const byId = new Map<string, HTMLAnchorElement>();
      links.forEach((l) => {
        const id = l.getAttribute('href')?.replace('#', '');
        if (id) byId.set(id, l);
      });

      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              links.forEach((l) => l.classList.remove('is-active'));
              const link = byId.get(e.target.id);
              if (link) link.classList.add('is-active');
            }
          });
        },
        { rootMargin: '-30% 0px -60% 0px', threshold: 0 }
      );
      sections.forEach((s) => io.observe(s));
    })();
  </script>

  <script>
    document.querySelectorAll<HTMLFormElement>('[data-ajax-form]').forEach((form) => {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (!form.reportValidity()) return;
        const btn = form.querySelector<HTMLButtonElement>('.svc-form__submit');
        if (btn) { btn.disabled = true; btn.classList.add('is-submitting'); }
        try {
          const res = await fetch(form.action, { method: 'POST', body: new FormData(form) });
          const data = await res.json();
          if (data.ok) {
            try { ((window as any).dataLayer = (window as any).dataLayer || []).push({ event: 'form_submit', form_type: 'contact-agence' }); } catch (e) {}
            form.innerHTML = '<div class="svc-form__success"><h2>Merci !</h2><p>Votre message a bien été envoyé. Nous vous recontacterons dans les 24 heures.</p></div>';
          } else {
            showError(form, data.error || "Une erreur est survenue. Veuillez réessayer.");
            if (btn) { btn.disabled = false; btn.classList.remove('is-submitting'); }
          }
        } catch {
          showError(form, "Erreur de connexion. Veuillez réessayer.");
          if (btn) { btn.disabled = false; btn.classList.remove('is-submitting'); }
        }
      });
    });
    function showError(form: HTMLFormElement, msg: string) {
      let el = form.querySelector('.svc-form__error');
      if (!el) {
        el = document.createElement('p');
        el.className = 'svc-form__error';
        (el as HTMLElement).style.cssText = 'color:#c0392b;font-weight:600;margin-top:12px';
        form.querySelector('.svc-form__submit')?.insertAdjacentElement('beforebegin', el);
      }
      el.textContent = msg;
    }
  </script>
  <style>
    .agc-prose { font-size: 17px; line-height: 1.7; }
    .agc-prose :global(p), .agc-prose :global(ul) { margin: 0 0 14px; }
    .agc-prose :global(ul) { padding-left: 22px; }
    .agc-prose :global(h3) { font-size: 22px; margin: 28px 0 12px; }
    .agc-prose :global(h4) { font-size: 19px; margin: 24px 0 10px; }
    .agc-prose :global(img) { display: block; max-width: 100%; height: auto; margin: 18px auto; border-radius: 6px; }
    .agc-prose :global(a) { text-decoration: underline; }
    .agc-team { margin: 0 0 18px; }
    .agc-team img { width: 100%; height: auto; border-radius: 8px; display: block; }
  </style>
</BaseLayout>
