---
// Mise en location landing (Roy + Caroline 27/11, replaces Caroline's 30/10 "no separate page" decision).
// Same URL as the legacy page (keeps its SEO). Existing texts only: the legacy page's hero lines,
// its 3 blocks and 10 links (worded as questions like the guides), the guide questions of the
// renting-out sections, and the legacy rent estimate form. Photos: Caroline's published LP choices
// (static snapshot lib/lp-photos.ts in prod, not those of the gestion landing) + the legacy hero (film shoot).
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, getEntry } from 'astro:content';
import { GUIDE_SECTIONS, guideQuestion } from '../../lib/guide-nav';
import { LP_PHOTOS as ph, posStyle } from '../../lib/lp-photos';

const entry = await getEntry('serviceImmobilier', 'mettre-en-location');
const seoTitle = entry?.data.seoTitle || 'Mettre en location – Immobilière Pujol';
const seoDescription = entry?.data.seoDescription || 'Soyez bien conseillé pour mieux louer';
const heroImage = '/images/services/mise-en-location-tournage-2026.jpg';
const ESTIMATION = '#form';
const GESTION = '/service-immobilier/gestion-locative/';

const serviceTitles = new Map(
  (await getCollection('services')).map((s) => [`/${s.data.slug.replace(/^\/|\/$/g, '')}/`, s.data.title])
);
// The one legacy link that is not a guide gets its question here (new wording, for Caroline's validation).
const EXTRA_QUESTIONS: Record<string, string> = {
  '/services/agence-location-appartement-marseille/': 'Pourquoi confier la location de votre appartement à une agence\u00a0?',
};
const q = (href: string, fallback: string) => guideQuestion(href) || EXTRA_QUESTIONS[href] || fallback;

// The legacy page's 3 blocks, their texts and links (every URL preserved), one of Caroline's photos each.
const blocks = [
  {
    title: 'Pourquoi nous confier la location de votre bien ?',
    text: "C'est un élément clé pour garantir la rapidité de mise en location de votre appartement : louer au bon prix est le premier argument que vous devez contrôler.",
    photo: ph['coproprietaire-s2'],
    links: [
      '/services/nos-resultats-pour-la-mise-en-location/',
      '/services/lagence-de-location-immobiliere-pujol-a-marseille/',
      '/services/recevez-votre-devis-de-location-en-24h/',
    ],
  },
  {
    title: 'Comment louons-nous votre bien ?',
    text: '',
    photo: ph['je-gere-seul-s1'],
    links: [
      '/services/nos-prestations-de-mise-en-location/',
      '/services/si-vous-souhaitez-nous-confier-uniquement-la-location-de-votre-appartement/',
      '/services/comment-mettre-en-location-un-appartement/',
    ],
  },
  {
    title: 'Que comprend notre service de location ?',
    text: "Louer vite à un locataire solvable et respectueux du bien qui lui est confié est l'objectif de notre équipe de location. Car se tromper dans le choix des locataires peut coûter cher.",
    photo: ph['deja-en-agence-s2'],
    links: [
      '/services/nos-resultats-en-termes-de-location-dappartements-a-marseille-et-de-prix/',
      '/services/la-securite-dans-le-choix-des-locataires-des-contrats-et-des-actes/',
      '/services/agence-location-appartement-marseille/',
      '/services/devis-gestion-locative-marseille/',
    ],
  },
].map((b) => ({ ...b, links: b.links.map((href) => ({ href, label: q(href, serviceTitles.get(href) || href) })) }));

// The guide sections about renting out (same questions as the gestion landing).
const RENTING = ['mettre-en-location', 'estimation-du-loyer', 'le-marche-et-le-prix-des-loyers', 'commercialisation', 'selection-du-locataire', 'securite-juridique'];
const guides = RENTING.map((id) => GUIDE_SECTIONS.find((g) => g.id === id)!).map((g) => ({
  id: g.id,
  title: g.title,
  articles: g.pages.map((href) => ({ href, label: guideQuestion(href) || serviceTitles.get(href) || href })),
}));
const BRIDGE = '/services/si-vous-souhaitez-nous-confier-uniquement-la-location-de-votre-appartement/';
---

<BaseLayout title={seoTitle} description={seoDescription} preloadImage={heroImage} breadcrumbCrumbs={[{ label: 'Gestion locative', href: GESTION }, { label: 'Mettre en location', href: null }]}>
  <div class="mag prop">

    <section class="prop-hero">
      <img class="prop-hero__img" src={heroImage} alt="Visite d'un appartement à louer avec l'Immobilière Pujol" loading="eager" fetchpriority="high" width="1024" height="683" />
      <div class="prop-hero__inner">
        <p class="mag-eyebrow mag-eyebrow--light">Mettre en location</p>
        <h1 class="mag-h1">Sécuriser votre location et vos revenus immobiliers</h1>
        <p class="mel-hero__sub">Soyez bien conseillé pour mieux louer</p>
        <div class="mag-actions">
          <a class="mag-btn" href={ESTIMATION}>Obtenir mon estimation de loyer gratuite en 24h</a>
          <a class="mag-btn mag-btn--ghost" href="/annonces/locations/">Nos annonces de location</a>
        </div>
      </div>
    </section>

    <section class="prop-section">
      <div class="mag-wrap">
        <ul class="mel-blocks">
          {blocks.map((b) => (
            <li class="mel-block">
              <img class="lp-pos" src={b.photo.src} style={posStyle(b.photo)} alt="" loading="lazy" width={b.photo.w} height={b.photo.h} />
              <div class="mel-block__body">
                <h2 class="mag-h3">{b.title}</h2>
                {b.text && <p>{b.text}</p>}
                <ul>{b.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="prop-section prop-section--paper" id="guides">
      <div class="mag-wrap">
        <h2 class="mag-h2 prop-center">Toutes les questions que vous vous posez sur la <em>mise en location</em></h2>
        <ul class="prop-guides">
          {guides.map((g) => (
            <li id={g.id}>
              <details>
                <summary>{g.title}<span>{g.articles.length}</span></summary>
                <ul>{g.articles.map((a) => <li><a href={a.href}>{a.label}</a></li>)}</ul>
              </details>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="prop-section">
      <div class="mag-wrap mel-bridge">
        <img class="lp-pos" src={ph['premiere-location-s1'].src} style={posStyle(ph['premiere-location-s1'])} alt="" loading="lazy" width={ph['premiere-location-s1'].w} height={ph['premiere-location-s1'].h} />
        <div>
          <h2 class="mag-h2">{guideQuestion(BRIDGE)}</h2>
          <p class="mag-actions">
            <a class="mag-btn mag-btn--dark" href={BRIDGE}>{serviceTitles.get(BRIDGE)}</a>
            <a class="mag-btn mag-btn--line" href={GESTION}>Notre gestion locative à Marseille</a>
          </p>
        </div>
      </div>
    </section>

  </div>

  <div class="svc-page">
    {/* ============= CONTACT FORM ============= */}
    <section class="svc-form-wrap" id="form">
      <form
        class="svc-form"
        method="post"
        action="https://pujol-email.roy-68a.workers.dev/contact"
        enctype="multipart/form-data"
        novalidate
        data-ajax-form
      >
      <input type="text" name="_hp" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden" />
      <div class="cf-turnstile" data-sitekey="0x4AAAAAADow4gNbXgTPXvdL" data-appearance="interaction-only"></div>
        <h2>Demander une <b>estimation de loyer</b></h2>
        <p class="svc-form__lead">
          Remplissez ce formulaire et nous prenons contact avec vous dans les 24 heures.
        </p>

        <div class="svc-form__grid">
          <label class="svc-field">
            <span>Prénom *</span>
            <input type="text" name="input_1.3" placeholder="Prénom" required />
          </label>

          <label class="svc-field">
            <span>Nom *</span>
            <input type="text" name="input_1.6" placeholder="Nom" required />
          </label>

          <label class="svc-field">
            <span>Email *</span>
            <input type="email" name="input_2" placeholder="Email" required />
          </label>

          <label class="svc-field">
            <span>Téléphone *</span>
            <input type="tel" name="input_3" placeholder="Téléphone" required />
          </label>

          <label class="svc-field svc-field--full">
            <span>Votre message *</span>
            <textarea name="input_11" rows="6" placeholder="Votre message" required></textarea>
          </label>
        </div>

        <label class="svc-form__agree">
          <input
            type="checkbox"
            name="input_12.1"
            value="J'accepte le traitement de mes données dans le cadre de ma demande"
            required
          />
          <span>J'accepte le traitement de mes données dans le cadre de ma demande *</span>
        </label>

        <p class="svc-form__legal">
          Dans le cadre de nos activités, nous traitons les données à caractère personnel de nos clients, prospects, salariés, dans le respect des règles posées par le Règlement général sur les données personnelles (RGPD) et par la loi n°78-17 du 6 janvier 1978 relative à l'informatique, aux fichiers et aux libertés. Vous pouvez accéder aux informations relatives aux traitements de vos données personnelles ainsi qu'à vos droits en consultant notre politique de traitements des données personnelles sur la page suivante&nbsp;: <a href="https://www.declarations-juridiques.fr/processing-policy/immobiliere-pujol_056808868" target="_blank" rel="noopener">https://www.declarations-juridiques.fr/processing-policy/immobiliere-pujol_056808868</a>. Vous pouvez vous opposer à ce que vos données soient utilisées par notre agence à des fins de prospection commerciale en contactant l'Immobilière Pujol au <a href="tel:0491373839">04&nbsp;91&nbsp;37&nbsp;38&nbsp;39</a> ou par mail&nbsp;: <a href="mailto:rgpd@immobiliere-pujol.fr">rgpd@immobiliere-pujol.fr</a>
        </p>

        {/* Honeypot — preserved from the legacy Gravity Forms markup. */}
        <div style="position:absolute;left:-10000px;top:auto;width:1px;height:1px;overflow:hidden" aria-hidden="true">
          <label>Name<input type="text" name="input_14" tabindex="-1" autocomplete="new-password" /></label>
        </div>
        <input type="hidden" name="gform_submit" value="8" />
        <input type="hidden" name="is_submit_8" value="1" />

        <button class="svc-form__submit" type="submit">
          <span>ENVOYER</span>
          <svg width="18" height="14" viewBox="0 0 22 14" fill="none">
            <path d="M1 7 H20 M14 1 L20 7 L14 13" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
      </form>
    </section>

  </div>

  {/* Smooth-scroll TOC: highlight the active section as it enters the viewport. */}
  <script>
    (function () {
      const links = document.querySelectorAll<HTMLAnchorElement>('.svc-toc__link');
      const sections = document.querySelectorAll<HTMLElement>('.svc-section');
      if (!links.length || !sections.length) return;

      const byId = new Map<string, HTMLAnchorElement>();
      links.forEach((l) => {
        const id = l.getAttribute('href')?.replace('#', '');
        if (id) byId.set(id, l);
      });

      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              links.forEach((l) => l.classList.remove('is-active'));
              const link = byId.get(e.target.id);
              if (link) link.classList.add('is-active');
            }
          });
        },
        { rootMargin: '-30% 0px -60% 0px', threshold: 0 }
      );
      sections.forEach((s) => io.observe(s));
    })();
  </script>

  <script>
    document.querySelectorAll<HTMLFormElement>('[data-ajax-form]').forEach((form) => {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (!form.reportValidity()) return;
        const btn = form.querySelector<HTMLButtonElement>('.svc-form__submit');
        if (btn) { btn.disabled = true; btn.classList.add('is-submitting'); }
        try {
          const res = await fetch(form.action, { method: 'POST', body: new FormData(form) });
          const data = await res.json();
          if (data.ok) {
            try { ((window as any).dataLayer = (window as any).dataLayer || []).push({ event: 'form_submit', form_type: 'mise-en-location' }); } catch (e) {}
            form.innerHTML = '<div class="svc-form__success"><h2>Merci !</h2><p>Votre message a bien été envoyé. Nous vous recontacterons dans les 24 heures.</p></div>';
          } else {
            showError(form, data.error || "Une erreur est survenue. Veuillez réessayer.");
            if (btn) { btn.disabled = false; btn.classList.remove('is-submitting'); }
          }
        } catch {
          showError(form, "Erreur de connexion. Veuillez réessayer.");
          if (btn) { btn.disabled = false; btn.classList.remove('is-submitting'); }
        }
      });
    });
    function showError(form: HTMLFormElement, msg: string) {
      let el = form.querySelector('.svc-form__error');
      if (!el) {
        el = document.createElement('p');
        el.className = 'svc-form__error';
        (el as HTMLElement).style.cssText = 'color:#c0392b;font-weight:600;margin-top:12px';
        form.querySelector('.svc-form__submit')?.insertAdjacentElement('beforebegin', el);
      }
      el.textContent = msg;
    }
  </script>
</BaseLayout>
