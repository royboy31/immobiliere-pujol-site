---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';

const seoTitle = 'Mon compte — Immobilière Pujol';
const seoDescription =
  "Accédez à votre espace client Immobilière Pujol : copropriété, gestion locative, location. Déclarez une urgence en dehors des heures ouvrables.";

const heroImg =
  'https://pub-a37eed540afe4dc9b4479da74ba265e1.r2.dev/2021/01/vinced-photo-immo-pujol-facade-27-1-1200x800.jpg';

// NOTE: les 3 vidéos marquées « 7darvAkSEEU » pointent toutes vers le même
// lien dans la liste fournie par le client. C'est probablement une erreur de
// copier-coller : à confirmer / corriger avec Caroline avant la mise en ligne.
const portals = [
  {
    role: 'Copropriétaire',
    desc: "Suivez votre copropriété, vos appels de fonds et documents.",
    href: 'https://immobilierepujol.neotimm.com/extranet#/login',
    cta: 'Accéder à mon espace',
    videos: [
      { label: 'Découvrir votre espace client', id: 'vylv-mqJ5WU' },
      { label: 'Voter en ligne par correspondance', id: 'x0BBLxSmCfU' },
      { label: 'Payer vos charges en ligne', id: '7darvAkSEEU' }, // ⚠️ à confirmer
      { label: 'Envoyer une demande ou déclarer un incident', id: '7darvAkSEEU' }, // ⚠️ à confirmer
    ],
  },
  {
    role: 'Propriétaire — gestion locative',
    desc: "Loyers encaissés, comptes-rendus, baux : votre bien en un coup d'œil.",
    href: 'https://immobilierepujol.neotimm.com/extranet#/login',
    cta: 'Accéder à mon espace',
    videos: [
      { label: 'Découvrir votre espace client', id: 'tJxzle0_muI' },
    ],
  },
  {
    role: 'Locataire',
    desc: "Quittances, paiements, demandes d'intervention — tout depuis votre extranet.",
    href: 'https://immobilierepujol.neotimm.com/extranet#/login',
    cta: 'Accéder à mon espace',
    videos: [
      { label: 'Découvrir votre espace client', id: '4VaIq_sOdp8' },
      { label: 'Payer votre loyer en ligne', id: '7darvAkSEEU' }, // ⚠️ à confirmer
    ],
  },
];
---

<BaseLayout title={seoTitle} description={seoDescription}>
  {/* ============= HERO ============= */}
  <section class="svc-hero">
    <picture class="svc-hero__video">
      <img src={heroImg} alt="Façade de l'agence Immobilière Pujol à Marseille" loading="eager" />
    </picture>
    <div class="svc-hero__overlay"></div>

    <div class="svc-hero__inner">
      <h1>Mon <b>compte</b></h1>
      <p class="svc-hero__sub">
        Accédez à votre espace client pour suivre votre dossier, vos documents et vos demandes.
      </p>
      <a class="svc-hero__cta" href="#portals">Choisir mon espace</a>
    </div>
  </section>

  <div class="svc-page">

    {/* ============= URGENCY BANNER ============= */}
    <section class="contact-urgency">
      <div class="contact-urgency__inner">
        <span class="contact-urgency__icon" aria-hidden="true">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none">
            <path d="M12 3 L22 20 H2 Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
            <path d="M12 10 V14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
            <circle cx="12" cy="17" r="1" fill="currentColor" />
          </svg>
        </span>
        <div class="contact-urgency__body">
          <h2>Une <b>urgence</b> en dehors des heures ouvrables ?</h2>
          <p>Dégât des eaux, incident, sinistre — déclarez-le directement à notre équipe d'astreinte.</p>
        </div>
        <a class="contact-urgency__cta" href="/declarer-une-urgence/">
          <span>Déclarer une urgence</span>
          <svg width="18" height="14" viewBox="0 0 22 14" fill="none" aria-hidden="true">
            <path d="M1 7 H20 M14 1 L20 7 L14 13" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </div>
    </section>

    {/* ============= CLIENT PORTALS ============= */}
    <section class="account-portals" id="portals">
      <div class="account-portals__inner">
        <h2 class="ds-sec-title">Choisissez votre <b>espace client</b></h2>
        <p class="account-portals__lead">
          Trois extranets, un seul identifiant : copropriétaires, propriétaires en gestion locative et locataires.
        </p>

        <ul class="account-portals__grid">
          {portals.map((p) => (
            <li class="account-card">
              <h3 class="account-card__role">{p.role}</h3>
              <p class="account-card__desc">{p.desc}</p>
              <a class="account-card__cta" href={p.href} target="_blank" rel="noopener">
                <span>{p.cta}</span>
                <svg width="18" height="14" viewBox="0 0 22 14" fill="none" aria-hidden="true">
                  <path d="M1 7 H20 M14 1 L20 7 L14 13" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>

              {p.videos && p.videos.length > 0 && (
                <div class="account-card__tutos">
                  <p class="account-card__tutos-title">Tutoriels vidéo</p>
                  <ul class="account-card__tutos-list">
                    {p.videos.map((v) => (
                      <li>
                        <button type="button" class="tuto-link" data-video-id={v.id} data-video-title={v.label}>
                          <svg class="tuto-link__icon" width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                            <circle cx="10" cy="10" r="9" stroke="currentColor" stroke-width="1.4" />
                            <path d="M8 6.5 L14 10 L8 13.5 Z" fill="currentColor" />
                          </svg>
                          <span>{v.label}</span>
                        </button>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </li>
          ))}
        </ul>
      </div>
    </section>

  </div>

  {/* ============= VIDEO LIGHTBOX ============= */}
  <div class="video-lightbox" id="video-lightbox" hidden role="dialog" aria-modal="true" aria-label="Lecteur vidéo">
    <div class="video-lightbox__backdrop" data-close></div>
    <div class="video-lightbox__dialog">
      <button type="button" class="video-lightbox__close" data-close aria-label="Fermer la vidéo">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M6 6 L18 18 M18 6 L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
      </button>
      <p class="video-lightbox__title" id="video-lightbox-title"></p>
      <div class="video-lightbox__frame">
        <iframe
          id="video-lightbox-iframe"
          title="Tutoriel vidéo Immobilière Pujol"
          allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
        ></iframe>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  const lb = document.getElementById('video-lightbox');
  const iframe = document.getElementById('video-lightbox-iframe') as HTMLIFrameElement | null;
  const titleEl = document.getElementById('video-lightbox-title');

  if (lb && iframe && titleEl) {
    let lastFocused: HTMLElement | null = null;

    const open = (id: string, label: string) => {
      lastFocused = document.activeElement as HTMLElement;
      iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
      titleEl.textContent = label;
      lb.hidden = false;
      document.body.style.overflow = 'hidden';
      (lb.querySelector('.video-lightbox__close') as HTMLElement)?.focus();
    };

    const close = () => {
      lb.hidden = true;
      iframe.src = '';
      document.body.style.overflow = '';
      lastFocused?.focus();
    };

    document.querySelectorAll<HTMLButtonElement>('.tuto-link').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.dataset.videoId;
        const label = btn.dataset.videoTitle || '';
        if (id) open(id, label);
      });
    });

    lb.querySelectorAll('[data-close]').forEach((el) => el.addEventListener('click', close));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !lb.hidden) close();
    });
  }
</script>
