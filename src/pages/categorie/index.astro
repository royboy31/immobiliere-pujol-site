---
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const slugify = (s: string): string =>
  s.toLowerCase()
    .normalize('NFD').replace(/[̀-ͯ]/g, '')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');

const articles = await getCollection('articles');

const catMap = new Map<string, { name: string; count: number }>();
for (const a of articles) {
  for (const cat of (a.data.categories || []) as string[]) {
    const slug = slugify(cat);
    if (!catMap.has(slug)) catMap.set(slug, { name: cat, count: 0 });
    catMap.get(slug)!.count++;
  }
}

const categories = [...catMap.entries()]
  .map(([slug, { name, count }]) => ({ slug, name, count }))
  .sort((a, b) => a.name.localeCompare(b.name, 'fr'));
---

<BaseLayout
  title="Catégories – Immobilière Pujol"
  description="Toutes les catégories du blog immobilier Marseille."
>
  <section class="seo-hero">
    <p class="seo-hero__eyebrow">Les conseils Pujol</p>
    <h1>Explorer <b>nos catégories</b></h1>
    <p class="seo-hero__sub">
      Parcourez l'ensemble des thématiques abordées par nos experts immobiliers à Marseille — marché, quartiers, conseils et programmes neufs.
    </p>
    <span class="seo-hero__count">{categories.length} catégorie{categories.length > 1 ? 's' : ''}</span>
  </section>

  <section class="seo-archive">
    <h2 class="ds-sec-title">Toutes <b>les catégories</b></h2>
    <ul class="seo-tax-grid">
      {categories.map(cat => (
        <li>
          <a href={`/categorie/${cat.slug}/`}>
            <span class="label">{cat.name}</span>
            <span class="count">{cat.count}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
