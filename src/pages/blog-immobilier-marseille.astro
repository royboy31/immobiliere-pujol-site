<script>
  // Pillar carousel arrows — scroll the track by one card width per click.
  const track = document.getElementById('blogPillarsTrack');
  if (track) {
    document.querySelectorAll('.blog-pillars__arrows button').forEach((btn) => {
      btn.addEventListener('click', () => {
        const card = track.querySelector('.blog-pillar') as HTMLElement | null;
        const step = card ? card.offsetWidth + 26 : 320;
        const dir = (btn as HTMLElement).dataset.dir === 'next' ? 1 : -1;
        track.scrollBy({ left: step * dir, behavior: 'smooth' });
      });
    });
  }

  // Hero search pill — open the site-wide SearchOverlay (delegate to its existing trigger).
  const heroSearch = document.querySelector('.blog-hero__search');
  if (heroSearch) {
    heroSearch.addEventListener('click', () => {
      const headerBtn = document.querySelector('.icons button[aria-label="Rechercher"]') as HTMLButtonElement | null;
      headerBtn?.click();
    });
  }
</script>
