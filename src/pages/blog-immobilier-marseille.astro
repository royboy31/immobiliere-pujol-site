---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const slugify = (s: string): string =>
  s.toLowerCase()
    .normalize('NFD').replace(/[̀-ͯ]/g, '')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');

// Exclude the /local/ SEO landing pages (587 of them) — they live on their own
// hub at /local/ and must never surface in the blog feed, tags, or featured slot.
const articles = (await getCollection('articles'))
  .filter((a) => !(a.data.slug || '').startsWith('local/'));

const sorted = [...articles].sort((a, b) => {
  const da = a.data.date ? new Date(a.data.date).getTime() : 0;
  const db = b.data.date ? new Date(b.data.date).getTime() : 0;
  return db - da;
});

const featured = sorted[0];
const recent = sorted.slice(1, 13);

// Pillars: the 4 evergreen content pillars, hand-picked. Article counts are
// computed live from the collection so the chip badge stays accurate.
const pillarDefs = [
  {
    slug: 'actu-immobiliere',
    title: 'Le marché immobilier à Marseille',
    desc: "Actualité du marché marseillais, analyses et tendances.",
    match: /(le\s*march[eé]\s*immobilier|actualit[eé]\s*immobili[eè]re)/i,
    accent: 'olive',
  },
  {
    slug: 'investir-marseille',
    title: 'Investir en immobilier',
    desc: "Conseils, stratégies et opportunités pour investir à Marseille.",
    match: /(investir|mes\s*conseils)/i,
    accent: 'orange',
  },
  {
    slug: 'programme-neufs-marseille',
    title: "L'immobilier neuf",
    desc: "Programmes neufs et VEFA dans tous les arrondissements.",
    match: /(immobilier\s*neuf|programmes?\s*neufs?)/i,
    accent: 'slate',
  },
  {
    slug: 'prix-immo-arrondissement',
    title: 'Prix au m² par arrondissement',
    desc: "Le prix de l'immobilier ancien et neuf, secteur par secteur.",
    match: /prix\s*au\s*m2?\s*par\s*arrondissement/i,
    accent: 'soft-green',
  },
  {
    slug: 'mon-quartier-ma-ville',
    title: 'Mon quartier, ma ville',
    desc: "Découvrir Marseille quartier par quartier.",
    match: /mon\s*quartier/i,
    accent: 'olive',
  },
  {
    slug: 'avant_apres',
    title: 'Avant / Après',
    desc: "Transformations et rénovations remarquables.",
    match: /avant[\s-_\/]*apr[eè]s/i,
    accent: 'orange',
  },
];

const pillars = pillarDefs.map(p => {
  const count = articles.filter(a =>
    (a.data.categories || []).some((c: string) => p.match.test(c))
  ).length;
  return { ...p, count };
});

// Tag cloud — top 30 tags by article count.
const tagMap = new Map<string, { name: string; count: number }>();
for (const a of articles) {
  for (const t of (a.data.tags || []) as string[]) {
    const slug = slugify(t);
    if (!tagMap.has(slug)) tagMap.set(slug, { name: t, count: 0 });
    tagMap.get(slug)!.count++;
  }
}
const topTags = [...tagMap.entries()]
  .map(([slug, { name, count }]) => ({ slug, name, count }))
  .sort((a, b) => b.count - a.count)
  .slice(0, 30);

const fmtDate = (s?: string) =>
  s ? new Date(s).toLocaleDateString('fr-FR', { year: 'numeric', month: 'long', day: 'numeric' }) : '';

const featuredCategory =
  featured && (featured.data.categories || [])[0];
---

<BaseLayout
  title="Blog immobilier Marseille – Immobilière Pujol"
  description="Décrypter le marché immobilier marseillais : prix, conseils, investissement et programmes neufs commentés par l'Immobilière Pujol."
>
  <!-- ============= HERO ============= -->
  <section class="seo-hero blog-hero">
    <p class="seo-hero__eyebrow">Le blog Pujol</p>
    <h1>Décrypter <b>l'immobilier à Marseille</b></h1>
    <p class="seo-hero__sub">
      L'actualité du marché, des analyses, des conseils pratiques et des points de vue tranchés — par l'équipe de l'Immobilière Pujol.
    </p>
    <button class="blog-hero__search" type="button" aria-label="Rechercher un article">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <circle cx="11" cy="11" r="7" />
        <line x1="20" y1="20" x2="16" y2="16" stroke-linecap="round" />
      </svg>
      <span>Rechercher un article…</span>
    </button>
  </section>

  <!-- ============= FEATURED + NEWSLETTER ============= -->
  {featured && (
    <section class="blog-featured">
      <div class="blog-featured__inner">
        <article class="blog-featured__card">
          <a class="blog-featured__media" href={`/${featured.data.slug}/`}>
            {featured.data.featuredImage && (
              <img src={featured.data.featuredImage} alt={featured.data.title} loading="eager" />
            )}
            <span class="blog-featured__badge">Dernier article</span>
          </a>
          <div class="blog-featured__body">
            {featuredCategory && (
              <a class="blog-featured__eyebrow" href={`/categorie/${slugify(featuredCategory)}/`}>{featuredCategory}</a>
            )}
            <h2 class="blog-featured__title">
              <a href={`/${featured.data.slug}/`}>{featured.data.title}</a>
            </h2>
            {featured.data.excerpt && (
              <p class="blog-featured__excerpt">{featured.data.excerpt}</p>
            )}
            <div class="blog-featured__meta">
              {featured.data.date && <time datetime={featured.data.date}>{fmtDate(featured.data.date)}</time>}
              <a class="blog-featured__cta" href={`/${featured.data.slug}/`}>Lire l'article →</a>
            </div>
          </div>
        </article>

        <aside class="blog-news">
          <p class="blog-news__overline">Newsletter</p>
          <h2>Recevez nos <b>conseils immobiliers</b></h2>
          <p class="blog-news__lead">
            Maximum une fois par mois — des analyses, des chiffres clés et nos coups de cœur immobiliers à Marseille.
          </p>
          {/* Mirrors NewsletterSignup step 1 (same worker endpoint + contract):
              email + consent -> POST /newsletter (Brevo double opt-in fires).
              Preference enrichment (step 2) is footer/landing-only; the DOI
              email itself is what subscribes people, so this card stays lean. */}
          <form class="blog-news__form" method="post" action="https://pujol-email.roy-68a.workers.dev/newsletter" data-blog-news-form>
            <input type="text" name="_hp" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden" />
            <input name="email" type="email" placeholder="Votre adresse email" aria-label="Adresse email" required />
            <button type="submit" class="blog-news__submit" aria-label="S'inscrire">
              <svg width="18" height="14" viewBox="0 0 22 14" fill="none">
                <path d="M1 7 H20 M14 1 L20 7 L14 13" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </button>
            <div class="cf-turnstile" data-sitekey="0x4AAAAAADow4gNbXgTPXvdL" data-appearance="interaction-only"></div>
          </form>
          <label class="blog-news__agree">
            <input type="checkbox" data-blog-news-agree />
            <span>J'accepte le traitement de mes données dans le cadre de mon inscription.</span>
          </label>
          <p class="blog-news__legal" style="font-size:10px;color:#999;line-height:1.4;margin-top:8px">
            Dans le cadre de nos activités, nous traitons les données à caractère personnel de nos clients, prospects, salariés, dans le respect des règles posées par le Règlement général sur les données personnelles (RGPD) et par la loi n°78-17 du 6 janvier 1978 relative à l'informatique, aux fichiers et aux libertés. Vous pouvez accéder aux informations relatives aux traitements de vos données personnelles ainsi qu'à vos droits en consultant notre politique de traitements des données personnelles sur la page suivante&nbsp;: <a href="https://www.declarations-juridiques.fr/processing-policy/immobiliere-pujol_056808868" target="_blank" rel="noopener" style="color:#999">https://www.declarations-juridiques.fr/processing-policy/immobiliere-pujol_056808868</a>. Vous pouvez vous opposer à ce que vos données soient utilisées par notre agence à des fins de prospection commerciale en contactant l'Immobilière Pujol au <a href="tel:0762203313" style="color:#999">07&nbsp;62&nbsp;20&nbsp;33&nbsp;13</a> ou par mail&nbsp;: <a href="mailto:rgpd@immobiliere-pujol.fr" style="color:#999">rgpd@immobiliere-pujol.fr</a>
          </p>
        </aside>

        <script>
          // Blog newsletter card — mirrors NewsletterSignup step 1 (same
          // endpoint, same {ok, doi} contract). The consent checkbox lives
          // outside the <form> for layout reasons, so it's validated here.
          (function () {
            const form = document.querySelector<HTMLFormElement>('[data-blog-news-form]');
            if (!form) return;
            const agree = document.querySelector<HTMLInputElement>('[data-blog-news-agree]');
            form.addEventListener('submit', async (e) => {
              e.preventDefault();
              if (!form.reportValidity()) return;
              if (agree && !agree.checked) {
                agree.focus();
                agree.closest('label')?.classList.add('blog-news__agree--error');
                return;
              }
              const btn = form.querySelector<HTMLButtonElement>('.blog-news__submit');
              if (btn) btn.disabled = true;
              try {
                const res = await fetch(form.action, { method: 'POST', body: new FormData(form) });
                const data = await res.json() as { ok?: boolean; doi?: boolean };
                if (data.ok) {
                  try { ((window as any).dataLayer = (window as any).dataLayer || []).push({ event: 'form_submit', form_type: 'newsletter' }); } catch (e) {}
                  const card = form.closest('.blog-news');
                  if (card) {
                    const msg = data.doi
                      ? "Votre inscription n'est pas encore finalisée à ce stade. Veuillez cliquer sur le lien de validation envoyé sur votre boîte email."
                      : 'Merci ! Votre inscription est bien enregistrée.';
                    card.innerHTML = '<p class="blog-news__overline">Newsletter</p><p style="font-weight:600;line-height:1.5"></p>';
                    const p = card.querySelector('p:last-child');
                    if (p) p.textContent = msg;
                  }
                } else if (btn) btn.disabled = false;
              } catch { if (btn) btn.disabled = false; }
            });
          })();
        </script>
      </div>
    </section>
  )}

  <!-- ============= RECENT ARTICLES GRID ============= -->
  <section class="seo-archive seo-archive--paper">
    <h2 class="ds-sec-title">Les derniers <b>articles</b></h2>
    <div class="seo-card-grid">
      {recent.map(a => {
        const cat = (a.data.categories || [])[0];
        return (
          <article class={`seo-card ${!a.data.featuredImage ? 'seo-card--text' : ''}`}>
            {a.data.featuredImage && (
              <a href={`/${a.data.slug}/`} class="seo-card__media">
                <img src={a.data.featuredImage} alt={a.data.title} loading="lazy" />
              </a>
            )}
            <div class="seo-card__body">
              {cat && <span class="seo-card__date" style="color:rgb(178,192,78);">{cat}</span>}
              <h3 class="seo-card__title">
                <a href={`/${a.data.slug}/`}>{a.data.title}</a>
              </h3>
              {a.data.excerpt && <p class="seo-card__excerpt">{a.data.excerpt}</p>}
              {a.data.date && (
                <time class="seo-card__date" datetime={a.data.date}>{fmtDate(a.data.date)}</time>
              )}
            </div>
          </article>
        );
      })}
    </div>
    <div class="blog-grid-cta">
      <a class="seo-cta" href="/categorie/">Voir toutes les catégories →</a>
    </div>
  </section>

  <!-- ============= PILLAR CAROUSEL (below recent articles, Caroline 12/06) ============= -->
  <section class="blog-pillars">
    <header class="blog-pillars__head">
      <div>
        <p class="seo-hero__eyebrow" style="color:rgb(166,179,82);text-align:left;">Thèmes</p>
        <h2 class="ds-sec-title" style="text-align:left;">Parcourir <b>par sujet</b></h2>
      </div>
      <div class="blog-pillars__arrows" aria-hidden="true">
        <button class="arrow-btn" type="button" data-dir="prev" aria-label="Précédent">
          <svg width="18" height="14" viewBox="0 0 22 14" fill="none"><path d="M21 7H2 M8 1 L2 7 L8 13" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <button class="arrow-btn" type="button" data-dir="next" aria-label="Suivant">
          <svg width="18" height="14" viewBox="0 0 22 14" fill="none"><path d="M1 7 H20 M14 1 L20 7 L14 13" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>
    </header>

    <div class="blog-pillars__track" id="blogPillarsTrack">
      {pillars.map(p => (
        <a class={`blog-pillar blog-pillar--${p.accent}`} href={`/categorie/${p.slug}/`}>
          <div class="blog-pillar__top">
            <span class="blog-pillar__count">{p.count} article{p.count > 1 ? 's' : ''}</span>
            <span class="blog-pillar__arrow" aria-hidden="true">→</span>
          </div>
          <h3 class="blog-pillar__title">{p.title}</h3>
          <p class="blog-pillar__desc">{p.desc}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- ============= TAG CLOUD ============= -->
  <section class="seo-archive">
    <h2 class="ds-sec-title">Explorer <b>par mot-clé</b></h2>
    <ul class="seo-tax-grid seo-tax-grid--chips">
      {topTags.map(t => (
        <li>
          <a href={`/tag/${t.slug}/`}>
            <span class="label">{t.name}</span>
            <span class="count">{t.count}</span>
          </a>
        </li>
      ))}
    </ul>
    <div class="blog-grid-cta">
      <a class="seo-cta" href="/tag/">Voir tous les tags →</a>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---- Hero search pill ---- */
  .blog-hero__search {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-top: 28px;
    padding: 14px 22px 14px 20px;
    min-width: 360px;
    background: #fff;
    border: 1px solid rgba(0, 0, 0, .1);
    border-radius: 999px;
    color: rgba(0, 0, 0, .55);
    font-family: "Noto Sans", sans-serif;
    font-weight: 400;
    font-size: 15px;
    box-shadow: 0 8px 28px rgba(0, 0, 0, .08);
    cursor: pointer;
    transition: transform .25s ease, box-shadow .25s ease, color .25s ease, border-color .25s ease;
  }
  .blog-hero__search:hover {
    transform: translateY(-1px);
    color: #000;
    border-color: rgb(178, 192, 78);
    box-shadow: 0 12px 36px rgba(0, 0, 0, .12);
  }
  .blog-hero__search svg { color: rgb(166, 179, 82); }

  /* ---- Featured + Newsletter row ---- */
  .blog-featured {
    background: #fff;
    padding: 80px max(100px, calc(50% - 620px));
  }
  .blog-featured__inner {
    max-width: 1240px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 36px;
    /* align-items stays at default (stretch) so the grid row picks up the
       featured card's height — that's the travel distance the sticky
       newsletter card uses. The card itself opts out via align-self: start
       so it sizes to its own content. */
  }

  .blog-featured__card {
    background: #fff;
    border: 1px solid rgba(0, 0, 0, .1);
    border-radius: 28px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform .3s ease, box-shadow .3s ease;
  }
  .blog-featured__card:hover {
    transform: translateY(-4px);
    box-shadow: 0 18px 50px rgba(0, 0, 0, .08);
  }
  .blog-featured__media {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: rgb(238, 243, 239);
  }
  .blog-featured__media img {
    width: 100%; height: 100%;
    object-fit: cover;
    display: block;
    transition: transform .5s ease;
  }
  .blog-featured__card:hover .blog-featured__media img { transform: scale(1.04); }
  .blog-featured__badge {
    position: absolute;
    top: 18px; left: 18px;
    background: rgb(178, 192, 78);
    color: #000;
    font-family: "Noto Sans", sans-serif;
    font-weight: 700;
    font-size: 12px;
    letter-spacing: .6px;
    text-transform: uppercase;
    padding: 6px 14px;
    border-radius: 999px;
  }
  .blog-featured__body {
    padding: 30px 32px 32px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    flex: 1;
  }
  .blog-featured__eyebrow {
    align-self: flex-start;
    font-family: "Noto Sans", sans-serif;
    font-weight: 700;
    font-size: 12px;
    letter-spacing: .6px;
    text-transform: uppercase;
    color: rgb(166, 179, 82);
    text-decoration: none;
    background: none;
    background-image: none;
  }
  .blog-featured__title {
    font-family: "Helvetica Neue", Helvetica, sans-serif;
    font-weight: 300;
    font-size: 32px;
    line-height: 1.1;
    color: #000;
    margin: 0;
  }
  .blog-featured__title b { font-weight: 700; }
  .blog-featured__title a { color: inherit; text-decoration: none; }
  .blog-featured__title a:hover { color: rgb(166, 179, 82); }
  .blog-featured__excerpt {
    font-family: "Noto Sans", sans-serif;
    font-weight: 300;
    font-size: 16px;
    line-height: 1.55;
    color: rgb(58, 58, 58);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .blog-featured__meta {
    margin-top: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    padding-top: 18px;
    border-top: 1px solid rgba(0, 0, 0, .08);
  }
  .blog-featured__meta time {
    font-family: "Noto Sans", sans-serif;
    font-weight: 400;
    font-size: 13px;
    color: rgb(58, 58, 58);
  }
  .blog-featured__cta {
    font-family: "Noto Sans", sans-serif;
    font-weight: 700;
    font-size: 13px;
    letter-spacing: .4px;
    text-transform: uppercase;
    color: rgb(166, 179, 82);
    text-decoration: none;
  }
  .blog-featured__cta:hover { color: rgb(236, 114, 52); }

  /* ---- Newsletter card ---- */
  .blog-news {
    background: rgb(178, 192, 78);
    border-radius: 28px;
    padding: 28px 32px 26px;
    color: #000;
    display: flex;
    flex-direction: column;
    position: sticky;
    top: 40px;
    align-self: start;
  }
  .blog-news__overline {
    font-family: "Noto Sans", sans-serif;
    font-weight: 700;
    font-size: 12px;
    letter-spacing: .8px;
    text-transform: uppercase;
    margin: 0 0 14px;
    color: rgba(0, 0, 0, .7);
  }
  .blog-news h2 {
    font-family: "Helvetica Neue", Helvetica, sans-serif;
    font-weight: 300;
    font-size: 32px;
    line-height: 1.05;
    margin: 0 0 12px;
  }
  .blog-news h2 b { font-weight: 700; }
  .blog-news__lead {
    font-family: "Noto Sans", sans-serif;
    font-weight: 300;
    font-size: 14px;
    line-height: 1.55;
    margin: 0 0 22px;
    color: rgba(0, 0, 0, .8);
  }
  .blog-news__form {
    display: flex;
    align-items: center;
    gap: 12px;
    border-bottom: 1px solid rgba(0, 0, 0, .28);
    padding-bottom: 10px;
  }
  .blog-news__form input[type="email"] {
    flex: 1;
    background: transparent;
    border: 0;
    outline: 0;
    font-family: "Helvetica Neue", Helvetica, sans-serif;
    font-weight: 300;
    font-size: 17px;
    color: #000;
    padding: 6px 0;
  }
  .blog-news__form input[type="email"]::placeholder { color: rgba(0, 0, 0, .55); }
  .blog-news__submit {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background-color: transparent;
    background-image: linear-gradient(to top, #000 50%, transparent 50%);
    background-size: 100% 200%;
    background-position: 0 0;
    color: #000;
    border: 1.5px solid #000;
    display: grid;
    place-items: center;
    cursor: pointer;
    transition: background-position .35s ease, color .25s ease;
    flex: none;
  }
  .blog-news__submit:hover {
    background-position: 0 100%;
    color: rgb(178, 192, 78);
  }
  .blog-news__agree {
    display: flex;
    gap: 12px;
    margin-top: 18px;
    align-items: flex-start;
    font-family: "Noto Sans", sans-serif;
    font-weight: 400;
    font-size: 13px;
    line-height: 1.45;
    color: rgba(0, 0, 0, .75);
    cursor: pointer;
  }
  .blog-news__agree input[type="checkbox"] {
    width: 16px;
    height: 16px;
    border: 1.5px solid #000;
    margin-top: 2px;
    flex: none;
    accent-color: #000;
  }

  /* ---- Pillar carousel ---- */
  .blog-pillars {
    background: #f7f7f5;
    padding: 90px 0 80px;
  }
  .blog-pillars__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    padding: 0 max(100px, calc(50% - 620px));
    margin-bottom: 40px;
  }
  .blog-pillars__arrows { display: flex; gap: 12px; }

  .blog-pillars__track {
    display: flex;
    gap: 26px;
    overflow-x: auto;
    overflow-y: visible;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scroll-padding-left: max(100px, calc(50% - 620px));
    padding: 4px max(100px, calc(50% - 620px)) 14px;
    scrollbar-width: none;
  }
  .blog-pillars__track::-webkit-scrollbar { display: none; }

  .blog-pillar {
    flex: 0 0 calc((100% - 78px) / 4);
    min-width: 280px;
    max-width: 360px;
    scroll-snap-align: start;
    background: #fff;
    border-radius: 24px;
    padding: 26px 28px 28px;
    color: #000;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    gap: 14px;
    transition: transform .3s ease, box-shadow .3s ease, background .3s ease;
    border: 1px solid rgba(0, 0, 0, .06);
  }
  .blog-pillar:hover {
