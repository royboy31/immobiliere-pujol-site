---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { buildArticle, buildLocalBusiness } from '../lib/schemas';
import BlogSidebar from '../components/blog/BlogSidebar.astro';
import ExpertContactCard from '../components/experts/ExpertContactCard.astro';
import { pickRotatedLinks } from '../lib/internal-links';
import { isLegalPage } from '../lib/legal-pages';

// Build-time map of expert JSON (this page is prerendered, so the eager glob
// stays out of the SSR worker). Used for the optional end-of-article expert CTA.
const expertModules = import.meta.glob('../content/experts/*.json', { eager: true });
function getExpertBySlug(slug: string): any | null {
  const m = (expertModules as Record<string, any>)[`../content/experts/${slug}.json`];
  return m ? (m.default ?? m) : null;
}

// Catch-all route for root-level URLs:
// - Blog posts (891 articles)
// - Static pages (32 pages)
// - PriceHubble estimation page
// - Contact page

export async function getStaticPaths() {
  // Slugs handled by their own dedicated .astro file in /src/pages/. Must be
  // skipped here to avoid duplicate static-route generation. Defined inside
  // getStaticPaths because Astro hoists this function into an isolated scope.
  const DEDICATED = new Set([
    'estimez-le-prix-de-vente-de-votre-bien-en-2mn',
    'contact-immobiliere-pujol',
    'mon-compte',
    'declarer-une-urgence',
    'blog-immobilier-marseille',
  ]);
  const articles = await getCollection('articles');
  const pages = await getCollection('pages');

  const articlePaths = articles
    .filter((entry) => !DEDICATED.has(entry.data.slug))
    .map((entry) => ({
      params: { slug: entry.data.slug },
      props: { entry, type: 'article' as const },
    }));

  const pagePaths = pages
    .filter((entry) => !DEDICATED.has(entry.data.slug))
    .map((entry) => ({
      params: { slug: entry.data.slug },
      props: { entry, type: 'page' as const },
    }));

  return [...articlePaths, ...pagePaths];
}

interface Props {
  entry: any;
  type: 'article' | 'page';
}

const { entry, type } = Astro.props;
// Bodies are pure HTML (scraped from WP). Render raw to avoid markdown turning
// 4-space-indented HTML into syntax-highlighted code blocks.
let rawBody: string = (entry as any).body ?? '';

// Strip legacy WP share block — the onclick handlers reference a missing
// `socialPopup()` JS function and the raw SVGs balloon the layout.
rawBody = rawBody
  // Wrapper <div class="post__share"> is malformed (no closing </div>);
  // strip from the opener through the inner </ul>, with optional trailing </div>.
  .replace(/<!--\s*SHARE\s*-->/gi, '')
  .replace(/<div\s+class="post__share"[\s\S]*?<\/ul>\s*(<\/div>)?/gi, '')
  .replace(/<ul\s+class="social__list"[\s\S]*?<\/ul>/gi, '')
  .replace(/<svg\s+class="social__icon[\s\S]*?<\/svg>/gi, '');

// Wrap each <img> + its trailing text (up to the next img, heading, blockquote,
// hr, or end of document) into a 2-col card. Sides alternate left/right.
function wrapImagePairs(html: string): string {
  const imgRegex = /<img\b[^>]*>/gi;
  const breakRegex = /<\/?(?:h[1-6]|table|hr|blockquote|figure)\b[^>]*>/i;
  const imgs: { tag: string; start: number; end: number }[] = [];
  let m: RegExpExecArray | null;
  while ((m = imgRegex.exec(html)) !== null) {
    imgs.push({ tag: m[0], start: m.index, end: m.index + m[0].length });
  }
  if (!imgs.length) return html;

  let out = '';
  let cursor = 0;
  let pairIndex = 0;

  for (let i = 0; i < imgs.length; i++) {
    const img = imgs[i];
    out += html.slice(cursor, img.start);

    const nextStart = i + 1 < imgs.length ? imgs[i + 1].start : html.length;
    const remaining = html.slice(img.end, nextStart);
    const blockMatch = breakRegex.exec(remaining);
    const bodyEnd = blockMatch ? img.end + blockMatch.index : nextStart;
    const body = html.slice(img.end, bodyEnd);

    // Skip pair-wrapping when there's no meaningful caption text — render image alone.
    const stripped = body.replace(/<[^>]+>/g, '').replace(/&nbsp;|&#8211;/g, '').trim();
    if (stripped.length < 6) {
      out += `<figure class="article-figure">${img.tag}</figure>${body}`;
      cursor = bodyEnd;
      continue;
    }

    const side = pairIndex % 2 === 0 ? 'left' : 'right';
    out += `<aside class="article-pair article-pair--${side}"><div class="article-pair__media">${img.tag}</div><div class="article-pair__body">${body}</div></aside>`;
    cursor = bodyEnd;
    pairIndex++;
  }
  out += html.slice(cursor);
  return out;
}

rawBody = wrapImagePairs(rawBody);

// Scraped WP bodies often carry surplus </div> tags. Injected via set:html they
// close our own wrappers (.content__body, .content__layout) early, ejecting the
// sidebar out of the grid. Balance <div> depth: drop surplus closers, append any
// missing ones, so the body can never break out of its container.
function balanceDivs(html: string): string {
  const re = /<div\b[^>]*>|<\/div\s*>/gi;
  let depth = 0, last = 0, out = '';
  let m: RegExpExecArray | null;
  while ((m = re.exec(html)) !== null) {
    out += html.slice(last, m.index);
    if (m[0][1] === '/') {
      if (depth > 0) { depth--; out += m[0]; } // valid close; surplus dropped
    } else {
      depth++; out += m[0];
    }
    last = re.lastIndex;
  }
  out += html.slice(last);
  while (depth-- > 0) out += '</div>';
  return out;
}

rawBody = balanceDivs(rawBody);

// Detect prix-au-m2 category for special template
const isPrixM2 = type === 'article' && (entry.data.categories || []).some(
  (cat: string) => cat.toLowerCase().includes('prix') && cat.toLowerCase().includes('m')
);

// Legacy Yoast titles end with "| Immobilière Pujol" and BaseLayout re-adds the
// brand, so only that trailing segment is stripped. Splitting on any "|" (what
// this did before) truncated titles that use the pipe as real punctuation — and
// now that the admin's SEO actually renders, it would silently cut any title an
// admin types at its first pipe, "|" being a common SEO separator.
const stripBrandSuffix = (s?: string) => (s || '').replace(/\s*\|\s*Immobilière Pujol\s*$/i, '').trim();
const title = stripBrandSuffix(entry.data.seoTitle) || entry.data.title || 'Immobilière Pujol';
const description = entry.data.seoDescription?.trim() || entry.data.excerpt || '';

// Content edited in the admin (D1) must beat BaseLayout's frozen WordPress meta
// mirror, otherwise the editor's SEO fields are decorative: the mirror covers
// 1015 of the 1017 articles and was overriding every title/description an admin
// typed. Articles and the 2 legal pages are both D1-backed, so both bypass it.
// Pages other than the legal ones are not editable, and keep the mirror.
const bypassSeoMirror = type === 'article' || (type === 'page' && isLegalPage(entry.data.slug));

const pageUrl = new URL(`/${entry.data.slug}/`, Astro.site).toString();
const pageSchemas: any[] = [];
if (type === 'article') {
  pageSchemas.push(buildArticle(entry.data, pageUrl));
  // /local/{slug}/ articles are area-targeted service pages — also emit LocalBusiness.
  if ((entry.data.slug || '').startsWith('local/')) {
    pageSchemas.push(buildLocalBusiness({
      pageUrl,
      pageTitle: entry.data.title,
      slug: entry.data.slug,
    }));
  }
}

// PriceHubble property estimation widget integration. The scraped body already
// contains <iframe id="fisher-widget"></iframe>; we load the widget script and
// init the widget here (set:html strips <script> tags so they must live outside).
const isEstimationPage = entry.data.slug === 'estimez-le-prix-de-vente-de-votre-bien-en-2mn';

// Most scraped bodies start with a WP hero section that already contains the
// H1 and a featured image. Skip our own content__header when the body has one
// to avoid a duplicate <h1>.
const bodyHasOwnH1 = /<h1\b/i.test(rawBody);

const slugify = (s: string): string =>
  s.toLowerCase()
    .normalize('NFD').replace(/[̀-ͯ]/g, '')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');

const featuredImage = entry.data.featuredImage as string | undefined;
// og:image — an explicit article og_image wins, else the featured image. Absolute URL;
// falls back to BaseLayout's default when there's none.
const ogSource = (type === 'article' ? entry.data.ogImage : undefined) || featuredImage;
const ogImage = ogSource
  ? new URL(ogSource, Astro.site ?? Astro.url).toString()
  : undefined;
const heroCategory = type === 'article' && (entry.data.categories || [])[0];

// Blog sidebar — "À lire aussi": a rotated slice of other articles, seeded by
// this article's slug so link equity spreads evenly across the catalogue
// (every article links to a different set instead of always the latest few).
let relatedArticles: { title: string; url: string; image?: string; date?: string }[] = [];
if (type === 'article') {
  const allArticles = await getCollection('articles');
  const pool = allArticles
    .filter((a: any) => a.data.slug !== entry.data.slug)
    // Never suggest /local/ SEO landing pages in the blog's "À lire aussi".
    .filter((a: any) => !(a.data.slug || '').startsWith('local/'))
    .map((a: any) => ({ url: `/${a.data.slug}/`, title: a.data.title, type: 'article', image: a.data.featuredImage, date: a.data.date }));
  // Only suggest reasonably fresh content: articles from the last 3 years
  // (2019-2021 pieces read stale). Fallback to the full pool if the recent
  // set is ever too small to fill the sidebar.
  const threeYearsAgo = Date.now() - 3 * 365.25 * 24 * 60 * 60 * 1000;
  const recentPool = pool.filter((a: any) => {
    const t = Date.parse(a.date || '');
    return !isNaN(t) && t >= threeYearsAgo;
  });
  relatedArticles = pickRotatedLinks(recentPool.length >= 6 ? recentPool : pool, entry.data.slug, 6).map((l: any) => ({ title: l.title, url: l.url, image: l.image, date: l.date }));
}

// Blog articles sit under the blog index — surface "Blog" as the middle crumb
// (Accueil › Blog › Article) to match the live site's breadcrumb trail.
const breadcrumbCrumbs = type === 'article'
  ? [{ label: 'Blog', href: '/blog-immobilier-marseille/' }]
  : undefined;

// Stale WP thank-you/confirmation pages should not be indexed (SEO audit fix).
const isThankYou = /merci-pour|confirmation-demande/i.test(entry.data.slug || '');

// Optional end-of-article expert card (frontmatter `expertCta: <expert-slug>`).
const ctaExpert = type === 'article' && entry.data.expertCta
  ? getExpertBySlug(entry.data.expertCta)
  : null;

// Article header byline (immersive header): author name + photo + reading time.
const authorName = (type === 'article' && entry.data.author) || null;
const authorPhoto = ctaExpert?.photo || null;
const wordCount = rawBody.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim().split(' ').filter(Boolean).length;
const readMin = Math.max(1, Math.round(wordCount / 200));
const articleDate = type === 'article' && entry.data.date
  ? new Date(entry.data.date).toLocaleDateString('fr-FR', { year: 'numeric', month: 'long', day: 'numeric' })
  : null;

// Extended SEO/OG overrides — only articles carry these fields (pages/static don't).
const seoCanonical = type === 'article' ? entry.data.canonicalUrl : undefined;
const seoOgTitle = type === 'article' ? entry.data.ogTitle : undefined;
const seoOgDescription = type === 'article' ? entry.data.ogDescription : undefined;
const seoTwitterCard = type === 'article' ? entry.data.twitterCard : undefined;
const seoNoindex = isThankYou || (type === 'article' && !!entry.data.noindex);
const seoNofollow = type === 'article' && !!entry.data.nofollow;
---

<BaseLayout title={title} description={description} bypassSeoMirror={bypassSeoMirror} ogImage={ogImage} canonical={seoCanonical} ogTitle={seoOgTitle} ogDescription={seoOgDescription} twitterCard={seoTwitterCard} noindex={seoNoindex} nofollow={seoNofollow} schemas={pageSchemas} breadcrumbCrumbs={breadcrumbCrumbs}>
  <article class:list={['content', `content--${type}`, { 'content--prix-m2': isPrixM2, 'content--hero-image': !!featuredImage && !bodyHasOwnH1 }]}>
    {!bodyHasOwnH1 && (
      <header class="content__header">
        {featuredImage && (
          <div class="content__header-media">
            <img src={featuredImage} alt={entry.data.title} loading="eager" />
            <div class="content__header-overlay"></div>
          </div>
        )}
        <div class="content__header-inner">
          {heroCategory && (
            <a class="content__eyebrow" href={`/categorie/${slugify(heroCategory)}/`}>{heroCategory}</a>
          )}
          <h1>{entry.data.title}</h1>
          {type === 'article' && (
            <div class="content__meta">
              {authorPhoto && <img class="content__meta-avatar" src={authorPhoto} alt={authorName || ''} width="40" height="40" loading="eager" />}
              {authorName && <span class="content__meta-author">{authorName}</span>}
              {authorName && articleDate && <span class="content__meta-sep">•</span>}
              {articleDate && <time datetime={entry.data.date}>{articleDate}</time>}
              {articleDate && <span class="content__meta-sep">•</span>}
              <span>{readMin} min de lecture</span>
            </div>
          )}
        </div>
      </header>
    )}

    {type === 'article' ? (
      <div class="content__layout">
        <div class="content__body">
          <Fragment set:html={rawBody} />
          {ctaExpert && (
            <div class="article-expert-cta">
              {entry.data.expertCtaTitle && (
                <h2 class="article-expert-cta__lead">{entry.data.expertCtaTitle}</h2>
              )}
              <ExpertContactCard expert={ctaExpert} />
            </div>
          )}
        </div>
        <BlogSidebar related={relatedArticles} />
      </div>
    ) : (
      <div class="content__body" set:html={rawBody}></div>
    )}

    {isEstimationPage && (
      <>
        <script is:inline src="https://fisher.pricehubble.com/widget.js"></script>
        <script is:inline set:html={`(function initFisher(){
  if (typeof FisherWidget === 'undefined') { return setTimeout(initFisher, 50); }
  FisherWidget.init({
    apiKey: '88b99291539f45ea8194a26d0fe7902b',
    iframe: '#fisher-widget',
    lang: 'fr',
    activeColor: '00733c',
    buttonColor: '00733c',
    textColor: '212529',
    consentGranted: true,
  });
})();`} />
      </>
    )}

    {type === 'article' && ((entry.data.categories?.length ?? 0) > 0 || (entry.data.tags?.length ?? 0) > 0) && (
      <footer class="content__footer">
        {(entry.data.categories?.length ?? 0) > 0 && (
        <div class="content__categories">
          {entry.data.categories.map((cat: string) => {
            const catSlug = cat.toLowerCase()
              .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
              .replace(/[^a-z0-9]+/g, '-')
              .replace(/^-|-$/g, '');
            return <a href={`/categorie/${catSlug}/`} class="tag">{cat}</a>;
          })}
        </div>
        )}
        {(entry.data.tags?.length ?? 0) > 0 && (
          <div class="content__tags">
            {entry.data.tags.map((tag: string) => {
              const tagSlug = tag.toLowerCase()
                .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
                .replace(/[^a-z0-9]+/g, '-')
                .replace(/^-|-$/g, '');
              return <a href={`/tag/${tagSlug}/`} class="tag tag--small">{tag}</a>;
            })}
          </div>
        )}
      </footer>
    )}
  </article>

  {isEstimationPage && (
    <style is:global>
      /* Estimation page — give the PriceHubble widget a clean card shell. The
         widget content is inside an iframe (cross-origin) so we can only style
         the wrapper + iframe element itself. */
      .content__body {
        background: #f6f7f9;
      }
      .content__body .post__content {
        max-width: 960px;
        margin: 0 auto;
        padding: 2.5rem 1rem 4rem;
      }
      #fisher-widget {
        display: block;
        width: 100%;
        min-height: 820px;
        border: 0;
        border-radius: 12px;
        background: #fff;
        box-shadow: 0 1px 3px rgba(0,0,0,.04), 0 8px 24px rgba(0,0,0,.06);
        overflow: hidden;
      }
      @media (max-width: 720px) {
        #fisher-widget { min-height: 1200px; border-radius: 8px; }
        .content__body .post__content { padding: 1.25rem .5rem 2.5rem; }
      }
    </style>
  )}
</BaseLayout>
