---
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const services = await getCollection('services');
const serviceList = services
  .filter(s => s.data.slug !== 'services')
  .sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<BaseLayout
  title="Nos services immobiliers – Immobilière Pujol"
  description="Découvrez tous les services immobiliers de l'Immobilière Pujol à Marseille : gestion locative, syndic, vente, location."
>
  <section class="seo-hero">
    <p class="seo-hero__eyebrow">L'Immobilière Pujol</p>
    <h1>Tous <b>nos services</b></h1>
    <p class="seo-hero__sub">
      Location, vente, gestion locative, syndic — découvrez l'ensemble des prestations sur-mesure que nous proposons aux particuliers et copropriétés marseillaises.
    </p>
    <span class="seo-hero__count">{serviceList.length} service{serviceList.length > 1 ? 's' : ''}</span>
  </section>

  <section class="seo-archive seo-archive--paper">
    <div class="seo-card-grid">
      {serviceList.map((service) => {
        const slug = service.data.slug.replace(/^services\//, '');
        return (
          <article class="seo-card seo-card--text">
            <div class="seo-card__body">
              <h2 class="seo-card__title">
                <a href={`/services/${slug}/`}>{service.data.title}</a>
              </h2>
              {service.data.seoDescription && (
                <p class="seo-card__excerpt">{service.data.seoDescription}</p>
              )}
              <span class="seo-card__date">Découvrir →</span>
            </div>
          </article>
        );
      })}
    </div>
  </section>
</BaseLayout>
