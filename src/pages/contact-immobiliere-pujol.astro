---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';

const seoTitle = "Contacter l'Immobilière Pujol – Marseille";
const seoDescription =
  "L'équipe Immobilière Pujol vous reçoit au 7 rue du Docteur Fiolle, 13006 Marseille — un conseiller vous répond sous 24 heures.";

// Canonical contact info (mirrors src/components/common/Footer.astro).
const contact = {
  address: '7 rue du Docteur Fiolle, 13006 Marseille',
  addressLine1: '7 rue du Docteur Fiolle',
  addressLine2: '13006 Marseille',
  mapHref:
    'https://maps.google.com/?q=Immobili%C3%A8re+Pujol+7+rue+du+Docteur+Fiolle+13006+Marseille',
  mapEmbed:
    'https://www.google.com/maps?q=7+rue+du+Docteur+Fiolle+13006+Marseille&output=embed',
  hours: 'Lun – Jeu : 9h – 12h / 14h – 18h • Ven : 9h – 12h / 14h – 17h',
};

const heroImg =
  'https://pub-a37eed540afe4dc9b4479da74ba265e1.r2.dev/2021/01/vinced-photo-immo-pujol-facade-27-1-1200x800.jpg';

const formObjects = [
  "Location : vous êtes intéressés par une annonce de location /à la recherche d'un bien à louer ?",
  'Vente/achat : vous souhaitez vendre /acheter un bien immobilier ?',
  'Gestion locative : vous souhaitez obtenir une proposition en gestion locative ?',
  'Client syndic : vous souhaitez joindre le gestionnaire/comptable de votre copropriété ?',
  'Syndic : vous souhaitez obtenir un devis en syndic pour votre copropriété ?',
  'Autre (bien détailler votre demande)',
];

// Quick-link cards driving the most common direct contact paths.
const quickLinks = [
  {
    title: "Vendre un bien",
    desc: "Estimer la valeur de votre bien sur le marché et activer sa commercialisation.",
    href: '/service-immobilier/vendre/#form',
    cta: 'Demander une estimation',
  },
  {
    title: "Confier un bien en gestion locative",
    desc: "Optimiser vos revenus locatifs en confiant la recherche de locataires et la gestion à nos experts.",
    href: '/service-immobilier/gestion-locative/#form',
    cta: 'Demander un devis',
  },
  {
    title: "Faire gérer une copropriété",
    desc: "Profiter d'une gestion transparente, réactive et rigoureuse pour valoriser votre immeuble.",
    href: '/service-immobilier/syndic-de-copropriete-a-marseille/#form',
    cta: 'Demander un devis syndic',
  },
];
---

<BaseLayout title={seoTitle} description={seoDescription}>
  {/* ============= HERO ============= */}
  <section class="svc-hero">
    <picture class="svc-hero__video">
      <img src={heroImg} alt="Façade de l'agence Immobilière Pujol à Marseille" loading="eager" />
    </picture>
    <div class="svc-hero__overlay"></div>

    <div class="svc-hero__inner">
      <h1><b>Contacter</b><br />l'Immobilière Pujol</h1>
      <a class="svc-hero__cta" href="#form">Nous écrire</a>
    </div>
  </section>

  <div class="svc-page">

    {/* ============= INFO CARDS ============= */}
    <section class="contact-info">
      <div class="contact-info__inner">
        <h2 class="ds-sec-title">Toutes les façons de <b>nous joindre</b></h2>

        <ul class="contact-info__grid">
          <li class="contact-card">
            <span class="contact-card__icon" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
                <path d="M12 21s-7-6.5-7-12a7 7 0 0 1 14 0c0 5.5-7 12-7 12z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
                <circle cx="12" cy="9" r="2.4" stroke="currentColor" stroke-width="1.6" />
              </svg>
            </span>
            <h3 class="contact-card__title">Adresse</h3>
            <p class="contact-card__body">
              {contact.addressLine1}<br />
              {contact.addressLine2}
            </p>
            <p class="contact-card__note">Uniquement sur rendez-vous</p>
            <a class="contact-card__cta" href={contact.mapHref} target="_blank" rel="noopener">
              Itinéraire
              <svg width="16" height="11" viewBox="0 0 22 14" fill="none" aria-hidden="true">
                <path d="M1 7 H20 M14 1 L20 7 L14 13" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </li>

          <li class="contact-card">
            <span class="contact-card__icon" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
                <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.6" />
                <path d="M12 7v5l3 2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
              </svg>
            </span>
            <h3 class="contact-card__title">Horaires</h3>
            <p class="contact-card__body">
              Lundi – Jeudi : 9h – 12h / 14h – 18h<br />
              Vendredi : 9h – 12h / 14h – 17h
            </p>
          </li>
        </ul>
      </div>
    </section>

    {/* ============= URGENCY BANNER ============= */}
    <section class="contact-urgency">
      <div class="contact-urgency__inner">
        <span class="contact-urgency__icon" aria-hidden="true">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none">
            <path d="M12 3 L22 20 H2 Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
            <path d="M12 10 V14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
            <circle cx="12" cy="17" r="1" fill="currentColor" />
          </svg>
        </span>
        <div class="contact-urgency__body">
          <h2>Une <b>urgence</b> en dehors des heures ouvrables ?</h2>
          <p>Dégât des eaux, incident ou sinistre le week-end et les jours fériés — déclarez-le directement à notre équipe.</p>
        </div>
        <a class="contact-urgency__cta" href="/declarer-une-urgence/">
          <span>Déclarer une urgence</span>
          <svg width="18" height="14" viewBox="0 0 22 14" fill="none" aria-hidden="true">
            <path d="M1 7 H20 M14 1 L20 7 L14 13" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </div>
    </section>

    {/* ============= FORM + MAP ============= */}
    <section class="contact-split" id="form">
      <div class="contact-split__inner">

        <form
          class="svc-form contact-split__form"
          method="post"
          action="https://pujol-email.roy-68a.workers.dev/contact"
          enctype="multipart/form-data"
          novalidate
          data-ajax-form
        >
          <h2>Prenez contact <b>avec nous</b></h2>
          <p class="svc-form__lead">
            Remplissez ce formulaire et nous prendrons contact avec vous dans les 24 heures.
          </p>

          <div class="svc-form__grid">
            <label class="svc-field">
              <span>Prénom *</span>
              <input type="text" name="input_6.3" placeholder="Prénom" required />
            </label>

            <label class="svc-field">
              <span>Nom *</span>
              <input type="text" name="input_6.6" placeholder="Nom" required />
            </label>

            <label class="svc-field">
              <span>Email *</span>
              <input type="email" name="input_2" placeholder="Email" required />
            </label>

            <label class="svc-field">
              <span>Téléphone *</span>
              <input type="tel" name="input_4" placeholder="Téléphone" required />
            </label>

            <label class="svc-field svc-field--full">
              <span>Objet de votre demande *</span>
              <select name="input_10" required>
                {formObjects.map((o) => (
                  <option value={o}>{o}</option>
                ))}
              </select>
            </label>

            <label class="svc-field svc-field--full">
              <span>Décrivez votre demande *</span>
              <textarea name="input_3" rows="6" placeholder="Décrivez votre demande" required></textarea>
            </label>
          </div>

          <label class="svc-form__agree">
            <input
              type="checkbox"
              name="input_9.1"
              value="J'accepte le traitement de mes données dans le cadre de ma demande"
              required
            />
            <span>J'accepte le traitement de mes données dans le cadre de ma demande *</span>
          </label>

          <p class="svc-form__legal">
            Dans le cadre de nos activités, nous traitons les données à caractère personnel de nos clients, prospects, salariés, dans le respect des règles posées par le Règlement général sur les données personnelles (RGPD) et par la loi n°78-17 du 6 janvier 1978 relative à l'informatique, aux fichiers et aux libertés. Vous pouvez accéder aux informations relatives aux traitements de vos données personnelles ainsi qu'à vos droits en consultant notre politique de traitements des données personnelles sur la page suivante&nbsp;: <a href="https://www.declarations-juridiques.fr/processing-policy/immobiliere-pujol_056808868" target="_blank" rel="noopener">https://www.declarations-juridiques.fr/processing-policy/immobiliere-pujol_056808868</a>. Vous pouvez vous opposer à ce que vos données soient utilisées par notre agence à des fins de prospection commerciale en contactant l'Immobilière Pujol au <a href="tel:0762203313">07&nbsp;62&nbsp;20&nbsp;33&nbsp;13</a> ou par mail&nbsp;: <a href="mailto:rgpd@immobiliere-pujol.fr">rgpd@immobiliere-pujol.fr</a>
          </p>

          {/* Honeypot — preserved from the legacy Gravity Forms markup. */}
          <div style="position:absolute;left:-10000px;top:auto;width:1px;height:1px;overflow:hidden" aria-hidden="true">
            <label>Company<input type="text" name="input_11" tabindex="-1" autocomplete="new-password" /></label>
          </div>
          <input type="hidden" name="gform_submit" value="4" />
          <input type="hidden" name="is_submit_4" value="1" />

          <button class="svc-form__submit" type="submit">
            <span>ENVOYER</span>
            <svg width="18" height="14" viewBox="0 0 22 14" fill="none">
              <path d="M1 7 H20 M14 1 L20 7 L14 13" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
        </form>

        <aside class="contact-split__map">
          <iframe
            src={contact.mapEmbed}
            title="Carte — Immobilière Pujol, 7 rue du Docteur Fiolle, 13006 Marseille"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen
          ></iframe>
          <a class="contact-split__map-cta" href={contact.mapHref} target="_blank" rel="noopener">
            Ouvrir dans Google Maps
            <svg width="16" height="11" viewBox="0 0 22 14" fill="none" aria-hidden="true">
              <path d="M1 7 H20 M14 1 L20 7 L14 13" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </aside>
      </div>
    </section>

    {/* ============= QUICK-LINKS ============= */}
    <section class="contact-quick">
      <div class="contact-quick__inner">
        <h2 class="ds-sec-title">Vous savez déjà <b>ce que vous cherchez ?</b></h2>
        <ul class="contact-quick__grid">
          {quickLinks.map((q) => (
            <li class="contact-quick-card">
              <h3 class="contact-quick-card__title">{q.title}</h3>
              <p class="contact-quick-card__desc">{q.desc}</p>
              <a class="contact-quick-card__cta" href={q.href}>
                <span>{q.cta}</span>
                <svg width="18" height="14" viewBox="0 0 22 14" fill="none" aria-hidden="true">
                  <path d="M1 7 H20 M14 1 L20 7 L14 13" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

  </div>

  <script>
    document.querySelectorAll<HTMLFormElement>('[data-ajax-form]').forEach((form) => {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (!form.reportValidity()) return;
        const btn = form.querySelector<HTMLButtonElement>('.svc-form__submit');
        if (btn) { btn.disabled = true; btn.style.opacity = '0.6'; }
        try {
          const res = await fetch(form.action, { method: 'POST', body: new FormData(form) });
          const data = await res.json();
          if (data.ok) {
            try { ((window as any).dataLayer = (window as any).dataLayer || []).push({ event: 'form_submit', form_type: 'contact' }); } catch (e) {}
            form.innerHTML = '<div class="svc-form__success"><h2>Merci !</h2><p>Votre message a bien été envoyé. Nous vous recontacterons dans les 24 heures.</p></div>';
          } else {
            showError(form, data.error || "Une erreur est survenue. Veuillez réessayer.");
            if (btn) { btn.disabled = false; btn.style.opacity = ''; }
          }
        } catch {
          showError(form, "Erreur de connexion. Veuillez réessayer.");
          if (btn) { btn.disabled = false; btn.style.opacity = ''; }
        }
      });
    });
    function showError(form: HTMLFormElement, msg: string) {
      let el = form.querySelector('.svc-form__error');
      if (!el) {
        el = document.createElement('p');
        el.className = 'svc-form__error';
        (el as HTMLElement).style.cssText = 'color:#c0392b;font-weight:600;margin-top:12px';
        form.querySelector('.svc-form__submit')?.insertAdjacentElement('beforebegin', el);
      }
      el.textContent = msg;
    }
  </script>
</BaseLayout>
