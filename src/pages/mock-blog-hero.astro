---
// TEMPORARY mock page — 3 header/hero options for blog articles, to compare
// and pick one with Caroline. Not linked anywhere, noindex. Safe to delete.
import BaseLayout from '../layouts/BaseLayout.astro';

const sample = {
  category: 'Mes conseils pour investir en immobilier à Marseille',
  title: "Investissement locatif : le coût caché que la plupart des propriétaires sous-estiment (et comment l'éviter)",
  date: '1 juillet 2026',
  author: 'Gaëlle Lapert',
  authorRole: 'Responsable Commerciale en gestion locative',
  authorPhoto: '/images/experts/gaelle-lapert.png',
  image: '/images/blog/gaelle-vacance-locative.jpg',
  readTime: '5 min de lecture',
  excerpt: "La vacance locative est le coût invisible qui ampute le plus la rentabilité d'un investissement. Voici ses 3 causes et la méthode pour l'éviter.",
};
---

<BaseLayout title="Mock — En-têtes d'article de blog" description="Comparatif de 3 en-têtes" noindex={true}>
  <div class="hm">
    <p class="hm__intro">Comparatif de 3 en-têtes possibles pour le haut des articles de blog. Choisissez celui que vous préférez (ou un mélange).</p>

    <!-- ============ OPTION 1 — Immersif amélioré ============ -->
    <div class="hm__tag">Option 1 — Immersif (image plein cadre, meilleure lisibilité + auteur)</div>
    <header class="opt1">
      <img class="opt1__img" src={sample.image} alt="" />
      <div class="opt1__grad"></div>
      <div class="opt1__inner">
        <span class="chip chip--green">{sample.category}</span>
        <h1 class="opt1__title">{sample.title}</h1>
        <div class="meta meta--light">
          <img class="meta__avatar" src={sample.authorPhoto} alt={sample.author} />
          <span class="meta__author">{sample.author}</span>
          <span class="meta__dot">•</span>
          <span>{sample.date}</span>
          <span class="meta__dot">•</span>
          <span>{sample.readTime}</span>
        </div>
      </div>
    </header>

    <!-- ============ OPTION 2 — Éditorial (texte + image) ============ -->
    <div class="hm__tag">Option 2 — Éditorial (texte sur bandeau, image à côté — lisible sur toute photo)</div>
    <header class="opt2">
      <div class="opt2__text">
        <span class="chip chip--paper">{sample.category}</span>
        <h1 class="opt2__title">{sample.title}</h1>
        <p class="opt2__excerpt">{sample.excerpt}</p>
        <div class="meta meta--light">
          <img class="meta__avatar" src={sample.authorPhoto} alt={sample.author} />
          <span>
            <span class="meta__author">{sample.author}</span><br />
            <span class="meta__sub">{sample.date} · {sample.readTime}</span>
          </span>
        </div>
      </div>
      <div class="opt2__media">
        <img src={sample.image} alt="" />
      </div>
    </header>

    <!-- ============ OPTION 3 — Épuré / magazine ============ -->
    <div class="hm__tag">Option 3 — Épuré / magazine (titre centré, image en dessous)</div>
    <header class="opt3">
      <span class="chip chip--green">{sample.category}</span>
      <h1 class="opt3__title">{sample.title}</h1>
      <div class="meta meta--dark">
        <img class="meta__avatar" src={sample.authorPhoto} alt={sample.author} />
        <span class="meta__author">{sample.author}</span>
        <span class="meta__dot">•</span>
        <span>{sample.date}</span>
        <span class="meta__dot">•</span>
        <span>{sample.readTime}</span>
      </div>
      <div class="opt3__media">
        <img src={sample.image} alt="" />
      </div>
    </header>

    <div class="hm__end">Fin du comparatif — le corps de l'article viendrait ensuite.</div>
  </div>
</BaseLayout>

<style>
  .hm { --navy:#0f1a2b; --green:#B2C54F; --paper:#eef3ef; --ink:#22303a; --muted:#55666f; }
  .hm__intro { max-width: 820px; margin: 28px auto 8px; padding: 0 20px; color: #55666f; font-size: 15px; text-align:center; }
  .hm__tag { max-width: 1180px; margin: 44px auto 14px; padding: 8px 16px; background: #0f1a2b; color:#fff; font-size: 13px; font-weight:700; letter-spacing:.3px; border-radius: 8px; }
  .hm__end { max-width:1180px; margin: 40px auto 60px; padding: 16px; text-align:center; color:#9aa7ad; font-style: italic; border-top: 1px dashed #d7dee1; }

  .chip { display:inline-block; font-size:12px; font-weight:700; letter-spacing:.5px; text-transform:uppercase; padding:6px 12px; border-radius:999px; }
  .chip--green { background: var(--green); color: #16240a; }
  .chip--paper { background: #fff; color: var(--navy); border:1px solid #dfe6df; }

  .meta { display:flex; align-items:center; gap:10px; font-size:14px; }
  .meta__avatar { width:38px; height:38px; border-radius:50%; object-fit:cover; border:2px solid rgba(255,255,255,.7); }
  .meta__author { font-weight:700; }
  .meta__sub { opacity:.85; font-size:13px; }
  .meta__dot { opacity:.5; }
  .meta--light { color:#fff; }
  .meta--light .meta__avatar { border-color: rgba(255,255,255,.8); }
  .meta--dark { color: var(--muted); justify-content:center; }
  .meta--dark .meta__avatar { border-color:#e5e9ea; }

  /* OPTION 1 */
  .opt1 { position:relative; max-width:1180px; margin:0 auto; height:460px; border-radius:20px; overflow:hidden; }
  .opt1__img { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; }
  .opt1__grad { position:absolute; inset:0; background: linear-gradient(180deg, rgba(15,26,43,.15) 0%, rgba(15,26,43,.05) 40%, rgba(15,26,43,.82) 100%); }
  .opt1__inner { position:absolute; left:0; right:0; bottom:0; padding:34px 40px; display:flex; flex-direction:column; gap:16px; }
  .opt1__title { color:#fff; font-size:34px; line-height:1.2; margin:0; max-width:820px; text-shadow:0 2px 20px rgba(0,0,0,.35); }

  /* OPTION 2 */
  .opt2 { max-width:1180px; margin:0 auto; display:grid; grid-template-columns: 1.05fr .95fr; background: var(--navy); border-radius:20px; overflow:hidden; }
  .opt2__text { padding:44px 40px; display:flex; flex-direction:column; gap:18px; color:#fff; justify-content:center; }
  .opt2__title { color:#fff; font-size:32px; line-height:1.22; margin:0; }
  .opt2__excerpt { margin:0; opacity:.82; font-size:16px; line-height:1.5; }
  .opt2__media { position:relative; min-height:420px; }
  .opt2__media img { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; }

  /* OPTION 3 */
  .opt3 { max-width:820px; margin:0 auto; padding:16px 20px 0; text-align:center; display:flex; flex-direction:column; align-items:center; gap:18px; }
  .opt3__title { color:var(--navy); font-size:36px; line-height:1.18; margin:6px 0 0; }
  .opt3__media { width:100%; max-width:1000px; margin-top:6px; }
  .opt3__media img { width:100%; aspect-ratio:16/9; object-fit:cover; border-radius:18px; }
  .opt3 { max-width:1180px; }

  @media (max-width: 820px) {
    .opt1 { height:400px; }
    .opt1__title, .opt2__title { font-size:24px; }
    .opt2 { grid-template-columns:1fr; }
    .opt2__media { min-height:240px; }
    .opt3__title { font-size:26px; }
  }
</style>
