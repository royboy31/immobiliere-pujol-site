---
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { GetStaticPaths } from 'astro';

interface QuartierData {
  slug: string;
  name: string;
  displayName: string;
  postalCode?: string;
  annonceCount?: number;
  seoTitle?: string;
  seoDescription?: string;
}

export const getStaticPaths: GetStaticPaths = async () => {
  // Use import.meta.glob (Vite-compatible, no Node.js fs needed)
  const modules = import.meta.glob<QuartierData>('../../content/quartiers/*.json', { eager: true, import: 'default' });

  return Object.values(modules).map((data) => ({
    params: { slug: data.slug },
    props: { entry: data },
  }));
};

interface Props {
  entry: QuartierData;
}

const { entry } = Astro.props;
const { displayName, postalCode, annonceCount, seoTitle, seoDescription } = entry;

const title = seoTitle || `${displayName} – Annonces immobilières | Immobilière Pujol`;
const description = seoDescription || `Découvrez les biens immobiliers dans le quartier ${displayName} à Marseille. Location et vente d'appartements et maisons.`;
---

<BaseLayout title={title} description={description}>
  <section class="seo-hero">
    <p class="seo-hero__eyebrow">{postalCode ? `${postalCode} Marseille` : 'Quartier Marseille'}</p>
    <h1>Quartier <b>{displayName}</b></h1>
    {(annonceCount ?? 0) > 0 && (
      <span class="seo-hero__count">{annonceCount} annonce{(annonceCount ?? 0) > 1 ? 's' : ''} dans ce quartier</span>
    )}
  </section>

  <div class="seo-area">
    <div class="seo-area__intro">
      <p>
        Retrouvez toutes les annonces immobilières dans le quartier <strong>{displayName}</strong> à Marseille.
        Que vous cherchiez un appartement à louer ou un bien à acheter, l'Immobilière Pujol vous accompagne
        dans votre projet immobilier.
      </p>
    </div>

    <section class="seo-area__cta-section">
      <h2 class="ds-sec-title">Nos annonces à <b>{displayName}</b></h2>
      <p>Explorez les biens disponibles à la location et à la vente dans ce quartier marseillais.</p>
      <div class="seo-area__cta-row">
        <a href="/annonces/" class="seo-cta seo-cta--filled">Voir toutes les annonces</a>
        <a href="/annonces/locations/" class="seo-cta">Locations</a>
        <a href="/annonces/ventes/" class="seo-cta seo-cta--vente">Ventes</a>
      </div>
    </section>
  </div>
</BaseLayout>
