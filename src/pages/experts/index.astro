---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getExpertType } from '../../lib/experts';

const experts = await getCollection('experts');

// Title is stored as "First [Last] – Role". The role comes back via `fonction`,
// so we only need the name half here.
function splitName(title: string): { first: string; last: string } {
  const cleaned = (title || '').split('|').pop()?.trim() || '';
  const namePart = cleaned.split(/\s+[–-]\s+/)[0].trim();
  const parts = namePart.split(/\s+/);
  return {
    first: parts[0] || namePart,
    last: parts.slice(1).join(' '),
  };
}

type Item = {
  slug: string;
  photo?: string;
  fonction?: string;
  type: string;
  first: string;
  last: string;
};

// Build the list of visible experts (hidden=true are kept in the collection
// for backlink preservation but don't appear on the listing).
const items: Item[] = experts
  .filter((entry) => !entry.data.hidden && !entry.data.listingOnly)
  .map((entry) => {
    const e = entry.data;
    const { first, last } = splitName(e.title);
    return {
      slug: e.slug,
      photo: e.photo,
      fonction: e.fonction,
      type: getExpertType(e),
      first,
      last,
    };
  });

// Section ordering — Caroline's choice (meeting 15/05): direction first, then
// the commercial teams, then anyone else.
const DEPT_ORDER: { key: string; label: string; lede: string }[] = [
  {
    key: 'Direction',
    label: 'Direction',
    lede: "Les associés et directeurs qui pilotent l'agence.",
  },
  {
    key: 'Vente',
    label: 'Vente',
    lede: "Spécialistes de la vente d'appartements et de maisons sur Marseille.",
  },
  {
    key: 'Gestion locative',
    label: 'Gestion locative',
    lede: "L'équipe qui gère vos biens en location.",
  },
  {
    key: 'Syndic',
    label: 'Syndic de copropriété',
    lede: "Gestionnaires de copropriétés à Marseille.",
  },
];

// Group items by department, preserving the order above.
const sections = DEPT_ORDER.map((d) => {
  // Match by the raw experts entry so we can read its `department` field
  // (which the Item type doesn't carry — keeping Item minimal for the card).
  const group = experts
    .filter((entry) => !entry.data.hidden && (entry.data.department || '') === d.key)
    .sort((a, b) => (a.data.order ?? Infinity) - (b.data.order ?? Infinity))
    .map((entry) => {
      const { first, last } = splitName(entry.data.title);
      return {
        slug: entry.data.slug,
        photo: entry.data.photo,
        fonction: entry.data.fonction,
        type: getExpertType(entry.data),
        first,
        last,
      } as Item;
    });
  return { ...d, items: group };
}).filter((s) => s.items.length > 0);

// Anyone visible without a department falls under "Autres expertises" so we
// never silently drop a card.
const placedSlugs = new Set(sections.flatMap((s) => s.items.map((i) => i.slug)));
const orphans = items.filter((i) => !placedSlugs.has(i.slug));
if (orphans.length) {
  sections.push({
    key: 'autres',
    label: 'Autres expertises',
    lede: '',
    items: orphans,
  });
}
---

<BaseLayout
  title="Nos experts immobiliers à Marseille – Immobilière Pujol"
  description="Découvrez l'équipe d'experts immobiliers de l'Immobilière Pujol à Marseille."
>
  <section class="experts-archive">
    <div class="experts-archive__head">
      <span class="experts-archive__overline">L'équipe</span>
      <h1 class="ds-sec-title">Toutes nos <b>expertises immobilières</b></h1>
      <p class="experts-archive__lede">
        Un seul interlocuteur pour trois expertises métier : Syndic • Vente • Gestion.
      </p>
      <div class="experts-archive__legend">
        <span class="experts-archive__chip experts-archive__chip--sales">Vente</span>
        <span class="experts-archive__chip experts-archive__chip--rental">Gestion locative</span>
        <span class="experts-archive__chip experts-archive__chip--syndic">Syndic</span>
        <span class="experts-archive__chip experts-archive__chip--other">Direction</span>
      </div>
    </div>

    {sections.map((s) => (
      <section class="experts-archive__dept">
        <header class="experts-archive__dept-head">
          <h2 class="experts-archive__dept-title">{s.label}</h2>
          {s.lede && <p class="experts-archive__dept-lede">{s.lede}</p>}
        </header>
        <div class="experts-archive__grid">
          {s.items.map((p) => (
            <a href={`/experts/${p.slug}/`} class={`expert-tile expert-tile--${p.type}`}>
              <div class="expert-tile__ph">
                {p.photo ? (
                  <img src={p.photo} alt={`${p.first} ${p.last}`.trim()} loading="lazy" />
                ) : (
                  <span class="expert-tile__ph-empty" aria-hidden="true">{p.first.charAt(0)}</span>
                )}
              </div>
              <div class="expert-tile__name">
                {p.first}{p.last && <> <b>{p.last}</b></>}
              </div>
              {p.fonction && <div class="expert-tile__role">{p.fonction}</div>}
            </a>
          ))}
        </div>
      </section>
    ))}
  </section>
</BaseLayout>
