---
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';

// Landing after one-click alert unsubscribe (redirect target of
// /api/alerts/unsubscribe).
const seoTitle = 'Alerte désactivée — Immobilière Pujol';
const seoDescription = 'Votre alerte annonces a bien été désactivée.';
---

<BaseLayout title={seoTitle} description={seoDescription} noindex={true}>
  <section class="al-confirm">
    <div class="al-confirm__card">
      <div class="al-confirm__mark al-confirm__mark--off" aria-hidden="true">
        <svg width="30" height="30" viewBox="0 0 24 24" fill="none">
          <path d="M6 12 H18" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
        </svg>
      </div>
      <h1>Votre alerte est désactivée.</h1>
      <p>
        Vous ne recevrez plus d’e-mails pour cette alerte. Vous pouvez en créer une
        nouvelle à tout moment depuis une annonce ou la page dédiée.
      </p>
      <a class="al-confirm__cta" href="/alerte/">Créer une nouvelle alerte</a>
    </div>
  </section>
</BaseLayout>

<style>
  .al-confirm { display: flex; justify-content: center; padding: 72px 20px 96px; }
  .al-confirm__card { max-width: 620px; width: 100%; text-align: center; }
  .al-confirm__mark {
    width: 68px; height: 68px; margin: 0 auto 24px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    background: rgba(178, 197, 79, 0.16); color: #7f9420;
  }
  .al-confirm__mark--off { background: rgba(120, 130, 141, 0.16); color: #77828d; }
  .al-confirm__card h1 { font-size: clamp(26px, 4vw, 34px); line-height: 1.25; color: #1f2a30; margin: 0 0 18px; }
  .al-confirm__card p { font-size: 17px; line-height: 1.6; color: #4a5560; margin: 0 0 14px; }
  .al-confirm__cta {
    display: inline-block; margin-top: 26px; padding: 13px 30px; border-radius: 999px;
    background: #1f2a30; color: #fff; font-weight: 700; text-decoration: none;
    transition: transform 0.15s ease, opacity 0.15s ease;
  }
  .al-confirm__cta:hover { transform: translateY(-1px); opacity: 0.92; }
</style>
