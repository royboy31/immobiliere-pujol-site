---
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths: GetStaticPaths = async () => {
  const arrondissements = await getCollection('arrondissements');
  return arrondissements.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
};

interface Props {
  entry: any;
}

const { entry } = Astro.props;
const { name, slug, count, zipContent, seoTitle, seoDescription } = entry.data;

const title = seoTitle || `${name} – Annonces immobilières | Immobilière Pujol`;
const description = seoDescription || `Découvrez nos annonces immobilières dans le ${name}. ${count} biens disponibles à la location et à la vente.`;
---

<BaseLayout title={title} description={description}>
  <section class="seo-hero">
    <p class="seo-hero__eyebrow">Arrondissement Marseille</p>
    <h1>{name}</h1>
    <span class="seo-hero__count">{count} annonce{count > 1 ? 's' : ''} dans ce secteur</span>
  </section>

  <div class="seo-area">
    {zipContent && (
      <div class="seo-area__intro">
        <Fragment set:html={zipContent} />
      </div>
    )}

    <section class="seo-area__cta-section">
      <h2 class="ds-sec-title">Annonces dans <b>le {name}</b></h2>
      <p>Découvrez tous les biens disponibles à la location et à la vente dans ce secteur.</p>
      <div class="seo-area__cta-row">
        <a href="/annonces/" class="seo-cta seo-cta--filled">Voir toutes les annonces</a>
        <a href="/annonces/locations/" class="seo-cta">Locations</a>
        <a href="/annonces/ventes/" class="seo-cta seo-cta--vente">Ventes</a>
      </div>
    </section>
  </div>
</BaseLayout>
