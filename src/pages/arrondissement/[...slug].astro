---
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths: GetStaticPaths = async () => {
  const arrondissements = await getCollection('arrondissements');
  return arrondissements.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
};

interface Props {
  entry: any;
}

const { entry } = Astro.props;
const { name, slug, count, zipContent, seoTitle, seoDescription } = entry.data;

const title = seoTitle || `${name} – Annonces immobilières | Immobilière Pujol`;
const description = seoDescription || `Découvrez nos annonces immobilières dans le ${name}. ${count} biens disponibles à la location et à la vente.`;
---

<BaseLayout title={title} description={description}>
  <section class="seo-hero">
    <p class="seo-hero__eyebrow">Arrondissement Marseille</p>
    <h1>{name}</h1>
    <span class="seo-hero__count">{count} annonce{count > 1 ? 's' : ''} dans ce secteur</span>
  </section>

  <div class="seo-area">
    {zipContent && (
      <div class="seo-area__intro">
        <Fragment set:html={zipContent} />
      </div>
    )}

    <section class="seo-area__cta-section">
      <h2 class="ds-sec-title">Annonces dans <b>le {name}</b></h2>
      <p>Découvrez tous les biens disponibles à la location et à la vente dans ce secteur.</p>
      <div class="seo-area__cta-row">
        <a href="/annonces/" class="seo-cta seo-cta--filled">Voir toutes les annonces</a>
        <a href="/annonces/locations/" class="seo-cta">Locations</a>
        <a href="/annonces/ventes/" class="seo-cta seo-cta--vente">Ventes</a>
      </div>
    </section>

    <section class="seo-area__services-section">
      <h2 class="ds-sec-title">Nos services dans <b>le {name}</b></h2>
      <p>Nos équipes accompagnent les propriétaires et acquéreurs du secteur {name} sur l'ensemble du parcours immobilier.</p>
      <ul class="seo-services-list">
        <li>
          <a href="/service-immobilier/mettre-en-location/">
            Mettre votre bien en location à {name}
          </a>
        </li>
        <li>
          <a href="/service-immobilier/gestion-locative/">
            Faire gérer votre bien à {name}
          </a>
        </li>
        <li>
          <a href="/service-immobilier/vendre/">
            Vendre votre bien à {name}
          </a>
        </li>
        <li>
          <a href="/service-immobilier/syndic-de-copropriete-a-marseille/">
            Syndic de copropriété à {name}
          </a>
        </li>
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  .seo-area__services-section {
    margin-top: 2.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border, #e5e5e5);
  }
  .seo-services-list {
    list-style: none;
    padding: 0;
    margin: 1.25rem 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 0.5rem;
  }
  .seo-services-list li {
    margin: 0;
  }
  .seo-services-list a {
    display: block;
    padding: 0.75rem 1rem;
    background: var(--color-bg-subtle, #f8f8f6);
    color: inherit;
    text-decoration: none;
    border-radius: 6px;
    font-weight: 500;
    transition: background 0.15s, transform 0.15s;
  }
  .seo-services-list a::before {
    content: '→ ';
    color: var(--ds-orange, #ec7234);
    margin-right: 0.25rem;
  }
  .seo-services-list a:hover {
    background: var(--color-bg-subtle-hover, #efefea);
    transform: translateX(2px);
  }
</style>
