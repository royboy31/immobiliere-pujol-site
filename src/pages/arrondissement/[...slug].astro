---
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { fetchActiveListings } from '../../lib/r2-annonces';
import AnnonceCard from '../../components/annonces/AnnonceCard.astro';
import type { GetStaticPaths } from 'astro';

// One template handles three URL shapes (matching live WP):
//   /arrondissement/{slug}/            → all active listings for the secteur (V + L)
//   /arrondissement/{slug}/locations/  → rentals only (type=L)
//   /arrondissement/{slug}/ventes/     → sales only  (type=V)
//
// Locations + ventes variants are generated only for Marseille CPs (13001-13016).
// Non-Marseille entries in the arrondissements collection (e.g. 04000, 06000)
// keep their single base page since they have no Marseille-style nav.

export const getStaticPaths: GetStaticPaths = async () => {
  const arrondissements = await getCollection('arrondissements');
  const paths: Array<{ params: { slug: string }; props: { entry: any; scope: 'all' | 'V' | 'L' } }> = [];

  for (const entry of arrondissements) {
    const baseSlug = entry.data.slug;
    paths.push({ params: { slug: baseSlug }, props: { entry, scope: 'all' } });

    // Generate type-filtered variants for Marseille CPs only.
    if (/^130(0[1-9]|1[0-6])$/.test(baseSlug)) {
      paths.push({ params: { slug: `${baseSlug}/locations` }, props: { entry, scope: 'L' } });
      paths.push({ params: { slug: `${baseSlug}/ventes` }, props: { entry, scope: 'V' } });
    }
  }

  return paths;
};

interface Props {
  entry: any;
  scope: 'all' | 'V' | 'L';
}

const { entry, scope } = Astro.props;
const { name, slug: baseSlug, zipContent, seoTitle, seoDescription } = entry.data;

// Fetch active listings once, filter by CP + (optional) type.
const allActive = await fetchActiveListings();
const cpMatch = (a: { codePostal?: string }) => (a.codePostal || '') === baseSlug;
const listings = allActive
  .filter(cpMatch)
  .filter((a) => (scope === 'all' ? true : a.type === scope))
  .sort((a, b) => (b.prix ?? 0) - (a.prix ?? 0));

const ventesCount = allActive.filter((a) => cpMatch(a) && a.type === 'V').length;
const locsCount = allActive.filter((a) => cpMatch(a) && a.type === 'L').length;
const totalCount = ventesCount + locsCount;

const scopeLabel = scope === 'V' ? 'Ventes' : scope === 'L' ? 'Locations' : 'Annonces';
const scopeIntro =
  scope === 'V'
    ? `Tous les biens à vendre actuellement disponibles dans le ${name}.`
    : scope === 'L'
      ? `Tous les biens à louer actuellement disponibles dans le ${name}.`
      : `Tous les biens à la location et à la vente actuellement disponibles dans le ${name}.`;

const title = seoTitle
  || (scope === 'V' ? `Ventes immobilières dans le ${name} – Immobilière Pujol`
    : scope === 'L' ? `Locations dans le ${name} – Immobilière Pujol`
      : `${name} – Annonces immobilières | Immobilière Pujol`);

const description = seoDescription
  || (scope === 'V' ? `Découvrez nos ${ventesCount} biens à vendre dans le ${name} à Marseille.`
    : scope === 'L' ? `Découvrez nos ${locsCount} biens à louer dans le ${name} à Marseille.`
      : `Découvrez nos annonces immobilières dans le ${name}. ${totalCount} biens disponibles à la location et à la vente.`);

const isMarseilleCp = /^130(0[1-9]|1[0-6])$/.test(baseSlug);

// Breadcrumb trail: replace the auto-generated "Arrondissement" (404) intermediate
// with semantic crumbs. For type-filtered variants we link back to the base
// arrondissement page so users can navigate up the hierarchy.
const breadcrumbCrumbs: Array<{ label: string; href: string | null }> = [
  { label: 'Annonces', href: '/annonces/' },
];
if (scope === 'all') {
  breadcrumbCrumbs.push({ label: `Annonces dans le ${name}`, href: null });
} else {
  breadcrumbCrumbs.push({ label: name, href: `/arrondissement/${baseSlug}/` });
  breadcrumbCrumbs.push({
    label: scope === 'L' ? `Locations dans le ${name}` : `Ventes dans le ${name}`,
    href: null,
  });
}
---

<BaseLayout title={title} description={description} breadcrumbCrumbs={breadcrumbCrumbs}>
  <section class="seo-hero">
    <p class="seo-hero__eyebrow">Arrondissement Marseille</p>
    <h1>{name}{scope !== 'all' && <> — <b>{scopeLabel}</b></>}</h1>
    <p class="seo-hero__sub">
      {listings.length > 0
        ? `${listings.length} bien${listings.length > 1 ? 's' : ''} actuellement disponible${listings.length > 1 ? 's' : ''} dans ce secteur.`
        : `Aucun bien actuellement disponible dans cette catégorie — découvrez les autres secteurs et services ci-dessous.`}
    </p>
    {isMarseilleCp && (
      <nav class="annonces-pills arr-pills">
        <a href={`/arrondissement/${baseSlug}/`} class={scope === 'all' ? 'is-active' : ''}>
          Toutes <span class="count">({totalCount})</span>
        </a>
        <a href={`/arrondissement/${baseSlug}/locations/`} class={scope === 'L' ? 'is-active' : ''} data-kind="loc">
          Locations <span class="count">({locsCount})</span>
        </a>
        <a href={`/arrondissement/${baseSlug}/ventes/`} class={scope === 'V' ? 'is-active' : ''} data-kind="vente">
          Ventes <span class="count">({ventesCount})</span>
        </a>
      </nav>
    )}
  </section>

  {zipContent && (
    <section class="arr-intro-section">
      <div class="arr-intro">
        <Fragment set:html={zipContent} />
      </div>
    </section>
  )}

  <section class="annonces-grid-section arr-listings-section">
    {listings.length > 0 ? (
      <div class="annonces-grid">
        {listings.map((a) => <AnnonceCard annonce={a} />)}
      </div>
    ) : (
      <div class="arr-empty">
        <h2>Aucun bien <b>pour le moment</b></h2>
        <p>Décrivez-nous votre projet, nous vous prévenons dès qu'un bien correspond à vos critères dans le {name}.</p>
        <div class="arr-empty__cta-row">
          <a href="/annonces/" class="seo-cta seo-cta--filled">Voir toutes les annonces</a>
          <a href="/contact-immobiliere-pujol/" class="seo-cta">Nous contacter</a>
        </div>
      </div>
    )}
  </section>

  <section class="arr-services-section">
    <div class="arr-services">
      <header class="arr-services__head">
        <span class="arr-services__overline">Nos prestations</span>
        <h2 class="ds-sec-title">Nos services dans <b>le {name}</b></h2>
        <p class="arr-services__lede">
          Nos équipes accompagnent les propriétaires et acquéreurs du secteur {name} sur l'ensemble du parcours immobilier.
        </p>
      </header>
      <ul class="arr-services__list">
        <li>
          <a href="/service-immobilier/mettre-en-location/">
            <span class="arr-services__label">Mettre votre bien en location</span>
            <span class="arr-services__sub">à {name}</span>
          </a>
        </li>
        <li>
          <a href="/service-immobilier/gestion-locative/">
            <span class="arr-services__label">Faire gérer votre bien</span>
            <span class="arr-services__sub">à {name}</span>
          </a>
        </li>
        <li>
          <a href="/service-immobilier/vendre/">
            <span class="arr-services__label">Vendre votre bien</span>
            <span class="arr-services__sub">à {name}</span>
          </a>
        </li>
        <li>
          <a href="/service-immobilier/syndic-de-copropriete-a-marseille/">
            <span class="arr-services__label">Syndic de copropriété</span>
            <span class="arr-services__sub">à {name}</span>
          </a>
        </li>
      </ul>
    </div>
  </section>
</BaseLayout>

<style lang="scss">
  @use '../../styles/base/variables' as *;

  // Side padding token — same value used by _home.scss and _seo-archive.scss
  // ($ds-side-pad / $ds-side-pad-seo) but those are locally scoped, so we
  // redeclare here for use in the scoped style block.
  $arr-side-pad: unquote("max(100px, calc(50% - 620px))");

  // Pills sit under the hero — give them breathing room and constrain them
  // inside the hero so they read as part of the page header.
  .arr-pills {
    margin-top: 28px;
  }

  // Intro paragraph from WP zipContent — keep the legacy SEO copy readable
  // but contained so it doesn't dominate the page above the listings.
  .arr-intro-section {
    background: $white;
    padding: 24px $arr-side-pad 8px;
  }
  .arr-intro {
    max-width: 1100px;
    margin: 0 auto;
    font-family: $ds-font-noto;
    font-weight: 300;
    font-size: 17px;
    line-height: 1.65;
    color: $ds-ink;

    p { margin: 0 0 14px; }
    strong { font-weight: 700; color: $black; }
    ul { list-style: disc; padding-left: 22px; margin: 12px 0 18px; }
    li { margin-bottom: 4px; }
  }

  // Pull the listings section up tight under the intro / hero so the grid
  // reads as the main content of the page.
  .arr-listings-section {
    padding-top: 40px;
    padding-bottom: 80px;
  }

  // Empty state — only shows when a sub-filter has zero listings.
  .arr-empty {
    background: $white;
    border-radius: 18px;
    padding: 60px 32px;
    text-align: center;
    box-shadow: 0 6px 22px rgba(0, 0, 0, .05);
    max-width: 720px;
    margin: 0 auto;

    h2 {
      font-family: $ds-font-helv;
      font-weight: 300;
      font-size: 36px;
      margin: 0 0 14px;
      color: $black;
      b { font-weight: 700; }
    }
    p {
      font-family: $ds-font-noto;
      font-weight: 300;
      font-size: 17px;
      color: $ds-ink;
      margin: 0 auto 24px;
      max-width: 480px;
    }
  }
  .arr-empty__cta-row {
    display: flex;
    justify-content: center;
    gap: 14px;
    flex-wrap: wrap;
  }

  // ===== SERVICES BLOCK =====
  // A bordered band at the bottom of every arrondissement page. Drives the
  // SEO link distribution to the 4 main service landings.
  .arr-services-section {
    background: $ds-paper;
    padding: 80px $arr-side-pad 110px;
  }
  .arr-services {
    max-width: 1100px;
    margin: 0 auto;
  }
  .arr-services__head {
    text-align: center;
    margin-bottom: 40px;
  }
  .arr-services__overline {
    display: block;
    font-family: $ds-font-noto;
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    color: $ds-orange;
    margin-bottom: 12px;
  }
  .arr-services__lede {
    font-family: $ds-font-noto;
    font-weight: 300;
    font-size: 17px;
    color: $ds-ink;
    margin: 14px auto 0;
    max-width: 620px;
    line-height: 1.55;
  }
  .arr-services__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }
  .arr-services__list li { margin: 0; }
  .arr-services__list a {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 22px 26px;
    background: $white;
    color: $black;
    text-decoration: none;
    border-radius: 14px;
    border: 1px solid rgba(0, 0, 0, .06);
    transition: border-color .2s ease, transform .2s ease, box-shadow .2s ease;
    position: relative;

    &::after {
      content: '→';
      position: absolute;
      top: 50%;
      right: 24px;
      transform: translateY(-50%);
      color: $ds-orange;
      font-size: 22px;
      transition: transform .2s ease;
    }
    &:hover {
      border-color: $ds-orange;
      transform: translateY(-2px);
      box-shadow: 0 10px 26px rgba(0, 0, 0, .06);
      &::after { transform: translateY(-50%) translateX(4px); }
    }
  }
  .arr-services__label {
    font-family: $ds-font-noto;
    font-weight: 700;
    font-size: 17px;
    line-height: 1.25;
    padding-right: 32px;
  }
  .arr-services__sub {
    font-family: $ds-font-noto;
    font-weight: 300;
    font-size: 14px;
    color: $ds-ink;
  }

  @media (max-width: 720px) {
    .arr-intro-section { padding: 20px 20px 0; }
    .arr-intro { font-size: 16px; }
    .arr-listings-section { padding: 24px 20px 60px; }
    .arr-empty { padding: 40px 22px; h2 { font-size: 26px; } }
    .arr-services-section { padding: 50px 20px 70px; }
    .arr-services__list {
      grid-template-columns: 1fr;
      gap: 12px;
    }
    .arr-services__list a { padding: 18px 22px; }
  }
</style>
