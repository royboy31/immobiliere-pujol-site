---
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const slugify = (s: string): string =>
  s.toLowerCase()
    .normalize('NFD').replace(/[̀-ͯ]/g, '')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');

const articles = await getCollection('articles');

const tagMap = new Map<string, { name: string; count: number }>();
for (const a of articles) {
  for (const tag of (a.data.tags || []) as string[]) {
    const slug = slugify(tag);
    if (!tagMap.has(slug)) tagMap.set(slug, { name: tag, count: 0 });
    tagMap.get(slug)!.count++;
  }
}

const tags = [...tagMap.entries()]
  .map(([slug, { name, count }]) => ({ slug, name, count }))
  .sort((a, b) => a.name.localeCompare(b.name, 'fr'));
---

<BaseLayout
  title="Tags – Immobilière Pujol"
  description="Tous les tags du blog immobilier Marseille."
>
  <section class="seo-hero">
    <p class="seo-hero__eyebrow">Le blog Pujol</p>
    <h1>Tous <b>nos tags</b></h1>
    <p class="seo-hero__sub">
      Retrouvez nos articles par mot-clé : quartiers, types de biens, conseils, actualités et tendances du marché marseillais.
    </p>
    <span class="seo-hero__count">{tags.length} tag{tags.length > 1 ? 's' : ''}</span>
  </section>

  <section class="seo-archive">
    <h2 class="ds-sec-title">Naviguer <b>par mot-clé</b></h2>
    <ul class="seo-tax-grid seo-tax-grid--chips">
      {tags.map(t => (
        <li>
          <a href={`/tag/${t.slug}/`}>
            <span class="label">{t.name}</span>
            <span class="count">{t.count}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
