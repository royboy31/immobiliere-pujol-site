---
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const articles = await getCollection('articles');

  // Collect all unique tags across articles
  const tagMap = new Map<string, typeof articles>();
  for (const article of articles) {
    const tags = article.data.tags || [];
    for (const tag of tags) {
      const tagSlug = tag.toLowerCase()
        .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-|-$/g, '');
      if (!tagMap.has(tagSlug)) {
        tagMap.set(tagSlug, []);
      }
      tagMap.get(tagSlug)!.push(article);
    }
  }

  return Array.from(tagMap.entries()).map(([slug, articles]) => ({
    params: { slug },
    props: {
      tag: articles[0]?.data.tags?.find((t: string) =>
        t.toLowerCase()
          .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
          .replace(/[^a-z0-9]+/g, '-')
          .replace(/^-|-$/g, '') === slug
      ) || slug,
      articles: articles.sort((a, b) => {
        const da = a.data.date ? new Date(a.data.date).getTime() : 0;
        const db = b.data.date ? new Date(b.data.date).getTime() : 0;
        return db - da;
      }),
    },
  }));
}

interface Props {
  tag: string;
  articles: any[];
}

const { tag, articles } = Astro.props;
---

<BaseLayout
  title={`${tag} – Immobilière Pujol`}
  description={`Articles sur le thème : ${tag}`}
>
  <section class="seo-hero">
    <p class="seo-hero__eyebrow">Tag</p>
    <h1>{tag}</h1>
    <span class="seo-hero__count">{articles.length} article{articles.length > 1 ? 's' : ''}</span>
  </section>

  <section class="seo-archive seo-archive--paper">
    {articles.length === 0 ? (
      <p class="seo-empty">Aucun article associé à ce tag pour le moment.</p>
    ) : (
      <div class="seo-card-grid">
        {articles.map((article) => (
          <article class={`seo-card ${!article.data.featuredImage ? 'seo-card--text' : ''}`}>
            {article.data.featuredImage && (
              <a href={`/${article.data.slug}/`} class="seo-card__media">
                <img src={article.data.featuredImage} alt={article.data.title} loading="lazy" />
              </a>
            )}
            <div class="seo-card__body">
              <h2 class="seo-card__title">
                <a href={`/${article.data.slug}/`}>{article.data.title}</a>
              </h2>
              {article.data.excerpt && <p class="seo-card__excerpt">{article.data.excerpt}</p>}
              {article.data.date && (
                <time class="seo-card__date" datetime={article.data.date}>
                  {new Date(article.data.date).toLocaleDateString('fr-FR', {
                    year: 'numeric', month: 'long', day: 'numeric'
                  })}
                </time>
              )}
            </div>
          </article>
        ))}
      </div>
    )}
  </section>
</BaseLayout>
