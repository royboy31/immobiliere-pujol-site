---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';

const links = [
  { href: '/', label: 'Accueil' },
  { href: '/annonces/', label: 'Toutes les annonces' },
  { href: '/annonces/locations/', label: 'Locations', kind: 'loc' },
  { href: '/annonces/ventes/', label: 'Ventes', kind: 'vente' },
  { href: '/blog-immobilier-marseille/', label: 'Les conseils' },
  { href: '/contact-immobiliere-pujol/', label: 'Nous contacter' },
];
---

<BaseLayout
  title="Page introuvable – Immobilière Pujol"
  description="La page que vous recherchez n'existe pas ou a été déplacée."
  noindex={true}
  breadcrumb={false}
>
  <section class="seo-hero">
    <p class="seo-hero__eyebrow">Erreur 404</p>
    <h1>Cette page <b>n'existe plus</b></h1>
    <p class="seo-hero__sub">
      La page que vous cherchez a été déplacée ou n'a jamais existé. Retrouvez nos contenus utiles ci-dessous.
    </p>
  </section>

  <section class="seo-archive">
    <h2 class="ds-sec-title">Continuer <b>la navigation</b></h2>
    <ul class="seo-tax-grid">
      {links.map(l => (
        <li>
          <a href={l.href}>
            <span class="label">{l.label}</span>
            <span class="count">→</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
