---
// TEST (10/11/2026): contact form of the gestion locative landing, shared by the layout proposal pages.
---
  <div class="svc-page mag-formwrap">
    {/* ============= CONTACT FORM ============= */}
    <section class="svc-form-wrap" id="form">
      <form
        class="svc-form"
        method="post"
        action="https://pujol-email.roy-68a.workers.dev/contact"
        enctype="multipart/form-data"
        novalidate
        data-ajax-form
      >
      <input type="text" name="_hp" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden" />
      <div class="cf-turnstile" data-sitekey="0x4AAAAAADow4gNbXgTPXvdL" data-appearance="interaction-only"></div>
        <h2>Vous souhaitez louer et <b>faire gérer</b></h2>
        <p class="svc-form__lead">
          Contactez-nous pour obtenir des réponses ou un devis. Nous prenons contact avec vous
          dans les 24 heures.
        </p>

        <div class="svc-form__grid">
          <label class="svc-field">
            <span>Prénom *</span>
            <input type="text" name="input_2.3" placeholder="Prénom" required />
          </label>

          <label class="svc-field">
            <span>Nom *</span>
            <input type="text" name="input_2.6" placeholder="Nom" required />
          </label>

          <label class="svc-field">
            <span>Téléphone *</span>
            <input type="tel" name="input_8" placeholder="Téléphone" required />
          </label>

          <label class="svc-field">
            <span>Email *</span>
            <input type="email" name="input_4" placeholder="Email" required />
          </label>

          <label class="svc-field svc-field--full">
            <span>Votre message *</span>
            <textarea name="input_3" rows="6" placeholder="Votre message" required></textarea>
          </label>
        </div>

        <label class="svc-form__agree">
          <input
            type="checkbox"
            name="input_5.1"
            value="J'accepte le traitement de mes données dans le cadre de ma demande"
            required
          />
          <span>J'accepte le traitement de mes données dans le cadre de ma demande *</span>
        </label>

        <p class="svc-form__legal">
          Dans le cadre de nos activités, nous traitons les données à caractère personnel de nos clients, prospects, salariés, dans le respect des règles posées par le Règlement général sur les données personnelles (RGPD) et par la loi n°78-17 du 6 janvier 1978 relative à l'informatique, aux fichiers et aux libertés. Vous pouvez accéder aux informations relatives aux traitements de vos données personnelles ainsi qu'à vos droits en consultant notre politique de traitements des données personnelles sur la page suivante&nbsp;: <a href="https://www.declarations-juridiques.fr/processing-policy/immobiliere-pujol_056808868" target="_blank" rel="noopener">https://www.declarations-juridiques.fr/processing-policy/immobiliere-pujol_056808868</a>. Vous pouvez vous opposer à ce que vos données soient utilisées par notre agence à des fins de prospection commerciale en contactant l'Immobilière Pujol au <a href="tel:0491373839">04&nbsp;91&nbsp;37&nbsp;38&nbsp;39</a> ou par mail&nbsp;: <a href="mailto:rgpd@immobiliere-pujol.fr">rgpd@immobiliere-pujol.fr</a>
        </p>

        {/* Honeypot — preserved from the legacy Gravity Forms markup. */}
        <div style="position:absolute;left:-10000px;top:auto;width:1px;height:1px;overflow:hidden" aria-hidden="true">
          <label>Instagram<input type="text" name="input_9" tabindex="-1" autocomplete="new-password" /></label>
        </div>
        <input type="hidden" name="gform_submit" value="1" />
        <input type="hidden" name="is_submit_1" value="1" />

        <button class="svc-form__submit" type="submit">
          <span>ENVOYER VOTRE DEMANDE</span>
          <svg width="18" height="14" viewBox="0 0 22 14" fill="none">
            <path d="M1 7 H20 M14 1 L20 7 L14 13" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
      </form>
    </section>
  </div>

  <script>
    document.querySelectorAll<HTMLFormElement>('[data-ajax-form]').forEach((form) => {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (!form.reportValidity()) return;
        const btn = form.querySelector<HTMLButtonElement>('.svc-form__submit');
        if (btn) { btn.disabled = true; btn.classList.add('is-submitting'); }
        try {
          const res = await fetch(form.action, { method: 'POST', body: new FormData(form) });
          const data = await res.json();
          if (data.ok) {
            try { ((window as any).dataLayer = (window as any).dataLayer || []).push({ event: 'form_submit', form_type: 'devis-gestion-locative' }); } catch (e) {}
            form.innerHTML = '<div class="svc-form__success"><h2>Merci !</h2><p>Votre message a bien été envoyé. Nous vous recontacterons dans les 24 heures.</p></div>';
          } else {
            showError(form, data.error || "Une erreur est survenue. Veuillez réessayer.");
            if (btn) { btn.disabled = false; btn.classList.remove('is-submitting'); }
          }
        } catch {
          showError(form, "Erreur de connexion. Veuillez réessayer.");
          if (btn) { btn.disabled = false; btn.classList.remove('is-submitting'); }
        }
      });
    });
    function showError(form: HTMLFormElement, msg: string) {
      let el = form.querySelector('.svc-form__error');
      if (!el) {
        el = document.createElement('p');
        el.className = 'svc-form__error';
        (el as HTMLElement).style.cssText = 'color:#c0392b;font-weight:600;margin-top:12px';
        form.querySelector('.svc-form__submit')?.insertAdjacentElement('beforebegin', el);
      }
      el.textContent = msg;
    }
  </script>
