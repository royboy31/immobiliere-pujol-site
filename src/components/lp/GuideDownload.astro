---
// Guides sent BY EMAIL against first name, last name, email and a mandatory consent box
// (Caroline 19/11/2026, 16:08-16:24). Each guide card carries its own always-visible form.
// The worker (/guide) refuses without the box, emails the guide, then records the consent with
// the guide's CRM tag and notifies Gaëlle. Consent wording must match GUIDE_CONSENT_TEXT in workers/email.
import type { Guide } from '../../lib/lp-proposition';
interface Props { guides: Guide[]; title?: string; id?: string; paper?: boolean }
const { guides, title = 'Nos guides à télécharger', id = 'guides', paper = true } = Astro.props;
const CONSENT = "J'accepte de recevoir gratuitement ce guide ainsi que d'autres conseils, ressources et informations sur la gestion locative de la part de l'Immobilière Pujol.";
---
<section class={`prop-section${paper ? ' prop-section--paper' : ''}`} id={id}>
  <div class="mag-wrap">
    <h2 class="mag-h2 prop-center">{title}</h2>
    <ul class="prop-guidedl">
      {guides.map((g) => (
        <li class="prop-guidedl__card" id={`guide-${g.id}`}>
          <img src={g.cover} alt={`Couverture du guide « ${g.title} »`} width="452" height="640" loading="lazy" />
          <div class="prop-guidedl__body">
            <h3 class="prop-guidedl__title">{g.title}</h3>
            <p>{g.sub}</p>
            <form class="prop-guidedl__form" method="post" action="https://pujol-email.roy-68a.workers.dev/guide" novalidate data-guide-form>
              <input type="text" name="_hp" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden" />
              <input type="hidden" name="guide" value={g.id} />
              <div class="cf-turnstile" data-sitekey="0x4AAAAAADow4gNbXgTPXvdL" data-appearance="interaction-only"></div>
              <div class="prop-guidedl__names">
                <label class="prop-guidedl__email"><span>Prénom</span><input type="text" name="prenom" required autocomplete="given-name" /></label>
                <label class="prop-guidedl__email"><span>Nom</span><input type="text" name="nom" required autocomplete="family-name" /></label>
              </div>
              <label class="prop-guidedl__email"><span>Email</span><input type="email" name="email" required autocomplete="email" placeholder="vous@exemple.fr" /></label>
              <label class="prop-guidedl__consent"><input type="checkbox" name="consent" value="1" required /> <span>{CONSENT}</span></label>
              <p class="prop-guidedl__legal">Votre adresse e-mail sera utilisée pour vous envoyer le guide demandé ainsi que nos prochains contenus et offres liés à la gestion locative. Vous pouvez vous désinscrire à tout moment en écrivant à <a href="mailto:rgpd@immobiliere-pujol.fr">rgpd@immobiliere-pujol.fr</a>. En savoir plus sur notre <a href="/politique-de-confidentialite/">Politique de confidentialité</a>.</p>
              <button type="submit" class="mag-btn">Recevoir le guide par email</button>
              <p class="prop-guidedl__msg" role="status"></p>
            </form>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-guide-form]').forEach((form) => {
    const msg = form.querySelector<HTMLElement>('.prop-guidedl__msg')!;
    const guide = form.querySelector<HTMLInputElement>('input[name="guide"]')!.value;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const field = (n: string) => form.querySelector<HTMLInputElement>(`input[name="${n}"]`)!;
      const email = field('email'), consent = field('consent');
      const prenom = field('prenom'), nom = field('nom');
      if (!prenom.value.trim() || !nom.value.trim()) { msg.textContent = 'Merci d’indiquer votre prénom et votre nom.'; (prenom.value.trim() ? nom : prenom).focus(); return; }
      if (!email.value.trim() || !email.checkValidity()) { msg.textContent = 'Merci d’indiquer votre adresse email.'; email.focus(); return; }
      if (!consent.checked) { msg.textContent = 'Merci de cocher la case pour recevoir le guide.'; consent.focus(); return; }
      const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
      btn.disabled = true; msg.textContent = 'Envoi…';
      try {
        const res = await fetch(form.action, { method: 'POST', body: new FormData(form) });
        const data = await res.json().catch(() => ({}));
        if (res.ok && data.ok) {
          try { ((window as any).dataLayer = (window as any).dataLayer || []).push({ event: 'guide_request', guide }); } catch {}
          msg.textContent = `Merci ${prenom.value.trim()} ! Le guide vient d’être envoyé à ${email.value.trim()}. Pensez à regarder dans vos courriers indésirables s’il n’arrive pas.`;
          form.querySelectorAll('input, button').forEach((el) => ((el as HTMLInputElement).disabled = true));
          return;
        } else {
          msg.textContent = data.error || 'Une erreur est survenue. Veuillez réessayer.';
        }
      } catch {
        msg.textContent = 'Erreur de connexion. Veuillez réessayer.';
      }
      btn.disabled = false;
    });
  });
</script>
