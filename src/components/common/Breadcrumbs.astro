---
// Breadcrumb trail rendered above the page content. Two modes:
//   1. Auto: derive from current URL (legacy behavior for pages that don't care)
//   2. Custom: page passes `crumbs` prop to fully control the trail
// Always includes "Accueil" as the first item and a non-link last item for
// the current page (unless the page provides those explicitly in `crumbs`).

type Crumb = { label: string; href: string | null };

interface Props {
  pageTitle: string;
  pathname: string;
  /** Custom trail. When provided, REPLACES the auto-generated middle crumbs.
   *  Caller doesn't need to include "Accueil" or the final page-title crumb —
   *  this component prepends/appends them automatically. */
  crumbs?: Crumb[];
}

const { pageTitle, pathname, crumbs: customCrumbs } = Astro.props;

const segs = pathname.replace(/^\/|\/$/g, '').split('/').filter(Boolean);

// Pretty-print URL slugs into readable labels. Drops slug refs (long uuid-ish
// trailing IDs) and capitalizes first letters.
function prettifySegment(seg: string): string {
  return seg
    .replace(/-/g, ' ')
    .replace(/\b\w/g, (c) => c.toUpperCase());
}

const crumbs: Crumb[] = [{ label: 'Accueil', href: '/' }];

if (customCrumbs && customCrumbs.length > 0) {
  // Custom mode: page knows best what the trail should look like.
  for (const c of customCrumbs) crumbs.push(c);
} else {
  // Auto mode: derive intermediate crumbs from URL segments.
  let acc = '';
  for (let i = 0; i < segs.length - 1; i++) {
    acc += '/' + segs[i];
    crumbs.push({ label: prettifySegment(segs[i]), href: acc + '/' });
  }
}

// Final crumb is the current page (no link), unless the caller already
// provided one with href === null at the end.
const lastIsCurrent = crumbs.length > 1 && crumbs[crumbs.length - 1].href === null;
if (!lastIsCurrent) {
  const lastLabel = segs.length > 0 ? pageTitle : '';
  if (lastLabel) crumbs.push({ label: lastLabel, href: null });
}

const showTrail = segs.length > 0;
---

{showTrail && (
  <nav class="breadcrumbs" aria-label="Fil d'Ariane">
    <ol class="breadcrumbs__list">
      {crumbs.map((c, i) => (
        <li class="breadcrumbs__item">
          {c.href ? (
            <a href={c.href} class="breadcrumbs__link">{c.label}</a>
          ) : (
            <span class="breadcrumbs__current" aria-current="page">{c.label}</span>
          )}
          {i < crumbs.length - 1 && (
            <span class="breadcrumbs__sep" aria-hidden="true">›</span>
          )}
        </li>
      ))}
    </ol>
  </nav>
)}
