---
interface Props {
  reference: string;
  titre: string;
  contactEmail?: string | null;
  type: 'V' | 'L' | string;
  codePostal?: string | null;
  negociateur?: string | null;
}

const { reference, titre, contactEmail, type, codePostal, negociateur } = Astro.props;
const isLocation = type === 'L';
---

<form class="annonce-contact" data-annonce-contact-form
      data-contact-email={contactEmail || ''}
      data-contact-ref={reference}
      data-contact-title={titre}>
  <input type="hidden" name="reference" value={reference} />
  <input type="hidden" name="title" value={titre} />
  <input type="hidden" name="type" value={type} />
  <input type="hidden" name="code_postal" value={codePostal || ''} />
  <input type="hidden" name="negociateur" value={negociateur || 'Immobilière Pujol'} />
  <h3 class="annonce-contact__title">Laissez-nous vos <b>coordonnées</b></h3>
  <p class="annonce-contact__sub">
    Pour organiser une visite ou recevoir plus d'informations sur cette annonce.
  </p>

  <label class="annonce-contact__field">
    <span class="lbl">Prénom Nom</span>
    <input type="text" name="name" autocomplete="name" required />
  </label>

  <label class="annonce-contact__field">
    <span class="lbl">Email</span>
    <input type="email" name="email" autocomplete="email" required />
  </label>

  <label class="annonce-contact__field">
    <span class="lbl">Téléphone</span>
    <input type="tel" name="phone" autocomplete="tel" required />
  </label>

  <label class="annonce-contact__field">
    <span class="lbl">Votre message</span>
    <textarea name="message" rows="3" required>Bonjour, je suis intéressé(e) par l'annonce {reference}. Pouvez-vous me recontacter ?</textarea>
  </label>

  <label class="annonce-contact__agree">
    <input type="checkbox" name="agree" required />
    <span>J'accepte que mes données soient utilisées pour traiter ma demande. Voir notre <a href="/politique-de-confidentialite/">politique de confidentialité</a>.</span>
  </label>

  <p class="annonce-contact__legal">
    Dans le cadre de nos activités, nous traitons les données à caractère personnel de nos clients, prospects, salariés, dans le respect des règles posées par le Règlement général sur les données personnelles (RGPD) et par la loi n°78-17 du 6 janvier 1978 relative à l'informatique, aux fichiers et aux libertés. Vous pouvez accéder aux informations relatives aux traitements de vos données personnelles ainsi qu'à vos droits en consultant notre politique de traitements des données personnelles sur la page suivante&nbsp;: <a href="https://www.declarations-juridiques.fr/processing-policy/immobiliere-pujol_056808868" target="_blank" rel="noopener">https://www.declarations-juridiques.fr/processing-policy/immobiliere-pujol_056808868</a>. Vous pouvez vous opposer à ce que vos données soient utilisées par notre agence à des fins de prospection commerciale en contactant l'Immobilière Pujol au <a href="tel:0762203313">07&nbsp;62&nbsp;20&nbsp;33&nbsp;13</a> ou par mail&nbsp;: <a href="mailto:rgpd@immobiliere-pujol.fr">rgpd@immobiliere-pujol.fr</a>
  </p>

  <button type="submit" class={`btn-pill ${isLocation ? 'btn-pill--olive' : 'btn-pill--orange'} annonce-contact__submit`}>
    ENVOYER MA DEMANDE
  </button>

  <p class="annonce-contact__ref">Référence : {reference}</p>
</form>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-annonce-contact-form]').forEach((form) => {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      // The RGPD consent box is the most-missed required field; its native
      // validation bubble is easy to overlook (feels like "nothing happened,
      // had to click twice"). Surface a clear message + scroll to it.
      const agree = form.querySelector<HTMLInputElement>('input[name="agree"]');
      if (agree && !agree.checked) {
        showErr(form, 'Veuillez cocher la case pour accepter le traitement de vos données.');
        agree.focus();
        agree.scrollIntoView({ block: 'center', behavior: 'smooth' });
        return;
      }
      if (!form.reportValidity()) return;

      const btn = form.querySelector<HTMLButtonElement>('.annonce-contact__submit');
      if (btn) { btn.disabled = true; btn.style.opacity = '0.6'; }

      try {
        const res = await fetch('https://pujol-email.roy-68a.workers.dev/contact-annonce', { method: 'POST', body: new FormData(form) });
        const data = await res.json();
        if (data.ok) {
          try { ((window as any).dataLayer = (window as any).dataLayer || []).push({ event: 'form_submit', form_type: 'contact-annonce' }); } catch (e) {}
          form.innerHTML = '<div class="annonce-contact__success" style="text-align:center;padding:24px"><h3>Merci !</h3><p>Votre demande a bien été envoyée. Nous vous recontacterons rapidement.</p></div>';
        } else {
          showErr(form, data.error || "Une erreur est survenue.");
          if (btn) { btn.disabled = false; btn.style.opacity = ''; }
        }
      } catch {
        showErr(form, "Erreur de connexion. Veuillez réessayer.");
        if (btn) { btn.disabled = false; btn.style.opacity = ''; }
      }
    });
  });

  function showErr(form: HTMLFormElement, msg: string) {
    let el = form.querySelector('.annonce-contact__error');
    if (!el) {
      el = document.createElement('p');
      el.className = 'annonce-contact__error';
      (el as HTMLElement).style.cssText = 'color:#c0392b;font-weight:600;margin-top:8px;text-align:center';
      form.querySelector('.annonce-contact__submit')?.insertAdjacentElement('beforebegin', el);
    }
    el.textContent = msg;
  }
</script>
