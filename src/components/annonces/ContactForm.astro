---
interface Props {
  reference: string;
  titre: string;
  contactEmail?: string | null;
  type: 'V' | 'L' | string;
}

const { reference, titre, contactEmail, type } = Astro.props;
const isLocation = type === 'L';
---

<form class="annonce-contact" data-annonce-contact-form
      data-contact-email={contactEmail || ''}
      data-contact-ref={reference}
      data-contact-title={titre}>
  <input type="hidden" name="reference" value={reference} />
  <input type="hidden" name="title" value={titre} />
  <h3 class="annonce-contact__title">Laissez-nous vos <b>coordonnées</b></h3>
  <p class="annonce-contact__sub">
    Pour organiser une visite ou recevoir plus d'informations sur cette annonce.
  </p>

  <label class="annonce-contact__field">
    <span class="lbl">Prénom Nom</span>
    <input type="text" name="name" autocomplete="name" required />
  </label>

  <label class="annonce-contact__field">
    <span class="lbl">Email</span>
    <input type="email" name="email" autocomplete="email" required />
  </label>

  <label class="annonce-contact__field">
    <span class="lbl">Téléphone</span>
    <input type="tel" name="phone" autocomplete="tel" required />
  </label>

  <label class="annonce-contact__field">
    <span class="lbl">Votre message</span>
    <textarea name="message" rows="3" required>Bonjour, je suis intéressé(e) par l'annonce {reference}. Pouvez-vous me recontacter ?</textarea>
  </label>

  <label class="annonce-contact__agree">
    <input type="checkbox" name="agree" required />
    <span>J'accepte que mes données soient utilisées pour traiter ma demande. Voir notre <a href="/politique-de-confidentialite/">politique de confidentialité</a>.</span>
  </label>

  <button type="submit" class={`btn-pill ${isLocation ? 'btn-pill--olive' : 'btn-pill--orange'} annonce-contact__submit`}>
    ENVOYER MA DEMANDE
  </button>

  <p class="annonce-contact__ref">Référence : {reference}</p>
</form>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-annonce-contact-form]').forEach((form) => {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form.reportValidity()) return;

      const btn = form.querySelector<HTMLButtonElement>('.annonce-contact__submit');
      if (btn) { btn.disabled = true; btn.style.opacity = '0.6'; }

      try {
        const res = await fetch('https://pujol-email.kamindudushmantha.workers.dev/contact-annonce', { method: 'POST', body: new FormData(form) });
        const data = await res.json();
        if (data.ok) {
          form.innerHTML = '<div class="annonce-contact__success" style="text-align:center;padding:24px"><h3>Merci !</h3><p>Votre demande a bien été envoyée. Nous vous recontacterons rapidement.</p></div>';
        } else {
          showErr(form, data.error || "Une erreur est survenue.");
          if (btn) { btn.disabled = false; btn.style.opacity = ''; }
        }
      } catch {
        showErr(form, "Erreur de connexion. Veuillez réessayer.");
        if (btn) { btn.disabled = false; btn.style.opacity = ''; }
      }
    });
  });

  function showErr(form: HTMLFormElement, msg: string) {
    let el = form.querySelector('.annonce-contact__error');
    if (!el) {
      el = document.createElement('p');
      el.className = 'annonce-contact__error';
      (el as HTMLElement).style.cssText = 'color:#c0392b;font-weight:600;margin-top:8px;text-align:center';
      form.querySelector('.annonce-contact__submit')?.insertAdjacentElement('beforebegin', el);
    }
    el.textContent = msg;
  }
</script>
