---
// Map block for listing detail pages. Uses the Google Maps `output=embed` URL
// (no API key needed for the basic embed). Falls back to an address-based query
// when coordinates are missing.

interface Props {
  adresse?: string | null;
  codePostal?: string | null;
  ville?: string | null;
  quartier?: string | null;
  latitude?: number | null;
  longitude?: number | null;
  /** "sidebar" trims the section padding so the map can sit inside the sticky right column. */
  variant?: 'section' | 'sidebar';
}

const {
  adresse,
  codePostal,
  ville,
  quartier,
  latitude,
  longitude,
  variant = 'section',
} = Astro.props;

const hasCoords = typeof latitude === 'number' && typeof longitude === 'number';
const addressLine = [adresse, codePostal, ville].filter(Boolean).join(', ').trim();
const displayLine = [adresse, [codePostal, ville].filter(Boolean).join(' ')]
  .filter(Boolean)
  .join(' – ');

// Show the map only when we have either coordinates or a recognizable address
// (street + city/CP). Bare quartier-only strings produce noisy map results.
const queryString = hasCoords
  ? `${latitude},${longitude}`
  : addressLine || (ville ? `${quartier ? quartier + ', ' : ''}${ville}` : '');

if (!queryString) return null;

const encoded = encodeURIComponent(queryString);
const embedSrc = `https://www.google.com/maps?q=${encoded}&output=embed`;
const externalHref = `https://maps.google.com/?q=${encoded}`;
---

<section class={`annonce-map annonce-map--${variant}`}>
  <div class="annonce-map__head">
    <h2 class="annonce-map__title">Localisation <b>du bien</b></h2>
    {displayLine && <p class="annonce-map__addr">{displayLine}</p>}
  </div>
  <div class="annonce-map__embed-wrap">
    <button
      type="button"
      class="annonce-map__facade"
      data-map-embed={embedSrc}
      data-map-title={`Localisation – ${displayLine || 'bien'}`}
      aria-label="Afficher la carte de localisation"
    >
      <svg width="40" height="40" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M12 21s7-6.3 7-11a7 7 0 1 0-14 0c0 4.7 7 11 7 11Z" stroke="currentColor" stroke-width="1.6" />
        <circle cx="12" cy="10" r="2.5" stroke="currentColor" stroke-width="1.6" />
      </svg>
      <span>Chargement de la carte…</span>
    </button>
  </div>
  <a class="annonce-map__cta" href={externalHref} target="_blank" rel="noopener">
    Ouvrir dans Google Maps
    <svg width="16" height="11" viewBox="0 0 22 14" fill="none" aria-hidden="true">
      <path d="M1 7 H20 M14 1 L20 7 L14 13" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </a>
</section>

<style>
  /* Placeholder shown until the map auto-loads (on scroll-near or ~5s after
     load). Keeps the heavy Google Maps embed off the critical render path.
     Same box as the iframe so there is no layout shift. */
  .annonce-map__facade {
    width: 100%;
    height: 100%;
    min-height: 240px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border: 0;
    cursor: pointer;
    color: #2f6b4f;
    background:
      repeating-linear-gradient(45deg, #eef2ef, #eef2ef 14px, #e7ece8 14px, #e7ece8 28px);
    font: inherit;
    font-weight: 600;
  }
  .annonce-map__facade:hover { background: #e3eae5; }
</style>

<script>
  // Auto-load the map without user interaction, but deferred so it stays off the
  // critical render path (keeps LCP/FCP fast). It loads on whichever happens
  // first: the map scrolls near the viewport, OR ~5s after the page finishes
  // loading. A click loads it instantly.
  document.querySelectorAll('[data-map-embed]').forEach((btn) => {
    let loaded = false;
    const load = () => {
      if (loaded || !btn.isConnected) return;
      loaded = true;
      const ifr = document.createElement('iframe');
      ifr.className = 'annonce-map__embed';
      ifr.src = btn.getAttribute('data-map-embed');
      ifr.title = btn.getAttribute('data-map-title') || 'Localisation du bien';
      ifr.loading = 'lazy';
      ifr.referrerPolicy = 'no-referrer-when-downgrade';
      ifr.allowFullscreen = true;
      btn.replaceWith(ifr);
    };

    btn.addEventListener('click', load, { once: true });

    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        if (entries.some((e) => e.isIntersecting)) { io.disconnect(); load(); }
      }, { rootMargin: '400px' });
      io.observe(btn);
    }

    const scheduleFallback = () => setTimeout(load, 5000);
    if (document.readyState === 'complete') scheduleFallback();
    else window.addEventListener('load', scheduleFallback, { once: true });
  });
</script>
