---
// Rotated internal-link block shown at the bottom of closed-annonce pages.
// Spreads link equity across the site (see src/lib/internal-links.ts).
import type { LinkItem } from '../../lib/internal-links';

interface Props {
  links: LinkItem[];
}

const { links = [] } = Astro.props;

const GROUPS: { type: string; title: string }[] = [
  { type: 'service', title: 'Nos services & conseils' },
  { type: 'article', title: 'À lire sur le marché immobilier marseillais' },
  { type: 'arrondissement', title: 'Annonces par arrondissement' },
];

const grouped = GROUPS
  .map((g) => ({ ...g, items: links.filter((l) => l.type === g.type) }))
  .filter((g) => g.items.length > 0);
---

{links.length > 0 && (
  <section class="closed-links" aria-label="Découvrez aussi">
    <h2 class="closed-links__title">Découvrez aussi <b>Immobilière Pujol</b></h2>
    <div class="closed-links__grid">
      {grouped.map((g) => (
        <div class="closed-links__col">
          <h3 class="closed-links__col-title">{g.title}</h3>
          <ul class="closed-links__list">
            {g.items.map((l) => (
              <li><a href={l.url}>{l.title}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>
)}

<style>
  .closed-links {
    margin: 40px 0 8px;
    padding: 28px 24px;
    background: #f6f7f5;
    border-radius: 14px;
  }
  .closed-links__title {
    font-size: 22px;
    margin: 0 0 20px;
    font-weight: 500;
  }
  .closed-links__title b { font-weight: 800; }
  .closed-links__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 24px 32px;
  }
  .closed-links__col-title {
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: #6b7280;
    margin: 0 0 10px;
  }
  .closed-links__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .closed-links__list li { margin: 0 0 8px; }
  .closed-links__list a {
    color: #1f3a2e;
    text-decoration: none;
    font-size: 15px;
    line-height: 1.35;
    border-bottom: 1px solid transparent;
  }
  .closed-links__list a:hover {
    color: #c45a16;
    border-bottom-color: currentColor;
  }
</style>
