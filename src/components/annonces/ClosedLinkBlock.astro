---
// Rotated internal-link block shown at the bottom of closed-annonce pages.
// Spreads link equity across the site (see src/lib/internal-links.ts).
import type { LinkItem } from '../../lib/internal-links';

interface Props {
  links: LinkItem[];
}

const { links = [] } = Astro.props;

const GROUPS: { type: string; title: string }[] = [
  { type: 'closed', title: 'Annonces clôturées' },
  { type: 'autre', title: 'Autres annonces' },
  { type: 'service', title: 'Nos services' },
  { type: 'article', title: 'Actualités & conseils' },
];

const grouped = GROUPS
  .map((g) => ({ ...g, items: links.filter((l) => l.type === g.type) }))
  .filter((g) => g.items.length > 0);
---

{links.length > 0 && (
  <section class="closed-links" aria-label="Continuez votre visite">
    <h2 class="closed-links__title">Continuez votre visite chez <b>Immobilière Pujol</b></h2>
    <div class="closed-links__grid">
      {grouped.map((g) => (
        <div class="closed-links__col">
          <h3 class="closed-links__col-title">{g.title}</h3>
          <ul class:list={['closed-links__list', { 'closed-links__list--cards': g.items.some((l) => l.image) }]}>
            {g.items.map((l) => (
              <li>
                <a href={l.url}>
                  {l.image && (
                    <span class="closed-links__thumb">
                      <img src={l.image} alt="" loading="lazy" width="56" height="56" />
                    </span>
                  )}
                  <span class="closed-links__label">{l.title}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>
)}
