---
// Injects a promo "encart" card into the listings grid, in the middle column of
// every 3rd row (grid cells 8, 17, 26 …) among the VISIBLE cards. Re-placed when
// the deferred cards load and when filters change.
// variant: 'vente' (orange) or 'location' (green).
interface Props {
  variant?: 'vente' | 'location';
}
const { variant = 'vente' } = Astro.props;

const cfg = variant === 'location'
  ? {
      cls: 'listing-cta--location',
      title: 'Vous avez un bien à louer et à faire gérer ?',
      sub: 'Faites estimer votre loyer par nos spécialistes de la gestion locative à Marseille.',
      btn: 'FAIRE ESTIMER MON LOYER',
      href: '/service-immobilier/mettre-en-location/#form',
    }
  : {
      cls: 'listing-cta--vente',
      title: 'Vous avez un bien à vendre ?',
      sub: "Faites estimer votre bien par nos spécialistes de l'immobilier à Marseille.",
      btn: 'FAIRE ESTIMER MON BIEN',
      href: '/estimez-le-prix-de-vente-de-votre-bien-en-2mn/',
    };
---

<template id="listingCtaTpl">
  <article class={`listing-cta ${cfg.cls}`} data-listing-cta>
    <div class="listing-cta__inner">
      <span class="listing-cta__rule"></span>
      <h3 class="listing-cta__title">{cfg.title}</h3>
      <p class="listing-cta__sub">{cfg.sub}</p>
      <a class="listing-cta__btn" href={cfg.href}>{cfg.btn}</a>
    </div>
  </article>
</template>

<script>
  (() => {
    const grid = document.getElementById('annonces-grid');
    const tpl = document.getElementById('listingCtaTpl');
    if (!grid || !(tpl instanceof HTMLTemplateElement)) return;

    const makeCta = () => tpl.content.firstElementChild.cloneNode(true);

    function placeCtas() {
      grid.querySelectorAll('[data-listing-cta]').forEach((n) => n.remove());
      const visible = Array.from(grid.children).filter(
        (c) => c.classList.contains('annonce-card-item') && !c.classList.contains('is-hidden')
      );
      if (visible.length >= 8) {
        // First CTA before the 8th visible card, then every 8 cells.
        for (let k = 7; k < visible.length; k += 8) {
          grid.insertBefore(makeCta(), visible[k]);
        }
      } else if (visible.length > 0) {
        // Short list (e.g. a single arrondissement like Nice / 13006): still show
        // one encart, placed higher — mid 2nd row when possible, else after the cards.
        const at = Math.min(4, visible.length);
        grid.insertBefore(makeCta(), visible[at] || null);
      }
    }

    let scheduled = false;
    function schedule() {
      if (scheduled) return;
      scheduled = true;
      requestAnimationFrame(() => { scheduled = false; placeCtas(); });
    }

    schedule();
    document.addEventListener('annonces:cards-loaded', schedule);
    const form = document.getElementById('annoncesFilter');
    if (form) {
      form.addEventListener('change', schedule);
      form.addEventListener('input', schedule);
      form.addEventListener('reset', () => setTimeout(schedule, 0));
    }
  })();
</script>

<style is:global>
  .listing-cta {
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    min-height: 440px;
    padding: 32px 26px;
  }
  .listing-cta__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    max-width: 320px;
  }
  .listing-cta__rule { width: 40px; height: 3px; border-radius: 2px; }
  .listing-cta__title { font-size: 26px; line-height: 1.2; margin: 0; text-transform: uppercase; letter-spacing: .5px; }
  .listing-cta__sub { margin: 0; font-size: 15px; line-height: 1.5; }
  .listing-cta__btn {
    display: inline-block;
    margin-top: 6px;
    padding: 14px 26px;
    border-radius: 999px;
    text-decoration: none;
    font-weight: 700;
    font-size: 13px;
    letter-spacing: .5px;
    transition: background .2s, color .2s, border-color .2s;
  }

  /* Ventes — orange */
  .listing-cta--vente { background: #EC7234; color: #fff; }
  .listing-cta--vente .listing-cta__rule { background: #fff; }
  .listing-cta--vente .listing-cta__title { color: #fff; }
  .listing-cta--vente .listing-cta__sub { color: rgba(255,255,255,.92); }
  .listing-cta--vente .listing-cta__btn { border: 1px solid rgba(255,255,255,.9); color: #fff; }
  .listing-cta--vente .listing-cta__btn:hover { background: #fff; border-color: #fff; color: #c85a1f; }

  /* Locations — vert */
  .listing-cta--location { background: #B2C54F; color: #16240a; }
  .listing-cta--location .listing-cta__rule { background: #0f1a2b; }
  .listing-cta--location .listing-cta__title { color: #16240a; }
  .listing-cta--location .listing-cta__sub { color: #253516; }
  .listing-cta--location .listing-cta__btn { border: 1px solid #0f1a2b; color: #0f1a2b; }
  .listing-cta--location .listing-cta__btn:hover { background: #0f1a2b; border-color: #0f1a2b; color: #fff; }
</style>
