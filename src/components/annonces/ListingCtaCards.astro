---
// Injects a promo "encart" card into the listings grid, in the middle column of
// every 3rd row (grid cells 8, 17, 26 …) among the VISIBLE cards. Re-placed when
// the deferred cards load and when filters change. Prototype: one CTA for now.
---

<template id="listingCtaTpl">
  <article class="listing-cta" data-listing-cta>
    <div class="listing-cta__inner">
      <span class="listing-cta__rule"></span>
      <h3 class="listing-cta__title">Vous avez un bien à vendre ?</h3>
      <p class="listing-cta__sub">Faites estimer votre bien par nos spécialistes de l'immobilier à Marseille.</p>
      <a class="listing-cta__btn" href="/estimez-le-prix-de-vente-de-votre-bien-en-2mn/">FAIRE ESTIMER MON BIEN</a>
    </div>
  </article>
</template>

<script>
  (() => {
    const grid = document.getElementById('annonces-grid');
    const tpl = document.getElementById('listingCtaTpl');
    if (!grid || !(tpl instanceof HTMLTemplateElement)) return;

    const makeCta = () => tpl.content.firstElementChild.cloneNode(true);

    function placeCtas() {
      grid.querySelectorAll('[data-listing-cta]').forEach((n) => n.remove());
      const visible = Array.from(grid.children).filter(
        (c) => c.classList.contains('annonce-card-item') && !c.classList.contains('is-hidden')
      );
      // First CTA at grid cell 8 (before the 8th visible card), then every 9 cells.
      for (let k = 7; k < visible.length; k += 8) {
        grid.insertBefore(makeCta(), visible[k]);
      }
    }

    let scheduled = false;
    function schedule() {
      if (scheduled) return;
      scheduled = true;
      requestAnimationFrame(() => { scheduled = false; placeCtas(); });
    }

    schedule();
    // Deferred cards appended (and FilterBar re-filters on the same event).
    document.addEventListener('annonces:cards-loaded', schedule);
    // Re-place after the filter bar toggles .is-hidden.
    const form = document.getElementById('annoncesFilter');
    if (form) {
      form.addEventListener('change', schedule);
      form.addEventListener('input', schedule);
      form.addEventListener('reset', () => setTimeout(schedule, 0));
    }
  })();
</script>

<style is:global>
  .listing-cta {
    background: #0f1a2b;
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    min-height: 440px;
    padding: 32px 26px;
    color: #fff;
  }
  .listing-cta__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    max-width: 320px;
  }
  .listing-cta__rule { width: 40px; height: 3px; background: #B2C54F; border-radius: 2px; }
  .listing-cta__title {
    color: #fff;
    font-size: 26px;
    line-height: 1.2;
    margin: 0;
    text-transform: uppercase;
    letter-spacing: .5px;
  }
  .listing-cta__sub { color: rgba(255,255,255,.8); margin: 0; font-size: 15px; line-height: 1.5; }
  .listing-cta__btn {
    display: inline-block;
    margin-top: 6px;
    padding: 14px 26px;
    border: 1px solid rgba(255,255,255,.9);
    border-radius: 999px;
    color: #fff;
    text-decoration: none;
    font-weight: 700;
    font-size: 13px;
    letter-spacing: .5px;
    transition: background .2s, color .2s, border-color .2s;
  }
  .listing-cta__btn:hover { background: #B2C54F; border-color: #B2C54F; color: #16240a; }
</style>
