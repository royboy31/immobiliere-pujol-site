---
interface Props {
  href: string;
  reference: string;
}

const { href, reference } = Astro.props;
---

<section class="seventee-application" aria-labelledby="seventee-application-title">
  <h2 id="seventee-application-title" class="seventee-application__title">
    Ce bien vous intéresse ?
  </h2>
  <p class="seventee-application__copy">
    Pour organiser une visite, merci de <strong>créer votre dossier de candidature</strong> sur la
    plateforme <strong><u>Seventee</u></strong>, notre partenaire.
  </p>
  <p class="seventee-application__copy">
    Cliquez sur le bouton ci-dessous pour accéder à l'annonce, créer votre compte,
    soumettre votre candidature et suivre son état en temps réel.
  </p>
  <a
    class="btn-pill btn-pill--olive seventee-application__button"
    href={href}
    target="_blank"
    rel="noopener"
    data-seventee-application
    data-seventee-reference={reference}
  >
    Déposer ma candidature
  </a>
  <p class="seventee-application__ref">Référence : {reference}</p>
</section>

<script>
  document.querySelectorAll<HTMLAnchorElement>('[data-seventee-application]').forEach((link) => {
    link.addEventListener('click', () => {
      try {
        ((window as any).dataLayer = (window as any).dataLayer || []).push({
          event: 'seventee_application_click',
          listing_reference: link.dataset.seventeeReference || '',
          destination_url: link.href,
        });
      } catch {}
    });
  });
</script>

<style>
  .seventee-application {
    padding: 28px;
    border: 1px solid rgba(15, 26, 43, .1);
    border-radius: 4px;
    background: #fff;
    box-shadow: 0 8px 28px rgba(15, 26, 43, .08);
  }
  .seventee-application__title {
    margin: 0 0 18px;
    color: var(--pj-navy, #0f1a2b);
    font-size: clamp(1.3rem, 2vw, 1.65rem);
    line-height: 1.2;
  }
  .seventee-application__button {
    display: flex;
    width: 100%;
    min-height: 50px;
    align-items: center;
    justify-content: center;
    padding: 12px 18px;
    margin-top: 24px;
    text-align: center;
    text-decoration: none;
  }
  .seventee-application__button:focus-visible {
    outline: 3px solid rgba(178, 197, 79, .45);
    outline-offset: 3px;
  }
  .seventee-application__copy {
    margin: 16px 0 0;
    color: #4b5563;
    font-size: .95rem;
    line-height: 1.6;
  }
  .seventee-application__copy + .seventee-application__copy {
    margin-top: 8px;
  }
  .seventee-application__ref {
    margin: 18px 0 0;
    color: #6b7280;
    font-size: .82rem;
    text-align: center;
  }
  @media (max-width: 640px) {
    .seventee-application {
      padding: 22px 18px;
    }
  }
</style>
