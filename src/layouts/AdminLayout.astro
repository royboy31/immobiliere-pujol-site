---
import { getAdminEnv, getAdminPath } from '../lib/admin-auth';
import { getDB, ensureSchema, getOrCreateUser, defaultName, isSuperAdmin } from '../lib/admin-users';
import PublishBar from '../components/admin/PublishBar.astro';

interface Props {
  title: string;
  section?: 'experts' | 'articles' | 'pages' | 'home' | 'newsletter' | 'alertes' | 'users';
  hideSidebar?: boolean;
}

const { title, section = 'home', hideSidebar = false } = Astro.props;
const env = await getAdminEnv();
const adminPath = getAdminPath(env);
const base = `/${adminPath}`;
const adminEmail = (Astro.locals as any).adminEmail ?? '';

// Profile for the sidebar account menu. Rendered server-side so the name is
// there on first paint; if D1 is unavailable the menu still works (logout is a
// plain form post) and just falls back to a name derived from the email.
let adminName = adminEmail ? defaultName(adminEmail) : '';
let hasOwnPassword = false;
let isSuper = false;
if (adminEmail && !hideSidebar) {
  try {
    const db = await getDB();
    await ensureSchema(db);
    const user = await getOrCreateUser(db, adminEmail);
    adminName = user.name;
    hasOwnPassword = !!user.password_hash;
    isSuper = await isSuperAdmin(env, adminEmail);
  } catch {
    // D1 unavailable — keep the email-derived fallback.
  }
}

/** "Roy Boy" -> "RB"; falls back to the first email character. */
const initials = (adminName || adminEmail || '?')
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((w) => w.charAt(0).toUpperCase())
  .join('') || '?';
---

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>{title} – Admin Pujol</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Noto+Sans:wght@300;400;500;600;700&display=swap"
    rel="stylesheet"
  />
  <!-- Global (not scoped): this is the admin design system. Child pages render
       into <slot/>, so scoped layout styles would never reach their .btn/.card/
       input markup. is:global makes .btn, .card, inputs, tables, etc. apply
       across every admin page. Page-level <style> blocks stay scoped and win. -->
  <style is:global>
    :root {
      --pj-olive: rgb(178, 192, 78);
      --pj-olive-2: rgb(166, 179, 82);
      --pj-orange: rgb(236, 114, 52);
      --pj-paper: rgb(238, 243, 239);
      --pj-ink: rgb(58, 58, 58);
      --pj-hairline: rgba(0, 0, 0, .1);
      --pj-slate: rgb(86, 103, 112);
      --pj-helv: "Helvetica Neue", "HelveticaNeue", Helvetica, Inter, sans-serif;
      --pj-noto: "Noto Sans", sans-serif;
      --danger: #dc2626;
      --body-bg: #fafafa;
    }
    * { box-sizing: border-box; }
    html, body {
      margin: 0; padding: 0;
      background: var(--body-bg);
      font-family: var(--pj-noto);
      font-weight: 300;
      color: #000;
      -webkit-font-smoothing: antialiased;
    }
    a { color: var(--pj-olive-2); text-decoration: none; }
    a:hover { color: var(--pj-orange); text-decoration: none; }
    button { font: inherit; cursor: pointer; }

    .admin-shell { display: flex; min-height: 100vh; }

    .admin-sidebar {
      width: 260px; flex-shrink: 0;
      background: var(--pj-slate);
      color: #fff;
      display: flex; flex-direction: column;
    }
    .admin-sidebar__brand {
      padding: 22px 24px;
      font-family: var(--pj-helv);
      font-weight: 300;
      font-size: 18px;
      letter-spacing: .2px;
      border-bottom: 1px solid rgba(255,255,255,0.1);
      b { font-weight: 700; }
    }
    .admin-sidebar__nav {
      flex: 1; padding: 18px 14px;
      display: flex; flex-direction: column; gap: 4px;
    }
    .admin-sidebar__nav a {
      color: rgba(255, 255, 255, .72);
      padding: 11px 16px;
      border-radius: 999px;
      font-family: var(--pj-noto);
      font-weight: 500;
      font-size: 13px;
      letter-spacing: .3px;
      display: flex; align-items: center; gap: 8px;
      transition: background .2s, color .2s;
    }
    .admin-sidebar__nav a:hover {
      color: #fff;
      background: rgba(255, 255, 255, .08);
    }
    .admin-sidebar__nav a.is-active {
      color: #000;
      background: var(--pj-olive);
      font-weight: 700;
    }
    .admin-sidebar__nav span.count { margin-left: auto; opacity: .7; font-size: 11px; }
    /* Account menu, pinned to the sidebar bottom. The panel opens upward. */
    .admin-sidebar__user {
      position: relative;
      padding: 12px;
      border-top: 1px solid rgba(255,255,255,0.1);
      font-size: 12px;
    }
    .admin-sidebar__user form { margin: 0; }

    .admin-user__trigger {
      display: flex; align-items: center; gap: 10px;
      width: 100%;
      padding: 8px;
      background: transparent;
      border: 1px solid transparent;
      border-radius: 12px;
      cursor: pointer;
      text-align: left;
      font-family: var(--pj-noto);
      transition: background .2s, border-color .2s;
    }
    .admin-user__trigger:hover,
    .admin-user__trigger[aria-expanded="true"] {
      background: rgba(255,255,255,.08);
      border-color: rgba(255,255,255,.18);
    }
    .admin-user__avatar {
      flex: none;
      width: 32px; height: 32px;
      display: grid; place-items: center;
      border-radius: 50%;
      background: var(--pj-olive);
      color: #2b3110;
      font-weight: 700; font-size: 12px; letter-spacing: .5px;
    }
    .admin-user__id { min-width: 0; display: flex; flex-direction: column; line-height: 1.3; }
    .admin-user__name {
      color: #fff; font-weight: 600; font-size: 13px;
      overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }
    .admin-user__email {
      color: rgba(255,255,255,.55); font-size: 11px;
      overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }
    .admin-user__chevron {
      margin-left: auto; color: rgba(255,255,255,.5); font-size: 10px;
      transition: transform .2s ease;
    }
    .admin-user__trigger[aria-expanded="true"] .admin-user__chevron { transform: rotate(180deg); }

    .admin-user__panel {
      position: absolute;
      left: 12px; right: 12px; bottom: calc(100% - 6px);
      background: #fff;
      border-radius: 14px;
      box-shadow: 0 14px 40px rgba(0,0,0,.35);
      padding: 6px;
      z-index: 50;
      max-height: 70vh; overflow-y: auto;
    }
    .admin-user__head { padding: 10px 10px 12px; border-bottom: 1px solid var(--pj-hairline); }
    .admin-user__head-name { display: block; font-weight: 700; color: #000; font-size: 13px; }
    .admin-user__head-email {
      display: block; color: #8a8a8a; font-size: 11px; margin-top: 2px;
      overflow: hidden; text-overflow: ellipsis;
    }

    .admin-user__section { border-bottom: 1px solid var(--pj-hairline); }
    .admin-user__section summary {
      list-style: none; cursor: pointer;
      padding: 11px 10px;
      font-size: 12.5px; font-weight: 600; color: var(--pj-ink);
      border-radius: 8px;
    }
    .admin-user__section summary::-webkit-details-marker { display: none; }
    .admin-user__section summary::after { content: '›'; float: right; color: #b9bfc4; }
    .admin-user__section[open] summary::after { content: '⌄'; }
    .admin-user__section summary:hover { background: #f4f6ee; }

    .admin-user__hint { margin: 0 10px 8px; font-size: 11px; line-height: 1.45; color: #8a8a8a; }
    .admin-user__form { display: flex; flex-direction: column; gap: 6px; padding: 0 10px 12px; }
    .admin-user__form input { padding: 8px 10px; border-radius: 9px; font-size: 12.5px; }
    .admin-user__save {
      align-self: flex-start;
      background: var(--pj-olive); color: #2b3110;
      border: 0; border-radius: 999px;
      padding: 7px 15px; cursor: pointer;
      font-family: var(--pj-noto); font-weight: 700; font-size: 11px;
      letter-spacing: .4px; text-transform: uppercase;
    }
    .admin-user__save:hover { background: var(--pj-olive-2); }
    .admin-user__save:disabled { opacity: .55; cursor: default; }

    .admin-user__msg { margin: 8px 10px 0; font-size: 11.5px; line-height: 1.4; }
    .admin-user__msg.is-ok { color: #5c6a10; }
    .admin-user__msg.is-err { color: var(--danger); }

    .admin-user__logout { padding: 6px; }
    .admin-user__logout button {
      width: 100%;
      background: transparent; color: var(--danger);
      border: 1px solid var(--pj-hairline);
      padding: 9px 12px; border-radius: 999px; cursor: pointer;
      font-family: var(--pj-noto); font-weight: 700; font-size: 11px;
      letter-spacing: .6px; text-transform: uppercase;
      transition: background .2s, border-color .2s;
    }
    .admin-user__logout button:hover { background: rgba(199,58,42,.08); border-color: var(--danger); }

    .admin-main { flex: 1; min-width: 0; padding: 36px 44px; }
    h1 {
      margin: 0 0 28px;
      font-family: var(--pj-helv);
      font-weight: 300;
      font-size: 36px;
      line-height: 1.05;
      color: #000;
      letter-spacing: -.2px;
    }
    h1 b { font-weight: 700; }
    h2 {
      margin: 32px 0 14px;
      font-family: var(--pj-helv);
      font-weight: 300;
      font-size: 22px;
      color: #000;
    }
    h2 b { font-weight: 700; }

    .card {
      background: #fff;
      border: 1px solid var(--pj-hairline);
      border-radius: 18px;
      padding: 22px 24px;
      box-shadow: 0 4px 14px rgba(0, 0, 0, .04);
      transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease;
    }
    a.card:hover {
      transform: translateY(-2px);
      border-color: var(--pj-olive);
      box-shadow: 0 12px 32px rgba(0, 0, 0, .08);
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 11px 20px;
      border-radius: 999px;
      border: 1px solid transparent;
      font-family: var(--pj-noto);
      font-weight: 700;
      font-size: 12px;
      letter-spacing: .5px;
      text-transform: uppercase;
      cursor: pointer;
      white-space: nowrap;
      transition: background-color .2s ease, color .2s ease, border-color .2s ease, box-shadow .2s ease, transform .12s ease;
    }
    .btn:active { transform: translateY(1px); }
    .btn:focus-visible { outline: 2px solid var(--pj-olive); outline-offset: 2px; }
    /* Solid olive pill — the primary action across the admin (matches login). */
    .btn--primary {
      color: #000;
      background-color: var(--pj-olive);
      border-color: var(--pj-olive);
      box-shadow: 0 6px 16px rgba(178, 192, 78, .32);
    }
    .btn--primary:hover {
      background-color: var(--pj-olive-2);
      color: #000;
      box-shadow: 0 8px 22px rgba(178, 192, 78, .45);
      transform: translateY(-1px);
      text-decoration: none;
    }
    .btn--primary:active { transform: translateY(0); box-shadow: 0 4px 12px rgba(178, 192, 78, .35); }
    .btn--ghost {
      background: #fff; color: var(--pj-ink);
      border-color: var(--pj-hairline);
    }
    .btn--ghost:hover { background: var(--pj-paper); border-color: rgba(0,0,0,.2); color: #000; }
    .btn--danger { background: #fff; color: var(--danger); border-color: rgba(220,38,38,.4); }
    .btn--danger:hover { background: var(--danger); color: #fff; border-color: var(--danger); }
    .btn--sm { padding: 7px 13px; font-size: 10.5px; }

    input[type=text], input[type=email], input[type=password], input[type=url], input[type=number], textarea, select {
      display: block; width: 100%;
      padding: 11px 14px;
      border: 1px solid var(--pj-hairline);
      border-radius: 12px;
      font: inherit;
      font-family: var(--pj-noto);
      font-weight: 400;
      color: #000;
      background: #fbfcf8;
      transition: border-color .2s ease, box-shadow .2s ease, background-color .2s ease;
    }
    input[type=text]:hover, input[type=email]:hover, input[type=password]:hover,
    input[type=url]:hover, input[type=number]:hover, textarea:hover, select:hover { border-color: rgba(0,0,0,.2); }
    input[type=text]:focus, input[type=email]:focus, input[type=password]:focus,
    input[type=url]:focus, input[type=number]:focus, textarea:focus, select:focus {
      outline: none;
      background: #fff;
      border-color: var(--pj-olive);
      box-shadow: 0 0 0 3px rgba(178, 192, 78, .22);
    }
    input::placeholder, textarea::placeholder { color: #9aa2a6; }
    textarea {
      min-height: 160px;
      font-family: ui-monospace, "SF Mono", Menlo, monospace;
      font-size: 14px;
      line-height: 1.55;
    }
    label {
      display: block;
      margin-bottom: 16px;
      font-family: var(--pj-noto);
      font-weight: 700;
      font-size: 12px;
      letter-spacing: .4px;
      text-transform: uppercase;
      color: var(--pj-ink);
    }
    label input, label textarea {
      margin-top: 8px;
      font-weight: 400;
      letter-spacing: normal;
      text-transform: none;
      color: #000;
    }
    .toolbar { display: flex; gap: 10px; margin-bottom: 18px; align-items: center; }
    .toolbar .spacer { flex: 1; }
    .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 18px; }
  </style>
</head>
<body>
<div class="admin-shell">
  {!hideSidebar && (
    <aside class="admin-sidebar">
      <div class="admin-sidebar__brand">Immobilière <b>Pujol</b><br/><span style="font-size:12px;font-weight:700;letter-spacing:.8px;text-transform:uppercase;color:rgba(255,255,255,.55);">Espace admin</span></div>
      <nav class="admin-sidebar__nav">
        <a href={`${base}/`} class:list={[{ 'is-active': section === 'home' }]}>Tableau de bord</a>
        <a href={`${base}/experts/`} class:list={[{ 'is-active': section === 'experts' }]}>Experts</a>
        <a href={`${base}/articles/`} class:list={[{ 'is-active': section === 'articles' }]}>Articles de blog</a>
        <a href={`${base}/newsletter/`} class:list={[{ 'is-active': section === 'newsletter' }]}>Newsletters</a>
        <a href={`${base}/alertes/`} class:list={[{ 'is-active': section === 'alertes' }]}>Alertes</a>
        <a href={`${base}/pages/`} class:list={[{ 'is-active': section === 'pages' }]}>Pages légales</a>
        {isSuper && <a href={`${base}/users/`} class:list={[{ 'is-active': section === 'users' }]}>Utilisateurs</a>}
      </nav>
      <div class="admin-sidebar__user" id="admin-user"
           data-profile-url={`/api/${adminPath}/auth/profile/`}
           data-password-url={`/api/${adminPath}/auth/password/`}>
        <div class="admin-user__panel" id="admin-user-panel" hidden>
          <div class="admin-user__head">
            <span class="admin-user__head-name" id="admin-user-panel-name">{adminName || 'anonyme'}</span>
            <span class="admin-user__head-email">{adminEmail || 'anonyme'}</span>
          </div>

          <div class="admin-user__msg" id="admin-user-msg" hidden></div>

          <details class="admin-user__section">
            <summary>Modifier le nom</summary>
            <form class="admin-user__form" id="admin-name-form">
              <input type="text" id="admin-name-input" value={adminName} maxlength="60"
                     autocomplete="name" aria-label="Votre nom" placeholder="Votre nom" />
              <button type="submit" class="admin-user__save">Enregistrer</button>
            </form>
          </details>

          <details class="admin-user__section">
            <summary>Changer le mot de passe</summary>
            {!hasOwnPassword && (
              <p class="admin-user__hint">
                Vous utilisez encore le mot de passe partagé. En définir un vous donnera un mot de
                passe personnel ; celui des autres administrateurs ne changera pas.
              </p>
            )}
            <form class="admin-user__form" id="admin-pw-form">
              <input type="password" id="admin-pw-current" autocomplete="current-password"
                     aria-label="Mot de passe actuel" placeholder="Mot de passe actuel" />
              <input type="password" id="admin-pw-new" autocomplete="new-password"
                     aria-label="Nouveau mot de passe" placeholder="Nouveau mot de passe (10 car. min.)" />
              <button type="submit" class="admin-user__save">Changer</button>
            </form>
          </details>

          <form method="POST" action={`/api/${adminPath}/auth/logout/`} class="admin-user__logout">
            <button type="submit">Déconnexion</button>
          </form>
        </div>

        <button type="button" class="admin-user__trigger" id="admin-user-trigger"
                aria-haspopup="true" aria-expanded="false" aria-controls="admin-user-panel">
          <span class="admin-user__avatar" aria-hidden="true">{initials}</span>
          <span class="admin-user__id">
            <span class="admin-user__name" id="admin-user-name">{adminName || 'anonyme'}</span>
            <span class="admin-user__email">{adminEmail || 'anonyme'}</span>
          </span>
          <span class="admin-user__chevron" aria-hidden="true">▴</span>
        </button>
      </div>
    </aside>
  )}
  <main class="admin-main">
    {!hideSidebar && <PublishBar />}
    <slot />
  </main>
</div>

<script>
  const root = document.getElementById('admin-user');
  const trigger = document.getElementById('admin-user-trigger');
  const panel = document.getElementById('admin-user-panel');

  if (root && trigger && panel) {
    // Endpoints come from data attributes: this script is bundled, so it can't
    // read the layout's adminPath directly.
    const profileUrl = root.dataset.profileUrl || '';
    const passwordUrl = root.dataset.passwordUrl || '';

    const msg = document.getElementById('admin-user-msg');
    const nameForm = document.getElementById('admin-name-form') as HTMLFormElement | null;
    const nameInput = document.getElementById('admin-name-input') as HTMLInputElement | null;
    const pwForm = document.getElementById('admin-pw-form') as HTMLFormElement | null;
    const pwCurrent = document.getElementById('admin-pw-current') as HTMLInputElement | null;
    const pwNew = document.getElementById('admin-pw-new') as HTMLInputElement | null;

    function say(text: string, ok: boolean) {
      if (!msg) return;
      msg.textContent = text;
      msg.className = `admin-user__msg ${ok ? 'is-ok' : 'is-err'}`;
      msg.hidden = false;
    }
    function clearMsg() {
      if (msg) { msg.hidden = true; msg.textContent = ''; }
    }

    function setOpen(open: boolean) {
      panel!.hidden = !open;
      trigger!.setAttribute('aria-expanded', String(open));
      if (!open) clearMsg();
    }

    trigger.addEventListener('click', (e) => {
      e.stopPropagation();
      setOpen(panel.hidden);
    });
    // Clicks inside the panel must not reach the close-on-outside handler.
    panel.addEventListener('click', (e) => e.stopPropagation());
    document.addEventListener('click', () => { if (!panel.hidden) setOpen(false); });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel.hidden) { setOpen(false); trigger.focus(); }
    });

    async function post(url: string, body: unknown) {
      const res = await fetch(url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      });
      let data: any = {};
      try { data = await res.json(); } catch { /* non-JSON error page */ }
      return { ok: res.ok, data };
    }

    nameForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const name = (nameInput?.value || '').trim();
      if (!name) { say('Le nom ne peut pas être vide.', false); return; }

      const btn = nameForm.querySelector('button');
      if (btn) btn.disabled = true;
      const { ok, data } = await post(profileUrl, { name });
      if (btn) btn.disabled = false;

      if (!ok) { say(data.error || 'Échec de l’enregistrement.', false); return; }
      // Reflect the new name in both the trigger and the panel header.
      for (const id of ['admin-user-name', 'admin-user-panel-name']) {
        const el = document.getElementById(id);
        if (el) el.textContent = data.name;
      }
      say('Nom mis à jour.', true);
    });

    pwForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const current = pwCurrent?.value || '';
      const next = pwNew?.value || '';
      if (!current || !next) { say('Mot de passe actuel et nouveau requis.', false); return; }

      const btn = pwForm.querySelector('button');
      if (btn) btn.disabled = true;
      const { ok, data } = await post(passwordUrl, { current_password: current, new_password: next });
      if (btn) btn.disabled = false;

      if (!ok) { say(data.error || 'Échec du changement de mot de passe.', false); return; }
      pwForm.reset();
      const hint = pwForm.parentElement?.querySelector('.admin-user__hint');
      if (hint) hint.remove();
      say('Mot de passe mis à jour. Il ne s’applique qu’à votre compte.', true);
    });
  }
</script>
</body>
</html>
