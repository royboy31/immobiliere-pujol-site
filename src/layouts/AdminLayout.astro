---
import { getAdminEnv, getAdminPath } from '../lib/admin-auth';

interface Props {
  title: string;
  section?: 'experts' | 'articles' | 'pages' | 'home' | 'newsletter';
  hideSidebar?: boolean;
}

const { title, section = 'home', hideSidebar = false } = Astro.props;
const env = await getAdminEnv();
const adminPath = getAdminPath(env);
const base = `/${adminPath}`;
const adminEmail = (Astro.locals as any).adminEmail ?? '';
---

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>{title} – Admin Pujol</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Noto+Sans:wght@300;400;500;600;700&display=swap"
    rel="stylesheet"
  />
  <style>
    :root {
      --pj-olive: rgb(178, 192, 78);
      --pj-olive-2: rgb(166, 179, 82);
      --pj-orange: rgb(236, 114, 52);
      --pj-paper: rgb(238, 243, 239);
      --pj-ink: rgb(58, 58, 58);
      --pj-hairline: rgba(0, 0, 0, .1);
      --pj-slate: rgb(86, 103, 112);
      --pj-helv: "Helvetica Neue", "HelveticaNeue", Helvetica, Inter, sans-serif;
      --pj-noto: "Noto Sans", sans-serif;
      --danger: #dc2626;
      --body-bg: #fafafa;
    }
    * { box-sizing: border-box; }
    html, body {
      margin: 0; padding: 0;
      background: var(--body-bg);
      font-family: var(--pj-noto);
      font-weight: 300;
      color: #000;
      -webkit-font-smoothing: antialiased;
    }
    a { color: var(--pj-olive-2); text-decoration: none; }
    a:hover { color: var(--pj-orange); text-decoration: none; }
    button { font: inherit; cursor: pointer; }

    .admin-shell { display: flex; min-height: 100vh; }

    .admin-sidebar {
      width: 260px; flex-shrink: 0;
      background: var(--pj-slate);
      color: #fff;
      display: flex; flex-direction: column;
    }
    .admin-sidebar__brand {
      padding: 22px 24px;
      font-family: var(--pj-helv);
      font-weight: 300;
      font-size: 18px;
      letter-spacing: .2px;
      border-bottom: 1px solid rgba(255,255,255,0.1);
      b { font-weight: 700; }
    }
    .admin-sidebar__nav {
      flex: 1; padding: 18px 14px;
      display: flex; flex-direction: column; gap: 4px;
    }
    .admin-sidebar__nav a {
      color: rgba(255, 255, 255, .72);
      padding: 11px 16px;
      border-radius: 999px;
      font-family: var(--pj-noto);
      font-weight: 500;
      font-size: 13px;
      letter-spacing: .3px;
      display: flex; align-items: center; gap: 8px;
      transition: background .2s, color .2s;
    }
    .admin-sidebar__nav a:hover {
      color: #fff;
      background: rgba(255, 255, 255, .08);
    }
    .admin-sidebar__nav a.is-active {
      color: #000;
      background: var(--pj-olive);
      font-weight: 700;
    }
    .admin-sidebar__nav span.count { margin-left: auto; opacity: .7; font-size: 11px; }
    .admin-sidebar__user {
      padding: 18px 20px;
      border-top: 1px solid rgba(255,255,255,0.1);
      font-size: 12px;
      display: flex; flex-direction: column; gap: 10px;
    }
    .admin-sidebar__user .email {
      color: rgba(255, 255, 255, .65);
      overflow: hidden; text-overflow: ellipsis;
      letter-spacing: .3px;
    }
    .admin-sidebar__user form { margin: 0; }
    .admin-sidebar__user button {
      background: transparent; color: #fff;
      border: 1px solid rgba(255,255,255,0.25);
      padding: 8px 12px;
      border-radius: 999px;
      width: 100%;
      font-family: var(--pj-noto);
      font-weight: 700;
      font-size: 11px;
      letter-spacing: .6px;
      text-transform: uppercase;
      transition: background .2s, border-color .2s;
    }
    .admin-sidebar__user button:hover { background: rgba(255, 255, 255, .1); border-color: rgba(255, 255, 255, .5); }

    .admin-main { flex: 1; min-width: 0; padding: 36px 44px; }
    h1 {
      margin: 0 0 28px;
      font-family: var(--pj-helv);
      font-weight: 300;
      font-size: 36px;
      line-height: 1.05;
      color: #000;
      letter-spacing: -.2px;
    }
    h1 b { font-weight: 700; }
    h2 {
      margin: 32px 0 14px;
      font-family: var(--pj-helv);
      font-weight: 300;
      font-size: 22px;
      color: #000;
    }
    h2 b { font-weight: 700; }

    .card {
      background: #fff;
      border: 1px solid var(--pj-hairline);
      border-radius: 18px;
      padding: 22px 24px;
      box-shadow: 0 4px 14px rgba(0, 0, 0, .04);
      transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease;
    }
    a.card:hover {
      transform: translateY(-2px);
      border-color: var(--pj-olive);
      box-shadow: 0 12px 32px rgba(0, 0, 0, .08);
    }

    .btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 11px 22px;
      border-radius: 999px;
      border: 1px solid transparent;
      font-family: var(--pj-noto);
      font-weight: 700;
      font-size: 12px;
      letter-spacing: .6px;
      text-transform: uppercase;
      cursor: pointer;
      transition: background-position .35s ease, color .25s ease, border-color .25s ease;
    }
    .btn--primary {
      color: #000;
      background-color: transparent;
      background-image: linear-gradient(to top, transparent 50%, var(--pj-olive) 50%);
      background-size: 100% 200%;
      background-position: 0 0;
      border-color: var(--pj-olive);
    }
    .btn--primary:hover { background-position: 0 100%; color: var(--pj-olive-2); text-decoration: none; }
    .btn--ghost {
      background: transparent; color: #000;
      border-color: var(--pj-hairline);
    }
    .btn--ghost:hover { background: var(--pj-paper); border-color: rgba(0,0,0,.2); }
    .btn--danger { background: transparent; color: var(--danger); border-color: var(--danger); }
    .btn--danger:hover { background: var(--danger); color: #fff; }

    input[type=text], input[type=email], input[type=password], input[type=url], textarea {
      display: block; width: 100%;
      padding: 11px 14px;
      border: 1px solid var(--pj-hairline);
      border-radius: 10px;
      font: inherit;
      font-family: var(--pj-noto);
      font-weight: 400;
      color: #000;
      background: #fff;
      transition: border-color .2s ease, box-shadow .2s ease;
    }
    input[type=text]:focus, input[type=email]:focus, input[type=password]:focus,
    input[type=url]:focus, textarea:focus {
      outline: none;
      border-color: var(--pj-olive);
      box-shadow: 0 0 0 3px rgba(178, 192, 78, .2);
    }
    textarea {
      min-height: 160px;
      font-family: ui-monospace, "SF Mono", Menlo, monospace;
      font-size: 14px;
      line-height: 1.55;
    }
    label {
      display: block;
      margin-bottom: 16px;
      font-family: var(--pj-noto);
      font-weight: 700;
      font-size: 12px;
      letter-spacing: .4px;
      text-transform: uppercase;
      color: var(--pj-ink);
    }
    label input, label textarea {
      margin-top: 8px;
      font-weight: 400;
      letter-spacing: normal;
      text-transform: none;
      color: #000;
    }
    .toolbar { display: flex; gap: 10px; margin-bottom: 18px; align-items: center; }
    .toolbar .spacer { flex: 1; }
    .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 18px; }
  </style>
</head>
<body>
<div class="admin-shell">
  {!hideSidebar && (
    <aside class="admin-sidebar">
      <div class="admin-sidebar__brand">Immobilière <b>Pujol</b><br/><span style="font-size:12px;font-weight:700;letter-spacing:.8px;text-transform:uppercase;color:rgba(255,255,255,.55);">Espace admin</span></div>
      <nav class="admin-sidebar__nav">
        <a href={`${base}/`} class:list={[{ 'is-active': section === 'home' }]}>Tableau de bord</a>
        <a href={`${base}/experts/`} class:list={[{ 'is-active': section === 'experts' }]}>Experts</a>
        <a href={`${base}/articles/`} class:list={[{ 'is-active': section === 'articles' }]}>Articles de blog</a>
        <a href={`${base}/newsletter/`} class:list={[{ 'is-active': section === 'newsletter' }]}>Newsletters</a>
        <a href={`${base}/pages/`} class:list={[{ 'is-active': section === 'pages' }]}>Pages légales</a>
      </nav>
      <div class="admin-sidebar__user">
        <span class="email">{adminEmail || 'anonyme'}</span>
        <form method="POST" action={`/api/${adminPath}/auth/logout/`}>
          <button type="submit">Déconnexion</button>
        </form>
      </div>
    </aside>
  )}
  <main class="admin-main">
    <slot />
  </main>
</div>
</body>
</html>
