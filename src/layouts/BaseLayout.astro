---
import Header from '../components/common/Header.astro';
import SearchOverlay from '../components/common/SearchOverlay.astro';
import Footer from '../components/common/Footer.astro';
import Breadcrumbs from '../components/common/Breadcrumbs.astro';
import CookieConsent from '../components/common/CookieConsent.astro';
import { buildRealEstateAgent, autoBreadcrumb } from '../lib/schemas';
import liveSeoMeta from '../seo-data/seo-meta.json';
import '../styles/theme.scss';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
  noindex?: boolean;
  /** Page-specific JSON-LD schemas (Article, WebSite, RealEstateListing, etc.). */
  schemas?: any[];
  /** Disable the auto-generated BreadcrumbList schema and the visible trail. */
  breadcrumb?: boolean;
  /** Override the breadcrumb trail. When set, replaces the auto-generated middle
   *  crumbs in both the visible nav and the JSON-LD BreadcrumbList schema. */
  breadcrumbCrumbs?: Array<{ label: string; href: string | null }>;
}

const {
  title,
  description = "Gestion locative, syndic de copropriété, vente de biens immobilier à Marseille. Immobilière Pujol.",
  ogImage = "https://www.immobiliere-pujol.fr/images/og-default.jpg",
  canonical,
  noindex = false,
  schemas: pageSchemas = [],
  breadcrumb = true,
  breadcrumbCrumbs,
} = Astro.props;

const canonicalURL = canonical || new URL(Astro.url.pathname, Astro.site);

// PHASE-1 META MIRROR: emit the live WordPress <title> / meta description VERBATIM
// (no optimization — that is phase 2). Lookup is by decoded pathname with a
// trailing slash; see migration/seo-meta.csv + migration/build-seo-meta-json.py.
// Annonce (SSR) pages are handled in src/pages/annonces/[slug].astro, not here.
// Only the meta tags are overridden; breadcrumbs keep the page's own title.
const liveKey = decodeURIComponent(Astro.url.pathname).replace(/\/?$/, '/');
const liveMeta = (liveSeoMeta as Record<string, { t: string; d: string }>)[liveKey];
const metaDescription = liveMeta ? liveMeta.d : description;
// Title: mirror live verbatim when available. For pages NOT on live (e.g. the new
// /service-immobilier/* pages) append the brand suffix for consistency — but NOT
// for annonces, whose live Yoast titles intentionally have no suffix.
const SITE_NAME = 'Immobilière Pujol';
const isAnnonce = liveKey.startsWith('/annonces/');
const metaTitle = liveMeta?.t
  ?? ((isAnnonce || title.includes(SITE_NAME)) ? title : `${title} – ${SITE_NAME}`);

// STAGING: block all indexing until go-live.
// Set ALLOW_INDEXING=true in Cloudflare env vars when ready for production.
const shouldNoindex = noindex || !import.meta.env.ALLOW_INDEXING;

// GTM & analytics: only fire in production (when we allow indexing).
// Staging must never pollute live stats.
// GTM_ID can be overridden per environment if needed.
const gtmId = import.meta.env.GTM_ID || 'GTM-WNFF3V';
const loadAnalytics = !shouldNoindex;

// Always emit the enriched RealEstateAgent on every page. Pages can add their
// own schemas (Article, WebSite, RealEstateListing, BreadcrumbList) via
// the `schemas` prop. An automatic BreadcrumbList is generated from the URL
// unless `breadcrumb={false}` or the page already provides one.
const breadcrumbSchema = breadcrumb
  ? autoBreadcrumb(Astro.url.pathname, title.split('–')[0].trim(), breadcrumbCrumbs)
  : null;

const allSchemas: any[] = [buildRealEstateAgent()];
if (breadcrumbSchema) allSchemas.push(breadcrumbSchema);
for (const s of pageSchemas) {
  if (s) allSchemas.push(s);
}
---

<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicons/homescreen512.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicons/homescreen192.png" />
    <link rel="icon" type="image/png" sizes="168x168" href="/favicons/homescreen168.png" />
    <link rel="icon" type="image/png" sizes="144x144" href="/favicons/homescreen144.png" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicons/homescreen96.png" />
    <link rel="apple-touch-icon" href="/favicons/homescreen192.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans:wght@300;400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700&family=Sacramento&family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap"
      rel="stylesheet"
    />

    <title>{metaTitle}</title>
    <meta name="description" content={metaDescription} />
    {!noindex && <link rel="canonical" href={canonicalURL} />}

    <meta name="robots" content={shouldNoindex ? "noindex, nofollow" : "index, follow"} />
    <meta name="google-site-verification" content="XKAzqnzZ1WGlJqJZvQFkvRvnoawpEcOIgkoIRPAXLgc" />

    <link rel="alternate" type="application/rss+xml" title="Immobilière Pujol" href="/feed/" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={metaTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="Immobilière Pujol" />
    <meta property="fb:app_id" content="341420341199123" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:site" content="@stephanepujol" />
    <meta name="twitter:creator" content="@stephanepujol" />
    <meta name="twitter:title" content={metaTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImage} />

    {/* Consent Mode v2 — ads default denied, then restore the stored choice.
        MUST run before GTM so tags respect consent from the first hit.
        TEMPORARY (go-live 2026-06-21 → revert ~2026-09 after 2-3 months, Roy's
        decision, Caroline OK): analytics_storage defaults to 'granted' so we
        capture the real launch traffic instead of losing ~40% to non-consented
        Consent Mode modelling. Same posture as the Clarity block below. An
        explicit "Refuser" in the banner is still honoured (sets it back to
        denied). To revert to full RGPD conformity, set analytics_storage back to
        'denied'. */}
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){ dataLayer.push(arguments); }
      gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: 'granted',
        functionality_storage: 'granted',
        security_storage: 'granted',
        wait_for_update: 500,
      });
      try {
        var c = JSON.parse(localStorage.getItem('pujol-cookie-consent') || 'null');
        if (c) {
          gtag('consent', 'update', {
            analytics_storage: c.analytics ? 'granted' : 'denied',
            ad_storage: c.ads ? 'granted' : 'denied',
            ad_user_data: c.ads ? 'granted' : 'denied',
            ad_personalization: c.ads ? 'granted' : 'denied',
          });
        }
      } catch (e) {}
    </script>

    {loadAnalytics ? (
      <script is:inline set:html={`(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer','${gtmId}');`} />
    ) : (
      <!-- Analytics disabled (staging / noindex). Enable by setting ALLOW_INDEXING in env. -->
    )}

    {/* Microsoft Clarity (behavioural analytics / session recordings). Prod only.
        TEMPORARY (go-live 2026-06-21 → revert ~2026-07-21, Roy's decision): loads
        WITHOUT consent to capture full launch-optimisation data. For RGPD
        conformity, revert to consent-gated after the first month — wrap the
        snippet in an analytics-consent check + the 'pujol-consent-change' listener
        (see git history of this block for the gated version). */}
    {loadAnalytics && (
      <script is:inline set:html={`(function(c,l,a,r,i,t,y){c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
      t=l.createElement(r);t.async=1;t.src='https://www.clarity.ms/tag/'+i;
      y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y)})(window,document,'clarity','script','xagptvfky1');`} />
    )}

    {/* Cloudflare Turnstile — prod only (the verify secret lives only on the prod
        email worker). Auto-renders the .cf-turnstile widget on the lead forms.
        On staging this script is absent, so the widget divs stay inert. */}
    {loadAnalytics && (
      <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    )}

    <!-- Schema.org JSON-LD -->
    {allSchemas.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}
  </head>
  <body>
    {loadAnalytics && (
      <noscript set:html={`<iframe src="https://www.googletagmanager.com/ns.html?id=${gtmId}" height="0" width="0" style="display:none;visibility:hidden"></iframe>`} />
    )}

    <Header />
    <SearchOverlay />
    {breadcrumb && (
      <Breadcrumbs
        pageTitle={title.split('–')[0].trim()}
        pathname={Astro.url.pathname}
        crumbs={breadcrumbCrumbs}
      />
    )}
    <main>
      <slot />
    </main>
    <Footer />
    <CookieConsent />
    {/* When any form replaces its content with a success message, scroll it into
        view + move focus there — so the "Merci" confirmation is seen (esp. mobile). */}
    <script is:inline>
      new MutationObserver((muts) => {
        for (const m of muts) {
          if (m.target instanceof HTMLFormElement && m.addedNodes.length) {
            const el = m.target.querySelector('.svc-form__success, .annonce-contact__success') || m.target.firstElementChild;
            if (el) {
              el.setAttribute('tabindex', '-1');
              el.scrollIntoView({ behavior: 'smooth', block: 'center' });
              try { el.focus({ preventScroll: true }); } catch (e) {}
            }
            return;
          }
        }
      }).observe(document.body, { childList: true, subtree: true });
    </script>
  </body>
</html>
