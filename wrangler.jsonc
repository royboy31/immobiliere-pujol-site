{
	"compatibility_date": "2026-04-02",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "immobiliere-pujol-staging",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"html_handling": "auto-trailing-slash",
		"not_found_handling": "none"
	},
	"observability": {
		"enabled": true
	},
	"d1_databases": [{ "binding": "DB", "database_name": "pujol-annonces", "database_id": "109fb417-c984-4c08-90b2-2a10ae1bc279" }],
	"r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "pujol-photos" }],
	"vars": {
		"ADMIN_EMAILS": "roy@perelweb.studio,carolinepujol@immobiliere-pujol.fr,kamindudushmantha@gmail.com",
		"ADMIN_PATH": "admin-pujol"
	}
	// UPLOAD_TOKEN, ADMIN_PASSWORD_HASH, ADMIN_SESSION_SECRET are NOT stored here.
	// Staging: set as Cloudflare secrets (wrangler secret put) on the Roy account.
	// Prod: injected at deploy from GitHub Actions secrets by deploy-pujol.yml.
}
